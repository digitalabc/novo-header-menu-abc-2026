/* LEIA-ME */
/* login.css >> Definições das páginas de LOGIN do novo Checkout */
/* minhaconta.css >> Definições das páginas de MINHA CONTA do novo Checkout */
/* checkout.css >> Definições das páginas de CARRINHO, FECHAMENTO E CONFIRMAÇÃO do novo Checkout */
/* geral.css >> Definições de Cabeçalho e Rodapé */
/* adicione/edite este arquivo para sobrescrever as definições padrão da loja */
.fbits-carrinho
  padding 0 !important

  @media mobile
    .fbits-box-login
      margin-top -270px
      margin-left -175px
      max-width 350px
  .fa-pencil-square-o:before
    position relative
    top -50px
  .fa-edit:before,
  .fa-pencil-square-o:before
    content "Editar"

  input[type="text"],
  input[type="password"],
  input[type="tel"],
  input[type="Date"],
  select
    max-width 100%
    border 1px solid #E8E8E8
    box-shadow none

  label
    font-weight 400
    color #6D6D5C

  .tyc_container
    margin 0 auto
    max-width 1300px

    @media (max-width 1300px)
      padding 0 15px

    .full-container
      @media mobile
        padding 20px 15px
        
  .fbits-responsive-carrinho
    .fbits-responsive-carrinho-items
      border none

      @media (min-width 1024px)
        max-width 70%

      @media mobile
        padding 0 15px

      .fbits-responsive-carrinho-item-titulo
        padding-right 90px

        a.btn.btn-danger.icon.remover
          &:before
            top 10px

      .fbits-responsive-carrinho-header
        display: flex;
        justify-content: space-between;
        background: $black;
        padding: 0 15px;
        li
          background none
          height 42px
          color #fff
          text-align left
          font-weight 700
          font-size 14px
          .share-minicart
            display flex
            align-items center
            gap 5px
            cursor pointer
            &:hover
              text-decoration underline

      .fbits-responsive-carrinho-produtos
        li
          border-bottom 1px solid #DDDDDD
          &:nth-child(odd)
            background-color #FAFAFA
          &:nth-child(even)
            background-color #F1F1F1

          @media desktop
            &:last-child
              border none

          @media mobile
            margin-bottom 15px
            &:last-child
              margin-bottom 40px

        .fbits-responsive-carrinho-item-descricao
          @media mobile
            width 95%

          >a
            color #000
            text-align left
            font-weight 400
            font-size 18px
            line-height 15px

          .fbits-reponsive-carrinho-item-prazo-entrega
            display none

        .fbits-responsive-carrinho-item-quantidade
          .qtdCarrinho
            min-width 20px
            height 45px
            border 1px solid #E8E8E8
            border-width 1px 0 1px 0
            box-shadow none
            font-size 18px

            @media mobile
              min-width 15px
              height 40px

          .btn.btn-default.btn-number
            height 45px
            border 1px solid #E8E8E8

            @media mobile
              height 40px

            &:hover
              a.arrow
                color #676767 !important

            a.arrow
              display flex
              justify-content center
              align-items center
              padding 0
              width 45px
              color #676767
              font-weight 400
              font-size 18px

              @media mobile
                width 40px

              &:before
                display none

            &[data-type="minus"]
              border-right none

              a.arrow:before
                content "-"

            &[data-type="plus"]
              border-left none

              a.arrow:before
                content "+"

        .fbits-responsive-carrinho-item-valor-unitario
          .currency
            color #000
            text-align left
            font-weight 700
            font-size 18px
            @media mobile
              font-size 16px
            &.promo
              font-size 12px

        .fbits-responsive-carrinho-item-total
          @media mobile
            padding-left 0
            min-height 65px

          > .text-nowrap .currency
            color #000
            text-align right
            font-weight 500
            font-size 18px
            @media mobile
              font-size 17px

          .precoParcela
            color #717171
            text-align right
            font-weight 500
            font-size 15px

            @media mobile
              font-size 12px

    .fbits-responsive-carrinho-detalhes
      @media mobile
        padding 0 15px

      input.form-control
        height 35px
        border 1px solid #E8E8E8
        border-radius 0
        box-shadow none

      input.btn.btn-success.btnCalcular
        height 35px
        border none
        border-radius 0
        background $black
        color #fff
        text-transform uppercase
        font-weight 700
        font-size 12px
        transition $transition

        &:not([disabled])
          &:hover
            background $primary

      #naoSeiCep
        display block
        clear both
        padding-top 5px
        color #000
        font-size 12px

      .fbits-responsive-carrinho-subtotal
        border none
        border-radius 0
        background $black

        .fbits-responsive-carrinho-subtotal-header
          color #fff
          text-align left
          font-weight 500
          font-size 14px

        .fbits-responsive-carrinho-subtotal-valor
          color #fff
          font-weight 700

      .fbits-carrinho-frete-item
        margin-right 0
        margin-left 0
        padding 5px

        .fbits-frete-retirada-endereco
          margin 0 !important
        
        .fbits-responsive-carrinho-frete-header
          padding 0

        .fbits-responsive-carrinho-frete-complemento
          span
            text-align: right
            display: block

      .fbits-responsive-carrinho-desconto-texto,
      .fbits-responsive-carrinho-frete-texto,
      .fbits-responsive-carrinho-desconto-calculo,
      .fbits-responsive-carrinho-frete-calculo
        margin-bottom 0
        padding 0
        color #000
        text-align left
        font-weight 400
        font-size 12px

      .fbits-responsive-carrinho-desconto-texto
        font-size 14px
        font-weight 500

      .fbits-responsive-carrinho-desconto,
      .fbits-responsive-carrinho-frete
        border none

      .fbits-responsive-carrinho-total
        border none
        border-top 1px solid #DDDDDD
        background #fff
        color #000
        font-weight 500
        font-size 14px

        >*
          padding 0

      .botoes-bottom
        padding-top 0

        .btfinalizar,
        .btcontinuar
          padding 0
          height 45px
          border-radius 0
          line-height 45px
          font-weight 700
          text-transform uppercase
        .btfinalizar
          border none !important
          background #0FA848
          color #fff
          font-weight bold
          font-size 16px
          transition $transition

          &:hover
            background $primary

        .btcontinuar
          border 1px solid $black
          background #fff
          color $black
          font-weight 400
          font-size 14px
          transition $transition

          &:hover
            border 1px solid $primary
            background $primary
            color #fff

  .checkout-active
    border 2px solid $primary !important

  .checkout-observacao
    padding 3px
    width 100%
    border 1px solid #767676
    border-radius 2px

  .box-default
    .btn-outline-primary
      padding 0
      background transparent

    input[name="IE"]
      display inline
      float none
      margin-top 0
      margin-left 10px
      width 15px
      height 15px

  .new-checkout.fbits-nc-carrinho
    @media mobile
      padding 0 15px

    .fechamento-section3 .fbits-responsive-carrinho-item
      border none
    h5.title-box
      font-size 13px
      font-weight 400
      color #000
  .fechamento-section3
    a.voltar-carrinho
      color #117ABC

    .fbits-responsive-carrinho-subtotal
      background #F7F7F7

    .fbits-responsive-carrinho-total
      margin 10px -15px 0
      padding 0 15px
      border none
      background #F7F7F7

    span.fbits-responsive-carrinho-subtotal-valor
      span
          color #333333
          font-size 14px
          font-weight 400
          &.currency
            font-weight bold

    .text-right.fbits-responsive-carrinho-total-header
      color #333333
      font-size 16px
      font-weight 400
      .currency
        font-weight bold
        font-size 16px

    .btfinalizar
      border none !important
      background #0FA848
      color #fff
      font-weight bold
      text-transform uppercase
      transition $transition

      &:hover
        background $primary

  .etiqueta-atacado-container
    clear both

.fbits-confirmacao
  padding 0 !important

  .box-pedido-numero+.box-pedido-numero
    position static

  section.confirmacao-box
    width 100%

  .container
    margin 0 auto
    max-width 1300px

  section.confirmacao-buttons
    @media desktop
      display flex
      justify-content space-between

    >*
      float none !important

      @media mobile
        display block
        margin 0 auto 10px
        max-width 400px

    a
      @extends $default-button
      text-transform none

.fbits-gateway-status-reprovado
  @media mobile
    div
      width 90%

      >h3
        >svg
          top 10px
          right 10px


h2.title-confirmacao
  margin-top 20px