.fechamento-checkout
  .copyright-footer
    float: none;
    margin: auto;
    padding: 30px 15px;
    max-width: 1300px;
    border-top: 1px solid #EDEDED;
    background: #fff;

    @media desktop
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 40px 15px;
      gap: 150px;

    @media (min-width: 1330px)
      padding: 40px 0;

    .fechamento-payment
      &__title
        margin-bottom: 12px;
        color: #000000;
        font-weight: 600;
        font-size: 16px;

      @media mobile
        .img-payment
          display: none;

      @media desktop
        .img-payment-mobile
          display: none;

    .fechamento-copyright
      color: #392F2D;
      text-align: center;
      font-size: 11px;
      line-height: 13px;

      @media mobile
        margin-top: 45px;

      p
        margin: 0;
