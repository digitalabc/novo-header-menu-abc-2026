$bf_primary = #D88730;

.black_friday
  &__fullbanner
    padding: 54px 0;
    background-color: #000000;

    .container > div
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      max-width: 550px;
      gap: 16px;

  &__title
    color: #FFF;
    font-weight: 700;
    font-size: 32px;
    line-height: normal;

  &__paragraph
    color: #FFF;
    font-weight: 500;
    font-size: 20px;
    line-height: 140%;

  &__link
    padding: 11px 57px;
    border-radius: 8px;
    background-color: $bf_primary;
    color: #FFF;
    font-weight: 600;
    font-size: 20px;

    &:hover
      color: #ffffff;

  &__disclaimer
    color: #FFF;
    font-weight: 400;
    font-size: 10px;
    line-height: 140%;

  &__advantages
    padding: 32px 0;
    background-color: $bf_primary;