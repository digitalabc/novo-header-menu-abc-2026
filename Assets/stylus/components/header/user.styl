
.user
  position relative
  &:hover
    .user
      &__dropdown
        @media desktop
          opacity 1
          visibility visible
      &__links
        color $primary

  &__header
    display: flex;
    align-items: center;
    gap 7px
    @media desktop
      min-width 113px
    svg
      fill $primary
    >a
      @media desktop
        pointer-events none
  
  &__links
    transition $transition
    @media mobile
      display none !important
    &.authenticated
      display none
    a
      transition unset
      color currentColor
      &.user-register
      &.user-account
        font-weight 500

  &__dropdown
    z-index 1
    box-shadow $bs
    background #fff
    opacity 0
    visibility hidden
    position absolute
    top calc(100% + 20px)
    left 50%
    transform translateX(-50%)
    padding: 0 20px;
    width 220px
    height 170px
    text-align center
    display grid
    place-items center
    transition $transition
    @media mobile
      display none
      
    &:before
      content ''
      top -20px
      position absolute
      width 100%
      height 20px

    ul
      margin: 0;
      padding: 0;

      li
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 16px 0;

        .dropdown-option
          color: $primary;
          font-weight: 700;
          font-size: 14px;
          line-height: 18px;

          &:hover
            opacity: 0.7;
    
    #user-href
      display flex
      align-items center
      justify-content center
      width 100%
      height 40px
      margin-bottom 20px
      background: $primary;
      color: #fff
      font-weight 600
      transition $transition

      &:hover
        background: $black;
    p
      line-height 15px
      font-size 12px
      margin-bottom 4px

    #register-href
      color: $black;
      font-weight 600
      transition $transition

      &:hover
        color: $primary;
  &__content
    width 100%
    display none
    