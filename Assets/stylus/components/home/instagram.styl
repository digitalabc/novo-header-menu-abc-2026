.instagram
  background: #FAFAFA;
  padding-block: 60px;

  .swiper
    &:not(.swiper-initialized)
      .swiper-wrapper
        display: flex;
        justify-content: space-between;
        align-items: center;
        overflow: hidden;

        .swiper-slide
          flex: 0 0 calc((100% / 6));

    .swiper-slide
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;

      @media desktop
        &:hover
          &:before
            visibility: visible;
            opacity: 1;

      &:before
        position: absolute;
        top: 0;
        left: 50%;
        visibility: hidden;
        max-width: 360px;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 30%);
        background-image: url("data:image/png;base64,");
        background-position: center;
        background-repeat: no-repeat;
        content: "";
        opacity: 0;
        transition: $transition;
        transform: translateX(-50%);
        pointer-events: none;