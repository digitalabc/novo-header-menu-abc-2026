.floating-navbar
  position: fixed;
  bottom: 0;
  left: 0;
  z-index: 2;
  width: 100%;
  height: 75px;
  padding 0 15px
  background: #F7F7F7
  display: flex;
  justify-content: space-between;
  align-items: center;
  transform translateY(100%)
  transition $transition
  .show-mobile-nav &
    transform translateY(0)
  @media desktop
    display: none;

  > button
    background: none;
    color $black
    font-weight 500
    svg
      display block
      margin 0 auto 3px
      min-height: 20px;