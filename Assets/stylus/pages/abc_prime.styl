                                font-weight: 500;
                                line-height: normal;

                        &-price

                            .spot-price
                                height auto
                                margin-bottom 0

                                .precoPor
                                    display none
                                    
                                    &:first-child
                                        padding-top: 0;

                                    span
                                        color: #000;
                                        font-family: "Montserrat", sans-serif;
                                        font-size: 23px;
