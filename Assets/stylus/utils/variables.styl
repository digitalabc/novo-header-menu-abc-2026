$primary = #E30613;
$secondary = #E4FF72;
$black = #392F2D;
$buy-btn = #0FA848

$container
  max-width 1300px
  margin 0 auto
  width 100%;
  @media (max-width 1330px)
    padding-inline 15px;

$transition = all 0.2s ease-in-out;

$bs = 0 3px 6px rgba(0,0,0,0.16)

$default-button
  display flex
  justify-content center
  align-items center
  padding 0
  height 45px
  border none
  background $black
  color #fff
  text-transform uppercase
  font-weight bold
  font-size 16px
  transition $transition

  &:hover
    background $primary

desktop = unquote("screen and (min-width: 992px)");
mobile = unquote("screen and (max-width: 991px)");
tablet = unquote("screen and (min-width: 991px) and (max-width: 1330px)");
