.autocomplete
  position: relative;

  &-item
    overflow: hidden;

    >div
      display: flex;
      color: #000000;
      cursor: pointer;
      gap: 10px;

      &:hover
        background-color: #ededed;

      p
        display: -webkit-box;
        overflow: hidden;
        margin: auto auto auto 0;
        max-height: 40px;
        line-height: 20px;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;

  &-price
    display: flex;
    justify-content: center;
    align-items: center;
    margin-right: 10px;
    white-space: nowrap;
    font-weight: 700;

  &-active
    background-color: grey !important;
    color: #ffffff;

  #autocomplete-list
    position: absolute;
    top: 100%;
    z-index: 9;
    background: #ffffff;
    @media desktop
      box-shadow: 0 3px 6px rgba(0,0,0,.16);

    > *
      display block
      &:nth-child(odd)
        background: #FAFAFA;

    > div
      padding: 5px 20px;
      color: $primary;
      font-weight: normal;
      font-size: 14px;
      cursor: pointer;

      &:hover
        background: rgba($black, 0.1);