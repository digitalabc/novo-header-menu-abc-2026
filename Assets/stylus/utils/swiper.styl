.swiper
  &:not(.swiper-initialized)
    .swiper-button, ~.swiper-button
      &-prev, &-next
        display: none;

  &-container
    position: relative;

  &-wrapper
    margin: 0;
    padding: 0;

  &-button
    &-prev, &-next
      z-index: 1;
      margin: 0;
      width: 30px;
      height: 30px;
      background: none;
      color: #5D5D5D;
      transition: $transition;
      transform: translateY(-50%);
      user-select: none;

      &:hover
        color: $primary;

      &:after
        content: none;

      &.swiper-button-disabled
        pointer-events: all;
        user-select: none;

        &:hover
          color: inherit;

    &-prev
      @media desktop
        left: -50px;

    &-next
      @media desktop
        right: -50px;