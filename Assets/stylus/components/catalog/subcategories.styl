h2.subcategories__title,
.subcategories__title
  font-weight var(--peso-fonte-semibold)
  font-size var(--fonte-16)
  line-height 1.3
  margin 0 0 12px 0
  transition: $transition;

.subcategories, .subTopo
  margin-bottom: 24px;
  font-family: var(--font-brand);

  .subcategories__link,
  .subTopo__link
    display flex
    flex-direction column
    align-items center
    color inherit
    text-decoration none

    &:focus-visible
      outline: 2px solid $primary;
      outline-offset: 4px;
      border-radius: 10px;

      .subcategories__img img,
      .subTopo__img img
        outline: 3px solid $primary;

      .subcategories__title,
      .subTopo__title
        color: $primary;

  .subcategories__item,
  .subTopo__item
    text-align: center;
    box-sizing: border-box;
    width: 104px;

    @media mobile
      width: 104px;

    &:hover
      .subcategories__img img,
      .subTopo__img img
        outline: 3px solid $primary;

      .subcategories__title,
      .subTopo__title
        color: $primary;

  .subcategories__item .subcategories__title,
  .subTopo__item .subcategories__title,
  a.subcategories__item .subcategories__title,
  .subcategories a.subcategories__item .subcategories__title,
  .subTopo a.subcategories__item .subcategories__title
    font-weight var(--peso-fonte-medium)
    font-size var(--fonte-12)
    line-height 1.35
    margin 0
    transition: $transition;

  .subTopo__title
    font-weight var(--peso-fonte-medium)
    font-size var(--fonte-14)
    line-height 1.35
    transition: $transition;

  .subcategories__img,
  .subTopo__img
    margin-bottom: 6px;
    display flex
    align-items center
    justify-content center
    min-height 0

    img
      display block
      width 104px
      height 104px
      max-width 104px
      max-height 104px
      object-fit contain
      outline: 3px solid transparent;
      outline-offset: -3px;
      transition: $transition;

  @media mobile
    .swiper
      margin: 0 -15px;
      padding: 0 15px;

      &-button
        &-next, &-prev
          display: none;

.swiper-container:has(.swiper-slide.subcategories__item),
.swiper-container:has(.swiper-slide.subTopo__item)
  @media mobile
    .swiper
      margin: 0 -15px;
      padding: 0 15px;

    .swiper-button-next,
    .swiper-button-prev
      display: none;
