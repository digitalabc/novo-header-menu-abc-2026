.calculator
  &.uk-offcanvas-overlay::before
    background rgba(0, 0, 0, 0.3)

  .uk-offcanvas-bar
    overflow visible
    padding 0
    width 475px
    left: -475px;
    background #ffffff

    @media mobile
      width 320px
      left: -320px;

    .uk-close
      top 0
      right 100%
      width 55px
      height 55px
      background $primary

      svg
        &:not(#close-svg)
          display none

  &__button
    cursor pointer
    padding 0
    display flex
    align-items center
    background none
    font-size 14px
    line-height unset
    color #5D5D5D
    font-weight 700
    text-transform none
    transition $transition
    gap 12px
    @media mobile
      width 100%

    path
      transition $transition

    &:hover
      color $primary

      path
        fill $primary

  &__main
    label
      display: block;
      font-size: 14px;
      text-align: center;
      margin-bottom: 10px;
    input
      display block
      width 360px
      height 40px
      margin 0 auto
      border: 1px solid #d5d5d5;
      border-radius: 0;
      color: #000;
      font-weight: 500;
      font-size: 16px;
      color: #B4B4B4;
      text-align center
      @media mobile
        width 100%
    #atualizarQuant
      width 245px
      margin 0 auto
      display: flex;
      justify-content: center;
      align-items: center;
      height: 40px;
      background: $primary
      cursor: pointer;
      transition: all .2s ease-in-out;
      color: #fff;
      font-weight: 700;
      font-size: 14px;
      &:hover
        background $black

  &__title
    display flex
    justify-content center
    align-items center
    margin-bottom 16px
    height 55px
    background #392F2D
    color #ffffff
    text-transform uppercase
    letter-spacing 0.05em
    font-weight 700
    font-size 14px
  
  &__prompt
    font-size 16px
    color $black
    text-align center
    margin-bottom 20px

  &__form
    border-bottom 1px solid #d5d5d5
    margin 0 20px 20px
    padding-bottom 20px

  &__result
    font-weight 500
    text-align center
    font-size: 20px;
    color $black
    margin-bottom 20px