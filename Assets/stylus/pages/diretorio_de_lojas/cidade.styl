.template
  &__container
    padding-top 15px
    width 100%
    height 100%
    background #F0F3F5

  &__content
    margin 0 auto
    max-width 1300px

    @media (max-width 1024px)
      margin 0 15px

  &__title
    margin-bottom 35px
    color #0D3547 !important
    font-weight 300
    font-size 24px
    line-height 29px

  &__cards
    display grid
    padding-bottom 150px
    grid-template-columns repeat(3, 1fr)
    gap 25px

    @media (max-width 1024px)
      grid-template-columns repeat(2, 1fr)

    @media (max-width 765px)
      display flex
      flex-direction column
      align-items center

  &__card
    background #fff
    color #333333
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width 100%
    @media (max-width 765px)
      max-width 415px
    svg
      fill none

    &--green
      position relative
      margin-right 14px
      color #468525
      font-weight 600

      &:after
        position absolute
        top -3px
        right -9px
        content '.'

    &--top
      display flex
      padding 25px 25px 0 25px
      gap 24px

    &--title
      margin-bottom 8px
      font-weight 500
      font-size 16px
      line-height 19px

    &--text
      margin-bottom 8px
      color #303030
      font-weight 400
      font-size 14px
      line-height 135%

    &--time
      margin-bottom 25px
      color #303030
      font-weight 400
      font-size 14px
      line-height 135%
      position relative
      opacity 0
      transition opacity 0.2s ease-in-out
      width fit-content
      &--header
        display flex
        align-items center
        cursor pointer
        svg
          pointer-events none
      &.active
        opacity 1

    &--status
      color #468525
      font-weight bold
      &.closed
        color $red

    &--range
      display inline-flex
      align-items center
      margin-right 7px

      &:before
        margin 0 7px
        width 2px
        height 2px
        border-radius 50%
        background #303030
        content ''

    &--bottom
      display flex
      justify-content space-between
      align-items center
      border 1px solid #DFDFDF
      // padding: 10px 0
      background #f9f9f9

    &--phone
      flex 1
      display flex
      align-items center
      justify-content center
      padding 10px 0
      border-right 1px solid #dfdfdf
      gap 10px

      a
        display inline-block
        color #5B5B5B
        text-decoration none
        font-size 14px

    &--infos
      flex 1
      display flex
      align-items center
      justify-content center
      gap 10px

      a
        color #5B5B5B
        text-decoration none
        font-weight 400
        font-size 14px
        line-height 18px

    &__dropdown
      white-space nowrap
      position absolute
      top calc(100% + 15px)
      left 0
      z-index 1
      visibility hidden
      padding 15px
      border-radius 5px
      background #fff
      box-shadow 0 3px 6px rgba(0, 0, 0, 0.16)
      color #494949
      font-size 14px
      line-height 256%
      opacity 0
      transition $transition

      &.open
        visibility visible
        opacity 1
      li
        &.today
          font-weight bold

    &__day
      display inline-block
      width 120px

    &__arrow
      position absolute
      top -30px
      left 155px
      z-index 1
      overflow hidden
      width 30px
      height 30px
      pointer-events none

      &:after
        position absolute
        top 20px
        left 50%
        width 25px
        height 25px
        border-radius 5px
        background #999
        background #fff
        box-shadow 0 3px 6px rgba(0, 0, 0, 0.16)
        content ''
        transform translateX(-50%) rotate(45deg)