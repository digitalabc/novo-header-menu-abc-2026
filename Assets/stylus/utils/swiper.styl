.swiper
  &:not(.swiper-initialized)
    .swiper-button, ~.swiper-button
      &-prev, &-next
        display: none;

  &-container
    position: relative;

  &-wrapper
    margin: 0;
    padding: 0;

  &-button
    &-prev, &-next
      background-color unset
      margin 0
      transform translateY(-50%)
      width 30px
      height 30px
      color #5D5D5D
      z-index 1
      transition $transition
      &:hover
        color: $primary;

      &:after
        content: none;

      &.swiper-button-disabled
        pointer-events: all;

        &:hover
          color: inherit;

    &-prev
      @media desktop
        left: -50px;

    &-next
      @media desktop
        right: -50px;