.shipping
  margin-bottom: 20px;

  &__title
    background #FAFAFA
    color: #5D5D5D
    white-space: nowrap;
    font-weight: 400;
    font-size: 13px;
    line-height 30px
    text-align center
    @media mobile
      font-size 10px

  &__bar
    position: relative;
    width: 100%;
    height: 5px;

    > div
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      background: #392F2D