.headFechamento
  background #fff
  box-shadow 0 3px 6px rgba(0, 0, 0, 0.16)
  .fbits-center-responsivo
    display flex
    align-items center
    margin auto
    max-width 1300px
    height 77px

    @media mobile
      justify-content center
      height 70px

    @media (max-width 1330px)
      padding 0 15px

.headerLogo
  float none

  img
    margin 0
    max-width 153px
    width 100%
    image-rendering -webkit-optimize-contrast
