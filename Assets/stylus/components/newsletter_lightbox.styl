#newsletter-lightbox
  cursor pointer
  position: fixed;
  top: 0;
  left: 0;
  z-index: 999;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
  opacity 0
  visibility hidden
  transition $transition
  &:before
    content ''
    position absolute
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(#000000, 30%);
    
  .show-newsletter-lightbox &
    opacity 1
    visibility visible
    .newsletter__wrapper
      transform translateX(0)

  .newsletter
    &__wrapper
      position: relative;
      cursor default
      width 750px
      transform translateY(100vh)
      transform translateY(100dvh)
      transition $transition
      @media mobile
        width: 90%;
        max-width: 450px;

    &__close
      position: absolute;
      top: 0;
      right: -55px;
      color #fff
      font-weight 600
      text-decoration underline
      background: none;
      cursor: pointer;
      transition $transition
      @media mobile
        top: 5px;
        right: 10px;
        z-index: 1;
      &:hover
        color $primary

    &__header
      height 125px
      display flex
      flex-direction column
      justify-content center
      background-color $primary
      text-align: center;
      @media mobile
        padding: 30px 15px 15px;
        height: auto; 

      h2
        font-size 29px
        font-weight 600
        color: #fff;
        margin-bottom 0
        @media mobile
          font-size 18px
        
      p
        font-size 20px
        color: #fff;
        @media mobile
          font-size 14px

    &__form
      padding 45px 0 
      background #F7F7F7
      @media mobile
        padding 20px 15px

    &__input
      width 550px
      height: 45px;
      border 1px solid #5D5D5D
      display block
      margin 0 auto
      border-radius: 0;
      font-size 12px
      color #392F2D
      @media mobile
        width 100%
      &::placeholder
        color #5D5D5D
      &.newsletter-name
        margin-bottom 25px
        @media mobile
          margin-bottom 12px
      &.newsletter-email
        margin-bottom 12px

    &__button
        display flex
        align-items center
        justify-content center
        margin 0 auto
        width 150px
        height: 45px;
        background: #392F2D
        cursor: pointer;
        transition: $transition;
        color: #ffffff;
        font-weight: 600;
        transition: $transition;
        &[disabled]
          opacity 0.5
          cursor not-allowed
        &:not([disabled])
          &:hover
            background: $primary;

    &__alert
      font-weight 500
      position absolute
      left 50%
      transform translateX(-50%)
      bottom 20px

  .checkbox
    &__row
      display flex
      align-items center
      gap 6px
      max-width 550px
      margin 0 auto 35px
      @media mobile
        margin-bottom 20px
    &__input
      display none
      &:checked
        +.fake-checkbox
          border 1px solid $primary
          &:before
            opacity 1
    &__label
      font-size 12px
      cursor pointer

  .fake-checkbox
    background #FFFFFF
    flex-shrink 0
    width: 25px;
    height: 25px;
    border: 1px solid #5D5D5D;
    cursor: pointer;
    position relative
    transition: $transition;
    &:before
      content ''
      position absolute
      inset 0
      background-position center
      background-repeat no-repeat
      background-image url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAA8AAAAPCAMAAAAMCGV4AAAAIVBMVEUAAADkBRPjBhLiBRLjBRLiBRLiBRLiBhLjBhLiBRLjBhPs7C79AAAACnRSTlMAYICPkJ+g3+DwZOtKdwAAAExJREFUeNpNz4EKwCAIRdG3ptXe/3/wAL1gAHFuQKrlV5zwku1sbtuKDsWoK5ubnpBwIGFQurYP4D0nbwW4+RaKEE3mKxI+LcfY7/kB32oD/mJTvfAAAAAASUVORK5CYII=")
      opacity 0
      transition: $transition;