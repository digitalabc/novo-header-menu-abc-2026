#exit-intent-lightbox
  cursor pointer
  position: fixed;
  top: 0;
  left: 0;
  z-index: 999;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100vh;
  background: rgba(#000000, 30%);


  .exit-intent-lightbox
    cursor default
    position: relative;
    background: #F7F7F7

    &__close
      color #fff
      font-weight 600
      text-decoration underline
      background: none;
      cursor: pointer;
      transition $transition
      &:hover
        color $primary

    &__main
      width 1025px
      background #F7F7F7

    &__header
      height 80px
      display flex
      align-items center
      justify-content space-between
      background-color #392F2D
      text-align: center;
      font-size: 24px;
      line-height: 32px;
      padding-left 55px
      padding-right 20px

      h2
        font-size: 20px;
        font-weight: 700;
        color: #fff;
        margin-bottom 0
        position absolute
        left 50%
        top 50%
        transform translate(-50%, -50%)
        white-space nowrap
        