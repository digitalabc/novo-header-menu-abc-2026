.navbar__menu-mobile
  @media mobile
    position relative
    z-index 3

.menu__button
  position relative
  z-index 4
  display inline-flex
  align-items center
  justify-content flex-start
  min-width 44px
  min-height 44px
  background: none;
  touch-action manipulation
  -webkit-tap-highlight-color transparent

#menu-offcanvas
  z-index 2147483000 !important

  &.ah-offcanvas-open
    z-index 2147483000 !important

    > .ah-offcanvas-bar
      transform: translateX(0);

  &::before
    pointer-events auto
    z-index 2147483001 !important

  .ah-offcanvas-bar
    width: 270px;
    max-width calc(100vw - 55px)
    height 100vh
    height 100dvh
    left: 0;
    overflow visible
    overscroll-behavior contain
    transform translateX(calc(-100% - 55px))
    z-index 2147483002 !important

    .ah-close
      position absolute
      top 10px
      right -47px
      left auto
      z-index 2147483003 !important
      display flex
      align-items center
      justify-content center
      width 38px
      height 38px
      border 0
      border-radius 8px
      background $primary
      cursor pointer
      box-shadow 0 2px 8px rgba(0, 0, 0, 0.18)

      svg
        width 15px
        height 15px

        path
          fill #fff
        
  .nav-mobile
    &__header
      display flex
      align-items flex-end
      padding 0 15px 10px
      height 55px
      gap 6px
      background #F7F7F7
      .info
        flex 1
        >p
          color $primary
          font-weight 500
          margin-bottom 2px
        &__bottom
          display flex
          justify-content space-between
        &__links
          font-size 12px
          line-height 15px
          color #5D5D5D
          a
            color #5D5D5D

          &.authenticated
            display none

    &__others
      ul
        padding 0 8px
        li
          display flex
          align-items center
          height 41px
          border 1px solid #F7F7F7
          padding-left 15px
          margin-bottom: -1px;
          a
            display flex
            align-items center
            width 100%
            height 100%
            color $black
            font-weight 600

          &.nav-mobile__others-item--launches,
          &.nav-mobile__others-item--consumer,
          &.nav-mobile__others-item--chance,
          &.nav-mobile__others-item--cupons,
          &.nav-mobile__others-item--specialist,
          &.nav-mobile__others-item--store-offers,
          &.nav-mobile__others-item--franqueado,
          &.nav-mobile__others-item--stores
            height auto
            min-height 34px
            padding 6px 10px
            padding-left 10px
            border 1px solid #D8D8D8
            border-radius 8px
            background-color #F7F7F7
            overflow hidden
            margin-bottom 6px
            box-shadow none
            a
              display flex
              align-items center
              gap 6px
              width 100%
              height auto
              padding 0
              font-weight 600
              line-height 1.1
              color $black

            .nav-mobile__others-icon
              display inline-flex
              align-items center
              justify-content center
              margin-left auto
              width 15px
              height 15px
              flex-shrink 0

          &.nav-mobile__others-item--launches
            a
              color $black

          &.nav-mobile__others-item--chance
            a
              color $black

          &.nav-mobile__others-item--cupons
            border-color #E30613
            background-color #FDEDEE
            a
              color #E30613
              strong
                color #E30613
            .nav-mobile__others-icon--cupons
              display inline-flex
              align-items center
              justify-content center
              margin-left auto
              width 18px
              height 18px
              flex-shrink 0
              color #E30613
              font-size 18px
              line-height 1

          &.nav-mobile__others-item--specialist
            border-color #25D366
            background-color #25D3661A
            a
              color #00AD14
              font-weight 500
              strong
                color #00AD14

            .nav-mobile__others-icon--whatsapp
              svg
                width 15px
                height 15px
              svg path
                fill #25D366

          &.nav-mobile__others-item--store-offers
            .nav-mobile__others-icon--store-offers
              img
                display block
                width 15px
                height 15px
                object-fit contain
            a
              color $black

    &__link
      color $black
      font-weight 500
      position relative
      display flex
      align-items center
      height 40px
      padding 0 16px
      &--root-priority
        font-weight 700

    &__item
      padding-right 0
      &--root-priority
        > .nav-mobile__link
          font-weight 700
      &--nv1
        background #F7F7F7
      &--nv2
        border 1px solid #F7F7F7
        &:not(:last-child)
          margin-bottom: -1px;

    &__open
      background none
      position absolute
      right 0
      display flex
      align-items center
      justify-content flex-end
      padding-right 14px
      width 200px
      height 40px
      z-index 1
      svg
        pointer-events none

    &__back
      display flex
      align-items center
      gap 15px
      width 100%
      height 41px
      color $primary
      font-weight 700
      padding-left 15px
      margin-bottom: -1px;
      border 1px solid #F7F7F7
      background none

    &__dropdown
      &.open
        left 0
        
      &--nv1
      &--nv2
        // Usando position fixed e width fixo pois absolute quebra o top para nivel 2+
        position fixed
        width 270px
        background #fff
        height calc(100vh - 55px)
        left -100%
        top 55px
        transition $transition
        z-index 2147483002 !important

    &__list
      &--root
        max-height calc(100vh - 55px - 255px)
        max-height calc(100dvh - 255px)
        overflow auto
        overscroll-behavior contain
        -webkit-overflow-scrolling touch

        &::-webkit-scrollbar
          width 5px

      &--nv1
      &--nv2
        overflow auto
        max-height: calc(100vh - 55px - 40px);
        max-height: calc(100dvh - 40px);
        overscroll-behavior contain
        -webkit-overflow-scrolling touch
