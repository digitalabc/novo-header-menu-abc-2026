.departments

  &__item
    > a
      display flex
      flex-direction column
      align-items center
      width 100%
    @media mobile
      width 120px
    @media desktop
      &:hover 
        .departments__icon
          border 1px solid $primary
          svg
            fill $primary
        .departments__title
          color $primary

  &__icon
    display grid
    place-items center
    background #F7F7F7
    border 1px solid #F7F7F7
    width 130px
    height 130px
    margin-bottom 15px
    position relative
    aspect-ratio 1
    transition $transition
    svg
      fill #5D5D5D
      transition $transition
    img
      display block
      width 100%
      height 100%
      object-fit cover

  &__title
    font-weight 500
    color #5D5D5D
    text-align center
    transition $transition

  @media mobile
    .swiper
      margin 0 -15px
      padding 0 15px
      &-button
        &-next
        &-prev
          display none
