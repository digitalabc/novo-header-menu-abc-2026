.ruler
  margin 0 auto

  &__list
    display flex
    justify-content space-between
    align-items center
    overflow auto
    white-space nowrap
    gap 35px
    @media mobile
      margin 0 -15px
      padding 0 15px
      &::-webkit-scrollbar
        height 0
  &__item
    flex-shrink 0
  &__text
    display block
    color #5D5D5D
    letter-spacing 0
    font-weight 300

    strong
      color $primary
      line-height 20px
      font-weight 600

    &-wrapper
      display flex
      justify-content center
      align-items center
      gap 5px

      svg
        display block
        flex-shrink 0