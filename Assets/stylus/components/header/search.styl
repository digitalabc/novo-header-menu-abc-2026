.search
  &__form
    position: relative;
    width: 420px;
    @media mobile
      width 100%

    input
      width: 100%;
      height: 40px;
      border: none;
      background: none;
      color $black
      border-bottom 1px solid #5D5D5D
      &::placeholder
        color #5D5D5D

      &:focus
        outline: none;

  &__submit
    height 40px
    display grid
    place-items center
    cursor pointer
    position: absolute;
    top: 0;
    right: 0;
    border: none;
    background: none;
    color $primary
    transition color .2s ease-in-out
    &:hover
      color $black

  &__close
    @media desktop
      display none

.show-mobile-nav
  .search
    &__form
      padding 20px 15px
      position: fixed;
      inset: 0;
      z-index: 5;
      background: #fff;
      top -100vh
      height: 500px;
      transition transform 0.2s ease-in-out
      .show-search&
        transform translateY(100vh)

    &__submit
      top: 20px;
      right: 15px;

    &__close
      background rgba(0,0,0,0.3)
      content ''
      position absolute
      top 100%
      left 0
      width 100%
      height calc(100vh - 500px)

@import "./autocomplete.styl";