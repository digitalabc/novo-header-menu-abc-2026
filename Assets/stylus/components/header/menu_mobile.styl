.menu__button
  background: none;

#menu-canvas
  &.uk-offcanvas-overlay::before
    background: rgba(0, 0, 0, 0.3);

  &.uk-open
    > .uk-offcanvas-bar
      left: 0;

  .uk-offcanvas-bar
    overflow: visible;
    padding: 0;
    width: 270px;
    left: calc(-270px - 55px);
    background: #ffffff;

  .uk-offcanvas-close
    top: 0;
    left: 100%;
    width: 55px;
    height: 55px;
    background: $primary;

    svg
      &:not(#close-svg)
        display: none;
        
  .nav-mobile
    &__header
      display flex
      align-items flex-end
      padding 0 15px 10px
      height 55px
      gap 6px
      background #F7F7F7
      .info
        flex 1
        >p
          color $primary
          font-weight 500
          margin-bottom 2px
        &__bottom
          display flex
          justify-content space-between
        &__links
          font-size 12px
          line-height 15px
          color #5D5D5D
          a
            color #5D5D5D

          &.authenticated
            display none

    &__others
      ul
        li
          display flex
          align-items center
          height 41px
          border 1px solid #F7F7F7
          padding-left 15px
          margin-bottom: -1px;
          a
            color $black
            font-weight 500

    &__link
      color $black
      font-weight 500
      position relative
      display flex
      align-items center
      height 40px
      padding-left 15px

    &__item
      padding-right 40px
      &--nv1
        background #F7F7F7
      &--nv2
        border 1px solid #F7F7F7
        &:not(:last-child)
          margin-bottom: -1px;

    &__open
      background none
      position absolute
      right -40px
      display flex
      align-items center
      justify-content center
      width 40px
      height 40px
      z-index 1
      svg
        pointer-events none

    &__back
      display flex
      align-items center
      gap 15px
      width 100%
      height 41px
      color $primary
      font-weight 700
      padding-left 15px
      margin-bottom: -1px;
      border 1px solid #F7F7F7
      background none

    &__dropdown
      &.open
        left 0
        
      &--nv1
      &--nv2
        // Usando position fixed e width fixo pois absolute quebra o top para nivel 2+
        position fixed
        width 270px
        background #fff
        height calc(100vh - 55px)
        height calc(100dvh - 55px)
        left -100%
        top 55px
        transition $transition
        z-index 2

    &__list
      &--root
        max-height calc(100vh - 55px - 240px)
        max-height: calc(100dvh - 55px - 240px);
        overflow auto
      &--nv1
        overflow auto
        max-height: calc(100vh - 55px - 40px);
        max-height: calc(100dvh - 55px - 40px);