.product
  .breadcrumb
    justify-content: flex-start;
    margin-bottom: 20px;
    background: none;

  &__view
    @media desktop
      display: grid;
      margin-bottom: 120px;
      grid-template-columns: calc((530/1300)*100%) 1fr;
      gap: 60px;

  &__image
    position: relative;
    grid-area: 1 / 1 / 2 / 2;
    .obs
      margin-bottom 20px
      font-size 11px
      color #5D5D5D
      @media mobile
        display none

  &__details
    grid-area: 1 / 2 / 2 / 3;
    max-width 640px

  &__title
    margin-bottom: 4px;
    font-weight: 700;
    font-size: 24px;
    line-height: 32px;

  &__info
    margin-bottom: 10px;
    padding-bottom 10px
    border-bottom 1px solid #D5D5D5
    gap: 20px;
    font-size 12px
    font-weight 500
    color #B4B4B4
    display flex
    align-items center
    gap 5px 20px
    flex-wrap wrap
    a
      color #B4B4B4
      &:hover
        text-decoration underline

    strong
      font-weight 600

  &__prices
    margin-bottom: 20px;
    padding-bottom 20px
    border-bottom 1px solid #D5D5D5

  &__installments
    .payment
      &__title
        color #b8b8b8
        text-decoration: underline;
        font-weight: 400;
        font-size: 14px;
        line-height: 18px;
        cursor: pointer;

        &:hover
          text-decoration: none;

      &__options
        button
          height: 20px;
          background: none;
          line-height: 20px;
          cursor: pointer;

        > div
          transition: $transition;

          li
            padding: 5px 0;
            color: $primary;
            font-weight: 400;
            font-size: 14px;
            line-height: 18px;
            cursor: pointer;

      &__body
        transition: $transition;

  .attribute-selections
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid #EEEEEE;

    h3
      margin-bottom: 12px;
      color: #5D5D5D
      font-weight: 700;

    .attribute
      &:not(:last-child)
        margin-bottom 30px
      select
        appearance: none
        width 200px
        height 40px
        border 1px solid #D5D5D5
        border-radius 0
        padding 0 7px
        font-size 12px
        font-weight 500
        color #5D5D5D
        background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAFCAYAAAB4ka1VAAAABHNCSVQICAgIfAhkiAAAAG9JREFUCFtjjImJecDAwJCwZMmSA0AaDmJjYxOAnABGEOP///8T/v3757Bs2bILIBXIYowgAaApDUDKn4WFxfHXr18KzMzM+4GaAkGmghVAFS0A0vqMjIwKQLpw8eLFID4DXAFUEciKC0CdIPvBAAB98DALc2GrVAAAAABJRU5ErkJggg==')
        background-repeat no-repeat
        background-position right 10px center

  &__quantity
    &--wrapper
      position: relative;
      display: flex;
      align-items: center;
      margin-bottom: 20px;
      gap: 25px;
      @media mobile
        flex-wrap wrap
        gap: 15px 25px;

      .warning
        position: absolute;
        top: 50%;
        left: 100%;
        margin-left: 10px;
        color: #f00;
        white-space: nowrap;
        font-weight: 500;
        font-size: 14px;
        transform: translateY(-50%);

      label
        color: #5D5D5D
        font-weight: 700;
        font-size: 14px;
        line-height: 19px;

    .quantity
      position: relative;
      overflow: hidden;
      width: 125px;
      height: 30px;
      border: 1px solid #D5D5D5
      &.fake-quantity
        width 225px
        input.selected-quantity
          display none

      input
        width: 100%;
        height: 100%;
        color: #5D5D5D
        text-align: center;
        font-weight: 700;
        font-style: normal;
        font-size: 14px;
        -moz-appearance: textfield;
        &::-webkit-outer-spin-button,
        &::-webkit-inner-spin-button
          -webkit-appearance: none;
          margin: 0;
        &.fake-quantity
          width 225px

      > button
        position: absolute;
        top: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 30px;
        height: 30px;
        background: #ffffff;
        color: #392F2D
        font-weight: 700;
        font-size: 14px;
        cursor: pointer;
        transform: translateY(-50%);
        transition: $transition;
        &:hover
          background $primary
          color #fff

      &-less
        left: 0;
        border-right 1px solid #D5D5D5

      &-more
        right: 0;
        border-left 1px solid #D5D5D5

  &__buttons
    margin-bottom 35px
    @media (min-width 450px)
      display flex
      margin-bottom 25px
      gap 10px

    .buy-button
      display: flex;
      justify-content: center;
      align-items: center;
      height: 40px;
      background: #0FA848
      cursor: pointer;
      transition: $transition;
      color: #fff
      font-weight: 700;
      font-size: 14px;
      width 100%
      @media (max-width 449px)
        margin-bottom 10px
      @media (min-width 450px)
        width: 245px;

      &[disabled]
        background: #B4B4B4;
        cursor: not-allowed;

      &:not([disabled]):hover
        background: $primary;

      &:not([disabled]).hollow
        background #fff
        border 1px solid #0FA848
        color #0FA848
        &:hover
          background: #0FA848
          color #fff

    .pick-up-button
      display: flex;
      justify-content: center;
      align-items: center;
      height: 40px;
      background: #fff
      border 1px solid #0FA848
      cursor: pointer;
      transition: $transition;
      color: #0FA848
      font-weight: 700;
      font-size: 14px;
      width 100%
      @media (min-width 450px)
        width: 215px;

      &[disabled]
        background: #B4B4B4;
        color #fff
        border 1px solid #B4B4B4
        cursor: not-allowed;

      &:not([disabled]):hover
      &.full
        background: #0FA848
        color #fff

    .add-to-cart-button
      display: flex;
      justify-content: center;
      align-items: center;
      height: 40px;
      background: #fff
      border 1px solid #0FA848
      cursor: pointer;
      transition: $transition;
      color: #0FA848
      font-weight: 700;
      font-size: 14px;
      width 100%
      @media (min-width 450px)
        width: 245px;

      &[disabled]
        background: #B4B4B4;
        color #fff
        border 1px solid #B4B4B4
        cursor: not-allowed;

      &:not([disabled]):hover
      &.full
        background: #0FA848
        color #fff
      
    .buy-whatsapp-button
      display: flex;
      justify-content: center;
      align-items: center;
      gap 10px
      height: 40px;
      background: #D5D5D5
      cursor: pointer;
      transition: $transition;
      color: #5D5D5D
      font-weight: 700;
      font-size: 12px;
      width 100%
      @media (max-width 449px)
        margin-bottom 10px
      @media (min-width 450px)
        width: 245px;
      svg
        fill #0FA848
        transition: $transition;

      &[disabled]
        background: #B4B4B4;
        cursor: not-allowed;
        svg
          fill #5D5D5D

      &:not([disabled]):hover
        background: #0FA848
        color #fff
        svg
          fill #fff

  &__information
    display flex
    flex-wrap wrap
    @media desktop
      margin-bottom 60px
      &::before
        content ''
        width 100%
        height 3px
        background #E6E6E6
        display block
        order -1
        margin-bottom 25px
    h2
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 0;
      font-size: 20px;
      line-height: 19px;
      cursor: pointer;
      @media mobile
        font-weight: 500;
        color: #333333
        width 100%
        display flex
        align-items center
        justify-content space-between
        &.active
          svg
            transform: rotate(0);

      @media desktop
        color #6E6D6D
        order -2
        padding 0 25px 10px
        position relative
        &:after
          content ''
          display block
          position absolute
          left 0
          top 100%
          width 100%
          height 3px
          background $primary
          z-index 1
          opacity 0
          transition $transition
        &.active
          color: #333333
          font-weight: 500;
          text-transform uppercase
          &:after
            opacity 1
        &:not(last-of-type)
          margin-right 100px

        &:first-of-type
          padding-left 0

      svg
        transition $transition
        transform: rotate(180deg);
        @media desktop
          display none


    > div
      color: #333333
      font-size: 14px;
      line-height: 25px;
      transition $transition
      width 100%
      @media desktop
        display none
      @media mobile
        overflow: hidden;
        max-height: 0;
        margin-bottom 60px
      
      &.show
        @media desktop
          display block
        @media mobile
          max-height: 1500px;
          padding-top 20px
    
    iframe
      max-width 100%
      aspect-ratio 16 / 9
      height: auto;

  &__shipping
    margin-bottom: 20px;

    form
      margin-bottom: 20px;

    .product-shipping
      display: flex;
      align-items: center;
      gap: 30px;

      &-quotes
        position: relative;

      h4
        color: #000000;
        font-weight: 500;
        font-size: 16px;
        line-height: 19px;

      &__input
        position: relative;

        input[type="text"]
          border: 1px solid #D5D5D5
          border-radius: 0;
          color: #000000;
          font-weight: 500;
          font-size: 16px;
          &::placeholder
            color #D5D5D5

      &__submit
        position: absolute;
        top: 50%;
        right: 0;
        width: 45px;
        height: 100%;
        background: #D5D5D5
        color #5D5D5D
        cursor: pointer;
        transform: translateY(-50%);

      &__list
        display: grid;
        padding: 0 15px;
        grid-template-columns: repeat(2, 1fr);
        gap: 5px;

      &__close
        position: absolute;
        top: 15px;
        right: 15px;
        background: none;

      &__quote
        padding: 10px;
        width: 100%;
        border: 1px solid #000000;
        color: #000000;
        text-align: center;

      &__invalid
        color: #f00;
        font-weight: 500;
        font-size: 14px;

  &__pick-up
    display none

  &__similar
    margin-bottom: 30px;

    h3
      margin-bottom: 12px;
      color: #000000;
      font-weight: 500;
      font-size: 14px;
      line-height: 16px;

    .similar
      &__list
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;

  &__buy-together
    margin: 0 auto 120px;
    max-width: 1400px;
    h2
      font-size 20px
      font-weight 500
      margin-bottom 20px

    .attribute-selections
      margin-bottom 0
      padding-bottom 0
      border-bottom none
      h3
        margin-bottom: 9px;
        color: #1F1F1F
        font-weight: 600;
      .attribute
        &:not(:last-child)
          margin-bottom 15px

    .buy-together-row-div
      display: flex;
      justify-content: space-between;
      max-width 935px

      @media mobile
        flex-direction: column;
        gap: 40px;

      img
        max-width: 245px;
        width: 100%;

    .separator
      display: flex;
      justify-content: center;
      align-items: center;

      &.equal
        @media mobile
          display: none;

      h3
        color: #333333
        text-transform: uppercase;
        font-weight: 700;
        font-size: 40px;

    .buy-together
      &__image
        margin-bottom: 12px;

      &__quantity
        display: none;

      &__price
        display: flex;
        flex-direction: column;
        justify-content: center;
        .spot-price
          s
            display block
            font-size 14px
            text-decoration none
            color #333333
            margin-bottom 8px
            font-weight 500
          h3
            font-size 18px
            small
              display none
        .best-installment
          display none

        .buy-button
          display none
        
        .add-to-cart-button
          display: flex;
          justify-content: center;
          align-items: center;
          width: 245px;
          height: 40px;
          background: #0FA848;
          cursor: pointer;
          color: #ffffff;
          font-weight: 700;
          font-size: 14px;
          transition: $transition;

          &[disabled]
            background: #656565;
            cursor: not-allowed;

          &:not([disabled]):hover
            background: $primary;

      &__title
        color: #333333
        font-size: 16px;
        margin-bottom 15px
        strong
          color $primary

  &__reviews
    margin-bottom 70px
    h2
      font-size 20px  
      font-weight 500
    
  &__recommendation
    margin-bottom: 20px;
    h2
      font-size 20px
      font-weight 500
      margin-bottom 20px

  &__wholesale
    margin-bottom: 30px;

    span
      margin-bottom: 12px;
      color: #000000;
      text-transform: uppercase;
      font-weight: 500;
      font-size: 16px;
      line-height: 19px;

    .wholesale
      &__list
        display: flex;
        flex-direction: column;
        gap: 18px;

      &__option
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;

        label
          margin-bottom: 12px;
          color: #000000;
          text-transform: uppercase;
          font-weight: 500;
          font-size: 16px;
          line-height: 19px;

        div
          display: flex;
          justify-content: center;
          align-items: center;
          width: 100%;
          height: 50px;
          background: $secondary;
          color: #010101;
          font-size: 14px;
          line-height: 18px;
          cursor: pointer;
          gap: 20px;

          strong
            font-size: 18px;
            line-height: 24px;
