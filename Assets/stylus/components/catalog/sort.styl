.sort
  display flex
  align-items center
  gap 10px
  @media mobile
    flex 1
    max-width 200px
  &__text
    font-size 12px
    font-weight 500
    @media mobile
      display none
  select
    appearance: none
    width 200px
    height 40px
    border 1px solid #D5D5D5
    border-radius 12px
    padding 0 7px
    font-size 12px
    font-weight 500
    color #5D5D5D
    background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAFCAMAAABPT11nAAAAJ1BMVEUAAABgYGBaWlpcXFxdXV1cXFxcXFxdXV1cXFxcXFxcXFxdXV1cXFzaGNODAAAADXRSTlMAEDBAYICgsM/Q4O/whREWYQAAACZJREFUCNclxLcBACAMACA0sfv/vQ4yYAfkkLf6tVnqCejzJLA6HgzkAIeunpnQAAAAAElFTkSuQmCC')
    background-repeat no-repeat
    background-position right 10px center
    @media mobile
      width 100%
