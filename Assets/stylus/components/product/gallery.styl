.gallery
  width 100%
  margin-bottom 20px

  &-slider
    width 100%
    height auto
    border 2px solid #EAEAEA
    margin-bottom 10px

    .swiper-slide
      img
        display block
        margin 0 auto

  &-thumbs
    padding 0
    width 100%
    &:not(.swiper-initialized)
      ul
        gap 30px

        li
          flex 0 0 calc((100%/4) - (3*30px/4))

    .swiper-slide
      opacity 0.4
      border 1px solid transparent
      transition opacity .2s ease-in-out, border .2s ease-in-out
      cursor pointer

      &-thumb-active
        opacity 1
        border 1px solid $primary

      img
        width 100%
        height auto
  
  .swiper-container
    @media desktop
      max-width 410px
      margin 0 auto
    @media mobile
      display none