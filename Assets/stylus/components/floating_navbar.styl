.floating-navbar
  position: fixed;
  bottom: 0;
  left: 0;
  z-index: 999;
  width: 100%;
  height: 85px;
  padding 0 15px
  background: #F7F7F7
  display: flex;
  justify-content: space-between;
  align-items: center;
  @media desktop
    display: none;

  > button
    height: 45px;
    background: none;
    display flex
    flex-direction column
    align-items center
    svg
      display block
      margin-bottom auto