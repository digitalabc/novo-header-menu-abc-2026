/* LEIA-ME */

/* login.css >> Definições das páginas de LOGIN do novo Checkout */
/* minhaconta.css >> Definições das páginas de MINHA CONTA do novo Checkout */
/* checkout.css >> Definições das páginas de CARRINHO, FECHAMENTO E CONFIRMAÇÃO do novo Checkout */
/* geral.css >> Definições de Cabeçalho e Rodapé */

/* adicione/edite este arquivo para sobrescrever as definições padrão da loja */

.fbits-login 

    .fbits-social-login
        &:before
            text-align center
        button.btn
            margin: 10px 10px 10px 0
            width: 47%
            border-radius 0
            height: 50px;
            transition $transition
            border 1px solid #000000
            color #000
            &.facebook
                &:hover
                    border 1px solid #416bb7
                    color #416bb7

            &.google
                &:hover
                    border 1px solid #dc453a
                    color #dc453a
            &.cadastro
                &:hover
                    border 1px solid $primary
                    color $primary

    .respostas li a,
    .fbits-label.fbits-label-login input
    input[type="text"], 
    input[type="password"] 
    input[type="tel"],
    input[type="Date"],
    select
        border: 1px solid #000000
        height: 50px !important;
        padding: 0 15px;
        border-radius: 0 !important;
        box-shadow: none;
        font-size 14px
        color #000000
        text-align left
        font-weight 400
        &::placeholder
          color #000000
    .cadastroUsuario
      input[type="text"], 
      input[type="password"] 
      input[type="tel"],
      input[type="Date"]
        background #fff
        border 1px solid !important
        color #000000
        &::placeholder
          color #000000

    .respostas li a
        text-align center
        transition: $transition
        &:hover
            background #919191
            color #fff

    .fbits-title-login
    .header-cadastro .title
        margin-bottom 0
        color #000
        font-size 25px
        font-weight bold
        text-transform uppercase

    .fbits-subtitle-login
    .header-cadastro p
        color #676767
        font-size 16px
        font-weight: normal;

    .row 
        display: flex 
        justify-content: center 
        @media(max-width: 991px)
            flex-wrap: wrap

    .header-cadastro
        text-align: center

    .cadastroUsuario #naoSeiCep
        font-size: 14px;
        font-weight: bold;
        color #676767
        transition: $transition
        &:hover
            color #000

    .cadastroUsuario label
        font-size 14px
        color #676767
        font-weight bold

    .ola
        color #000
        &:before
            content 'Olá, '
        &:after
            content: "Identificamos que voc\00ea \00a0 j\00e1 \00a0 possui cadastro. Para sua seguran\00e7 a, selecione a op\00e7\00e3o correta para continuar:";
            display: block;
            background: #fff;
            color #676767
            padding-bottom: 15px;
            font-size: 14px;
            line-height normal
            font-weight 400
    
    .pergunta
        >a
            display: block;    
            margin: 0 0 0 auto;
            width: min-content;
            margin-top: 15px;
            color: #848484;
            transition: $transition
            &:hover
                color #000
        +.fbits-social-login
            padding 0 15px
        
    a[href="/Login/Authenticate"]
        background: #fff;
        border: 1px solid #ccc;
        margin: 0 auto;
        display: block;
        width: 250px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 50px;
        margin-top: 10px;
        color: #333;
        font-size: .9em;
        text-transform: uppercase;
        transition $transition
        &:hover
            background #B2B2B2
            color #fff
        @media (max-width 500px)
            width calc(100% - 30px)

                
    label[for="TelefonePrincipalDDD"]
    label[for="TelefoneSecundarioDDD"]
        width: 100%;
    
    .cadastroUsuario .fbits-btn-show-password 
        top: 33px !important;

    label.form-check-label 
        display: inline;
        font-weight 400
        color #393939
    
    .cadastroUsuario .title.big
        background: #000 !important
        color: white
        font-weight: bold
        line-height: 45px
        border-radius 5px
        font-size 18px
        text-transform uppercase

    .questao
        &:before
            display none
        &:hover
            background #fff
    .fbits-link-senha
        color #028AFF
        text-decoration underline
        @media mobile
            &::before
                content ''
                display block

    .questao,
    .cadastroUsuario .btn-primary,
    .fbits-box-login .btn.btn-success,
    .cadastroUsuario .btn-primary
        @extends $default-button
        

@media(max-width: 500px)
    .fbits-login .fbits-social-login button 
        margin: 10px 0
        width: 100%
        margin-right 0 !important
        margin-left 0 !important

@media(max-width: 991px)
    .fbits-login
        .row    
            margin: 0 !important
        label
            display block
        .cadastroUsuario
            .fbits-btn-show-password 
                top: 8px !important;
            .header-cadastro .btn.btn-secondary
                display inline 
            .formBox
                padding 0
            .form-group
                margin-bottom: 10px;
                width: 100%;
                padding: 0;
            .col-md-6
                width: 100%;
                padding 0
                margin-bottom 10px
            .formBox:last-child .form-row > .form-group.col-md-6:last-child > label
                display none
