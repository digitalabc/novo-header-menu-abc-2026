.gallery
  width 100%
  margin-bottom 20px

  &-slider
    width 100%
    height auto
    border 2px solid #EAEAEA
    margin-bottom 10px

    .swiper-slide
      width auto

      img
        display block
        margin 0 auto
        width auto
        height 100%

  &-thumbs
    padding 0
    width 100%

    .swiper-slide
      opacity 0.4
      border 1px solid transparent
      transition $transition
      cursor pointer

      &-thumb-active
        opacity 1
        border 1px solid $primary

      img
        width 100%
        height auto
  
  .swiper-container
    @media desktop
      max-width 410px
      margin 0 auto
    @media mobile
      display none