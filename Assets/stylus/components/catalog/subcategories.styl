.subcategories, .subTopo
  margin-bottom: 24px;
  font-family: var(--font-brand);

  &__item
    text-align: center;

    @media mobile
      width: 130px;

    .category &
      width: 200px;

    &:hover
      .subcategories
        &__img
          img
            outline: 3px solid $primary;

        &__title
          color: $primary;

  &__title
    font-weight var(--peso-fonte-medium)
    font-size var(--fonte-12)
    transition: $transition;

  &__img
    margin-bottom: 6px;

    img
      display block
      max-width 100%
      height auto
      outline: 3px solid transparent;
      outline-offset: -3px;
      transition: $transition;

  @media mobile
    .swiper
      margin: 0 -15px;
      padding: 0 15px;

      &-button
        &-next, &-prev
          display: none;

.subTopo
  li.subcategories__item
    .category &
      width: 110px;

      @media mobile
        width: 90px;
