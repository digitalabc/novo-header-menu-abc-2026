.ruler
  margin 0 auto

  &__list
    display flex
    justify-content space-between
    align-items center
    overflow auto
    white-space nowrap
    gap 35px
    @media mobile
      margin 0 -15px
      padding 0 15px
      &::-webkit-scrollbar
        height 0
  &__item
    flex-shrink 0

    &:first-child
      order 1

    &:nth-child(2)
      order 4

    &:nth-child(3)
      order 3

    &:nth-child(4)
      order 2

    &:first-child
      .ruler__text-wrapper
        padding 8px 12px
        border 1px solid #25D366
        border-radius 8px
        background-color #25D3661A
        gap 5px

        &:before
          content ''
          display block
          width 24px
          height 24px
          flex-shrink 0
          background transparent

        &.ruler__text-wrapper--icon-replaced
          &:before
            display none

          .ruler__icon-whatsapp
            display block
            width auto
            height 40px
            flex-shrink 0

        svg
          display none

      .ruler__text
        color #00AD14
        margin-left 8px
        font-weight 500

        strong
          color #00AD14
          font-weight 700

    &:nth-child(3)
      .ruler__text-wrapper
        padding 8px 12px
        border 1px solid #CFCFCF
        border-radius 8px
        background-color #F2F2F2
        gap 5px

        &:before
          content ''
          display block
          width 40px
          height 40px
          flex-shrink 0
          background url('https://abcdaconstrucao.fbitsstatic.net/media/mini-franquia-abc.png?v=202603112009') center / contain no-repeat

        &.ruler__text-wrapper--online-icon-replaced
          &:before
            display none

          .ruler__icon-online
            display block
            width auto
            height 40px
            flex-shrink 0

        svg
          display none

      .ruler__text
        color #5D5D5D
        margin-left 8px
        font-weight 500

        strong
          color #392F2D
          font-weight 700

    &:nth-child(4)
      .ruler__text-wrapper
        padding 8px 12px
        border 1px solid #8CBFEA
        border-radius 8px
        background-color #EAF4FF
        gap 5px

        &:before
          content ''
          display block
          width 40px
          height 40px
          flex-shrink 0
          background url('https://abcdaconstrucao.fbitsstatic.net/media/encarte-forms.png?v=202603112016') center / contain no-repeat

        &.ruler__text-wrapper--store-offers-icon-replaced
          &:before
            display none

          .ruler__icon-store-offers
            display block
            width auto
            height 40px
            flex-shrink 0

        svg
          display none

      .ruler__text
        color #2D79C8
        margin-left 8px
        font-weight 400

        strong
          color #2D79C8
          font-weight 700

        .ruler__subtitle
          display block
          font-weight 400
          line-height 1.3

    &:nth-child(2)
      .ruler__text-wrapper
        &:before
          content ''
          display block
          width 24px
          height 24px
          flex-shrink 0
          background url('https://abcdaconstrucao.fbitsstatic.net/media/payment-pix.png?v=202603112019') center / contain no-repeat

        &.ruler__text-wrapper--pix-icon-replaced
          &:before
            display none

          .ruler__icon-pix
            display block
            width auto
            height 24px
            flex-shrink 0

        svg
          display none

  &__text
    display block
    color #5D5D5D
    letter-spacing 0
    font-weight 300

    strong
      color $primary
      line-height 20px
      font-weight 600

    &-wrapper
      display flex
      justify-content center
      align-items center
      gap 5px

      svg
        display block
        flex-shrink 0
