.buy_list
  &__product
    display: flex;
    margin-bottom: 45px;

    br
      display: none;

  &__wrapper
    display: flex;
    align-items: flex-end;
    gap: 30px;

    @media mobile
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;

    .best-installment
      display: none;

  &__block
    display: flex;
    flex-direction: column;
    width: calc(100% - 120px);

  &__name
    display: flex;
    align-items: center;
    margin-bottom: 30px;
    gap: 5px;

    @media mobile
      margin-bottom: 20px;

    input
      width: 20px;
      height: 20px;
      outline: 1px solid #ffffff;
      outline-offset: -2px;
      border: 1px solid $primary;
      cursor: pointer;
      transition: $transition;
      appearance: none;
      -webkit-appearance: none;
      -moz-appearance: none;

      &:checked, &:hover
        background: $primary;

    a
      h5
        color: #010101;
        font-weight: 700;
        font-size: 18px;
        line-height: 24px;

        @media mobile
          font-size: 14px;

  &__image
    margin: 0 20px 0 0;

    img
      max-width: 120px;
      aspect-ratio: 120 / 210;
      object-fit: cover;

  &__attributes
    max-width: 275px;
    width: 100%;

  .attribute-selections
    h3
      margin-bottom: 12px;
      color: #000000;
      font-weight: 500;
      font-size: 16px;
      line-height: 19px;

    > div
      display: flex;
      align-items: center;
      gap: 8px;

      &:not(:last-child)
        margin-bottom: 30px;

  .attribute
    position: relative;
    input
      width: 40px;
      height: 40px;
      border: 1px solid #000000;
      cursor: pointer;
      transition: $transition;
      appearance: none;
      -webkit-appearance: none;
      -moz-appearance: none;

      &:checked
        border-color: $secondary;
        background: $secondary;

    label
      position: absolute;
      top: 50%;
      left: 50%;
      color: #000000;
      font-weight: 500;
      font-size: 14px;
      line-height: 16px;
      cursor: pointer;
      transform: translate(-50%, -50%);

  div.buy_list__quantity
    gap: 30px;

    @media mobile
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;

    label
      color: #000000;
      font-weight: 500;
      font-size: 16px;
      line-height: 19px;

    .quantity
      position: relative;
      overflow: hidden;
      min-width: 120px;
      max-width: 160px;
      width: 100%;
      height: 50px;
      border: 1px solid #000000;

      input
        width: 100%;
        height: 100%;
        color: #000000;
        text-align: center;
        font-weight: 500;
        font-style: normal;
        font-size: 16px;
        line-height: 19px;

      > div
        position: absolute;
        top: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 50px;
        height: 50px;
        background: #ffffff;
        color: #000000;
        font-weight: 500;
        font-size: 16px;
        line-height: 19px;
        cursor: pointer;
        transform: translateY(-50%);

      // Setting 1px for block border
      &-less
        left: 1px;

      &-more
        right: 1px;

    .warning
      position: absolute;
      top: 50%;
      left: 100%;
      margin-left: 10px;
      color: #f00;
      white-space: nowrap;
      font-weight: 500;
      font-size: 14px;
      transform: translateY(-50%);

  &__price
    > span
      color: #010101;
      font-weight: 500;
      font-size: 14px;

    .spot-price
      h3, s
        white-space: nowrap;

      small
        display: none;

  button.buy-button
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 50px;
    background: $primary;
    cursor: pointer;
    transition: $transition;

    span
      color: #ffffff;
      font-weight: 700;
      font-size: 16px;
      line-height: 21px;
      transition: $transition;

    &[disabled]
      background: #656565;
      cursor: not-allowed;

    &:not([disabled]):hover
      background: $secondary;

      span
        color: #000000;