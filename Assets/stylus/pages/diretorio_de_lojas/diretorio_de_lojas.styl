.container__total
  width 100%
  height 100%
  background: #F0F3F5;

.container-lojas
  margin 0 auto
  padding-top 15px
  max-width 1300px

.lojas__top
  margin-bottom 65px
  padding 32px 40px 36px
  border 1px solid #e3ebf0
  border-radius 16px
  background #FFFFFF
  @media (max-width 600px)
    padding 24px 20px 28px
  b
    font-weight 400

  &--title
    margin-bottom 28px
    padding-bottom 20px
    border-bottom 1px solid #eef3f6
    color #0D3547
    font-weight 400
    font-size clamp(1.5rem, 4vw, 2rem)
    line-height 1.25
    letter-spacing -0.02em

  &--text
    position relative
    overflow hidden
    height 78px
    color #0D3547
    font-weight 300
    font-style normal
    font-size 16px
    line-height 26px

    &:before
      position absolute
      bottom 0
      width 100%
      height 52px
      background linear-gradient(transparent, #fff)
      content ''
      
    &.show-text
      height auto
      &:before
        display none
    
    h2
      font-weight 400

  &--show
    display flex
    justify-content center
    width 100%
    margin-top 4px
    padding-top 24px
    border-top 1px solid #eef3f6

  &--button
    display inline-flex
    align-items center
    justify-content center
    gap 10px
    margin 0
    padding 12px 22px
    border 1px solid #c5d9e6
    border-radius 999px
    background #f5f9fc
    color #0D3547
    font-weight 500
    font-size 15px
    font-family inherit
    line-height 1.2
    cursor pointer
    transition color 0.2s ease, background 0.2s ease, border-color 0.2s ease
    &:hover
      border-color #90b4c9
      background #eef6fb
      color #082a3a
    &:focus-visible
      outline 2px solid #0D3547
      outline-offset 3px
    &-text
      position relative
    &-chevron
      display inline-flex
      flex-shrink 0
      transition transform 0.25s ease
      svg
        display block
    &.rotate &-chevron
      transform rotate(180deg)

.lojas__middle
  display flex
  justify-content space-between
  padding-bottom 65px

  @media (max-width 991px)
    flex-direction column
    justify-content center
    align-items center
    margin 0 15px

  &--title
    color #494949
    font-weight 300
    font-size 24px
    line-height 29px

    @media (max-width 991px)
      margin-bottom 25px

.lojas__form
  &--endereco
    select,
    input
      width 230px
      padding 15px 25px
      height auto
      border 1px solid #80ADC2
      border-radius 50px
      background #F0F3F5
      color #0D3547
      text-indent 0
      font-weight 400
      font-size 12px
      line-height 15px
      @media desktop
        margin-right 15px
      @media mobile
        width 100%
        margin-bottom 15px
    select
      appearance none
      -webkit-appearance none 
      -moz-appearance none 
      background-image svg-inline(select-arrow)
      background-position top 20px right 25px
      background-repeat no-repeat


  &--button
    padding 15px 25px
    height auto
    border-radius 50px
    background #0D3547
    color #fff
    font-weight 400
    font-size 12px
    line-height 15px
    transition $transition  
    &:hover
      background $primary
    @media mobile
      width 100%

.lojas__bottom
  margin 0 auto
  max-width 1300px

  @media (max-width 1325px)
    margin 0 15px

  &--title
    margin-bottom 50px
    color #494949
    font-weight 500
    font-size 24px
    line-height 29px

  &--container
    display grid
    padding-bottom 150px
    grid-template-columns repeat(4, 1fr)
    gap 65px
    @media mobile
      grid-template-columns repeat(3, 1fr)
      gap 50px 30px
    @media (max-width 500px)
      grid-template-columns repeat(2, 1fr)
    .col
      display flex
      flex-direction column
      gap 40px
      @media (max-width 500px)
        gap 30px
    ul
      h3
        margin-bottom 20px
        color #0D3547
        font-weight: 400;
        font-size: 18px;
        line-height: 22px;

      li
        >a
          color #323232
          font-weight 300
          font-size 16px
          line-height 32px
          transition $transition

          &:hover
            color #e11e3c
