.product
  .breadcrumb
    justify-content: flex-start;
    margin-bottom: 20px;
    background: none;

    @media mobile
      margin-top: 0;
      font-size: 12px;

  &__view
    @media desktop
      display: grid;
      margin-bottom: 120px;
      grid-template-columns: calc((530 / 1300) * 100%) 1fr;
      grid-template-rows: auto 1fr;
      grid-template-areas: "image header" "image details";
      gap: 24px 56px;

    @media mobile
      display: flex;
      flex-direction: column;
      margin-bottom: 48px;

  &__header
    margin-bottom: 0;

    @media desktop
      grid-area: header;

    @media mobile
      order: -2;
      margin-bottom: 20px;
      padding-bottom: 0;
      border-bottom: none;

      .product__info
        margin-bottom: 0;
        padding-bottom: 0;
        border-bottom: none;

  &__image
    position: relative;

    @media desktop
      grid-area: image;

    @media mobile
      order: -1;
      margin-bottom: 20px;
      max-width: 320px;
      width: 100%;
      margin-inline: auto;

  &__details
    max-width: 560px;

    @media desktop
      grid-area: details;

    @media mobile
      order: 0;
      margin-bottom: 48px;

  @media desktop
    #information-1 #tblCaracteristicas thead
      display: block;

    #information-1 #tblCaracteristicas thead th
      display: block;
      width: 100%;

  &__title
    margin-bottom: 10px;
    font-weight: 500;
    font-size: 20px;

  &__info
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 12px;
    padding-bottom: 0;
    border-bottom: none;
    color: #B4B4B4;
    font-weight: 500;
    font-size: 12px;
    gap: 12px;

    a
      color: #B4B4B4;

      &:hover
        text-decoration: underline;

    strong
      font-weight: 600;

    .product__sku
      display: inline-flex
      align-items: center
      gap: 6px
      padding: 8px 12px
      border-radius: 999px
      background: #f4f6f8
      border: 1px solid #e3e7ec
      color: #392f2d
      font-weight: 500
      font-size: 12px
      line-height: 1

      #productSku
        color: #392f2d
        font-weight: 500

    > a
      display: inline-flex
      align-items: center
      gap: 6px
      padding: 8px 12px
      border-radius: 999px
      background: #f7fbff
      border: 1px solid #dbeaff
      color: #1d3557
      font-weight: 500
      font-size: 12px
      text-decoration: none

      &:hover
        text-decoration: none
        border-color: #c3ddff

      strong
        color: #1d3557
        font-weight: 500

    .livelo_pontos
      display: inline-flex
      align-items: center
      gap: 6px
      padding: 8px 12px
      border-radius: 999px
      background: #effdf5
      border: 1px solid #d9f3e0
      color: #0f5132
      font-weight: 500
      font-size: 12px
      line-height: 1

      strong
        color: #0fa848
        font-weight: 500

    .pipe
      display: none

    @media mobile
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      line-height: 1.4;

      .pipe
        display: none;

  &__prices
    margin-bottom: 24px;
    padding-bottom: 0;
    border-bottom: none;

    .spot-price
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      margin-bottom: 10px;
      white-space: nowrap;
      gap: 10px 20px;

      .precoDe
        margin-bottom: 0;

      .precoPor
        &:first-child
          padding-top: 0;

        span
          @media mobile
            font-size: 20px;
            line-height: 24px;

      .stamps-discount
        display: flex;
        justify-content: center;
        align-items: center;
        width: 90px;
        height: 25px;
        background: #0FA848;
        color: #fff;
        font-weight: 600;
        font-size: 12px;
        gap: 5px;

    .box-price
      display: flex;
      justify-content: center;
      align-items: center;
      margin-bottom: 15px;
      max-width: 100%;
      min-height: 48px;
      border-radius: 12px;
      background: #F0F3F5;
      color: #0D3547;
      padding: 14px 18px;

      @media mobile
        width: 100%;

    .pix
    .best-installment
      margin-bottom: 10px;
      font-size: 12px;

      strong
        font-weight: 600;

    .pix.pix--ruler-style
      display: flex;
      align-items: center;
      justify-content: center;
      max-width: 100%;
      min-height: 48px;
      padding: 14px 18px;
      border: none;
      border-radius: 12px;
      background: #F0F3F5;
      color: #0D3547;
      font-weight: 600;
      text-decoration: none;
      gap: 8px;

    @media mobile
      .pix.pix--ruler-style
        width: 100%;
        padding: 14px 18px;
        gap: 6px;
        text-decoration: none;

  &__installments
    .payment
      &.open
        .payment
          &__list
            margin-top: 5px;
            max-height: 1000px;

          &__button
            font-size: 0;
            gap: 3.5px;

            &:before
              content: 'Ocultar formas de pagamento';
              font-size: 12px;

            svg
              padding-top: 0;
              padding-bottom: 2px;
              transform: rotateX(180deg);

      &__button
        display: flex;
        align-items: center;
        background: none;
        color: $black;
        text-decoration: underline;
        font-weight: 500;
        font-size: 12px;
        cursor: pointer;
        transition: color 0.2s ease-in-out;
        gap: 7px;

        svg
          padding-top: 2px;
          transition: transform 0.2s ease-in-out;

        &:hover
          color: $primary;

      @media mobile
        &__button
          width: 100%;
          justify-content: center;

      &__list
        overflow: hidden;
        max-height: 0;
        transition: $transition;

      .option
        &:not(:last-child)
          margin-bottom: 5px;

        &__button
          display: flex;
          align-items: center;
          height: 20px;
          background: none;
          background: none;
          color: #392f2d;
          line-height: 20px;
          cursor: pointer;
          transition: $transition;
          gap: 5px;

          &:hover
            color: $primary;

          svg
            transition: transform 0.2s ease-in-out;

          &.open
            svg
              transform: rotateX(180deg);

        &__list
          overflow: hidden;
          max-width: 200px;
          height: 0;
          transition: $transition;

          li
            font-weight: 400;
            font-size: 12px;
            line-height: 20px;
            cursor: pointer;

            &:nth-child(even)
              background: #f5f5f5;

  .attribute-selections
    margin-bottom: 24px;
    padding-bottom: 0;
    border-bottom: none;

    h3
      margin-bottom: 12px;
      color: #5D5D5D;
      font-weight: 700;
      font-size: 14px;

    .attribute
      &:not(:last-child)
        margin-bottom: 30px;

      select
        padding: 0 7px;
        width: 200px;
        height: 40px;
        border: 1px solid #D5D5D5;
        border-radius: 0;
        background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAFCAYAAAB4ka1VAAAABHNCSVQICAgIfAhkiAAAAG9JREFUCFtjjImJecDAwJCwZMmSA0AaDmJjYxOAnABGEOP///8T/v3757Bs2bILIBXIYowgAaApDUDKn4WFxfHXr18KzMzM+4GaAkGmghVAFS0A0vqMjIwKQLpw8eLFID4DXAFUEciKC0CdIPvBAAB98DALc2GrVAAAAABJRU5ErkJggg==');
        background-position: right 10px center;
        background-repeat: no-repeat;
        color: #5D5D5D;
        font-weight: 500;
        font-size: 12px;
        appearance: none;

        @media mobile
          width: 100%;

  &__quantity
    &--wrapper
      position: relative;
      display: flex;
      align-items: center;
      margin-bottom: 24px;
      gap: 20px;

      @media mobile
        flex-wrap: wrap;
        gap: 15px 25px;
        justify-content: center;

        label
          display: none;

        .quantity
          width: 100%;

        .quantity.fake-quantity
          margin: 0 auto;
          width: 100%;

          input.selected-quantity
            display: none !important;

      @media desktop
        label[for="selected-quantity"]
          display: none

        .quantity
          width: 100%;

        .quantity.fake-quantity
          width: 100%;

      .warning
        position: absolute;
        top: 50%;
        left: 100%;
        margin-left: 10px;
        color: #f00;
        white-space: nowrap;
        font-weight: 500;
        font-size: 14px;
        transform: translateY(-50%);

      label
        color: #5D5D5D;
        font-weight: 700;
        font-size: 14px;
        line-height: 19px;

    .subscription-div
      button
        display: inline-block;
        margin: 0 0 30px 30px !important;
        width: 250px;
        height: 40px;
        background: #0fa848;
        color: #fff;
        font-weight: 700;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.2s ease-in-out;

        &[disabled]
          opacity: 0.6;
          pointer-events: none;

    .quantity
      position: relative;
      overflow: hidden;
      width: 125px;
      height: 30px;
      border: 1px solid #D5D5D5;

      &.fake-quantity
        width: 225px;

        input.selected-quantity
          display: none;

      input
        width: 100%;
        height: 100%;
        color: #5D5D5D;
        text-align: center;
        font-weight: 700;
        font-style: normal;
        font-size: 14px;
        -moz-appearance: textfield;

        &::-webkit-outer-spin-button
        &::-webkit-inner-spin-button
          margin: 0;
          -webkit-appearance: none;

        &.fake-quantity
          width: 225px;

      > button
        position: absolute;
        top: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 30px;
        height: 30px;
        background: #ffffff;
        color: #392F2D;
        font-weight: 700;
        font-size: 14px;
        cursor: pointer;
        transition: $transition;
        transform: translateY(-50%);

        &:hover
          background: $primary;
          color: #fff;

      &-less
        left: 0;
        border-right: 1px solid #D5D5D5;

      &-more
        right: 0;
        border-left: 1px solid #D5D5D5;

  &__buttons
    margin-bottom: 32px;

    @media (min-width: 450px)
      display: flex;
      margin-bottom: 25px;
      gap: 10px;

    .pick-up-button
    .secondary-button
    .buy-whatsapp-button
      display: none; // Toggled with js

    .buy-button
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      height: 40px;
      background: #0FA848;
      color: #fff;
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      transition: $transition;

      @media (max-width: 449px)
        margin-bottom: 10px;

      @media (min-width: 450px)
        width: 245px;

      &[disabled]
        background: #B4B4B4;
        cursor: not-allowed;

      &:not([disabled]):hover
        background: $primary;

      &:not([disabled]).hollow
        border: 1px solid #0FA848;
        background: #fff;
        color: #0FA848;

        &:hover
          background: #0FA848;
          color: #fff;

    .pick-up-button
      // display: flex; //applied with js
      justify-content: center;
      align-items: center;
      width: 100%;
      height: 40px;
      border: 1px solid #0FA848;
      background: #fff;
      color: #0FA848;
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      transition: $transition;

      @media (min-width: 450px)
        width: 215px;

      &[disabled]
        border: 1px solid #B4B4B4;
        background: #B4B4B4;
        color: #fff;
        cursor: not-allowed;

      &:not([disabled]):hover
      &.full
        background: #0FA848;
        color: #fff;

      &.full
        &:hover
          background: #fff;
          color: #0FA848;

    .add-to-cart-button
      // display: flex; //applied with js
      justify-content: center;
      align-items: center;
      width: 100%;
      height: 40px;
      border: 1px solid #0FA848;
      background: #fff;
      color: #0FA848;
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      transition: $transition;

      &:before
        content: ''
        width: 16px
        height: 16px
        margin-right: 6px
        background: currentColor
        mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 18"><path fill="%23000" d="M9.322 18h-.56c-.069-.022-.137-.046-.207-.067a1.8 1.8 0 0 1-.746-3.046 2.017 2.017 0 0 1 .883-.474c-.45-.012-.892-.012-1.342-.012A1.775 1.775 0 0 1 5.6 12.375a5.98 5.98 0 0 1 .31-.875.579.579 0 0 0 .033-.317Q4.557 6.289 3.158 1.4c-.04-.141-.1-.2-.255-.2-.713.011-1.427-.009-2.139.01A.717.717 0 0 1 0 .766V.446A.718.718 0 0 1 .763 0c.893.017 1.787.006 2.68.006a.62.62 0 0 1 .72.537L4.7 2.406h.268q7.411 0 14.822-.008a.644.644 0 0 1 .654.861C19.653 6 18.874 8.736 18.089 11.474a.612.612 0 0 1-.708.528h-10c-.393 0-.445.039-.564.42a.584.584 0 0 0 .395.743 1.253 1.253 0 0 0 .335.036q4.941 0 9.881 0a.6.6 0 1 1 .008 1.2h-1.84c-.027 0-.053 0-.08 0s-.051.007-.114.015A1.79 1.79 0 0 1 16.83 15.77a1.672 1.672 0 0 1-.6 1.807 4.318 4.318 0 0 1-.866.424H14.8c-.069-.022-.138-.046-.207-.067a1.8 1.8 0 0 1-.746-3.046 2.1 2.2 0 0 1 .879-.48H9.393c0 .013.006.023.01.024.025.006.052.009.077.016a1.757 1.757 0 0 1 1.313 1.342 1.672 1.672 0 0 1-.606 1.787A4.331 4.331 0 0 1 9.322 18z"/></svg>') no-repeat center / contain
        display: inline-block

      @media (min-width: 450px)
        width: 245px;

      &[disabled]
        border: 1px solid #B4B4B4;
        background: #B4B4B4;
        color: #fff;
        cursor: not-allowed;

      &:not([disabled]):hover
      &.full
        background: #0FA848;
        color: #fff;

    .buy-whatsapp-button
      // display: flex; //applied with js
      justify-content: center;
      align-items: center;
      width: 100%;
      height: 40px;
      background: #D5D5D5;
      color: #5D5D5D;
      font-weight: 700;
      font-size: 12px;
      cursor: pointer;
      transition: $transition;
      gap: 10px;

      @media (max-width: 449px)
        margin-bottom: 10px;

      @media (min-width: 450px)
        width: 245px;

      svg
        transition: $transition;
        fill: #0FA848;

      &[disabled]
        background: #B4B4B4;
        cursor: not-allowed;

        svg
          fill: #5D5D5D;

      &:not([disabled]):hover
        background: #0FA848;
        color: #fff;

        svg
          fill: #fff;

    @media mobile
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 10px;

      .buy-button
      .add-to-cart-button
        flex: 1;
        height: 44px;
        font-size: 14px;

      .buy-button
        margin-bottom: 0;

      .add-to-cart-button
        position: relative;
        font-size: 0;

        &:before
          content: '';
          width: 16px;
          height: 16px;
          margin-right: 6px;
          background: currentColor;
          mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 18"><path fill="%23000" d="M9.322 18h-.56c-.069-.022-.137-.046-.207-.067a1.8 1.8 0 0 1-.746-3.046 2.017 2.017 0 0 1 .883-.474c-.45-.012-.892-.012-1.342-.012A1.775 1.775 0 0 1 5.6 12.375a5.98 5.98 0 0 1 .31-.875.579.579 0 0 0 .033-.317Q4.557 6.289 3.158 1.4c-.04-.141-.1-.2-.255-.2-.713.011-1.427-.009-2.139.01A.717.717 0 0 1 0 .766V.446A.718.718 0 0 1 .763 0c.893.017 1.787.006 2.68.006a.62.62 0 0 1 .72.537L4.7 2.406h.268q7.411 0 14.822-.008a.644.644 0 0 1 .654.861C19.653 6 18.874 8.736 18.089 11.474a.612.612 0 0 1-.708.528h-10c-.393 0-.445.039-.564.42a.584.584 0 0 0 .395.743 1.253 1.253 0 0 0 .335.036q4.941 0 9.881 0a.6.6 0 1 1 .008 1.2h-1.84c-.027 0-.053 0-.08 0s-.051.007-.114.015A1.79 1.79 0 0 1 16.83 15.77a1.672 1.672 0 0 1-.6 1.807 4.318 4.318 0 0 1-.866.424H14.8c-.069-.022-.138-.046-.207-.067a1.8 1.8 0 0 1-.746-3.046 2.1 2.1 0 0 1 .879-.48H9.393c0 .013.006.023.01.024.025.006.052.009.077.016a1.757 1.757 0 0 1 1.313 1.342 1.672 1.672 0 0 1-.606 1.787A4.331 4.331 0 0 1 9.322 18z"/></svg>') no-repeat center / contain;
          display: inline-block;

        &:after
          content: 'Adicionar';
          font-size: 14px;
          font-weight: 700;
          color: currentColor;

      .buy-whatsapp-button
        flex: 1.2;
        height: 48px;
        padding: 6px 8px;
        font-size: 11px;
        line-height: 1.1;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;

        svg
          margin: 0;

  &__information
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
    padding: 12px;
    border: 1px solid #E4EBF1;
    border-radius: 18px;
    background: linear-gradient(180deg, #FFFFFF 0%, #FBFDFF 100%);
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.05);

    h2
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 0;
      width: 100%;
      padding: 12px 14px;
      border: 1px solid #DCE6EC;
      border-radius: 14px;
      background: linear-gradient(180deg, #FFFFFF 0%, #F8FBFC 100%);
      color: #0D3547;
      font-weight: 600;
      font-size: 15px;
      line-height: 1.3;
      cursor: pointer;
      box-shadow: 0 6px 14px rgba(15, 23, 42, 0.04);
      transition: all 0.2s ease-in-out;

      a
        display: flex;
        flex: 1;
        color: inherit;

      &:hover
        border-color: #BFD2DC;
        transform: translateY(-1px);

      &.active
        background: #0D3547;
        border-color: #0D3547;
        color: #fff;
        box-shadow: 0 10px 22px rgba(13, 53, 71, 0.14);
        transform: none;

        svg
          transform: rotate(0);

      svg
        flex-shrink: 0;
        width: 18px;
        height: 18px;
        transition: $transition;
        transform: rotate(180deg);
        color: currentColor;

        path
          fill: currentColor;

      &-panel
      width: 100%;
      overflow: hidden;
      max-height: 0;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-2px);
      color: #334155;
      font-size: 13px;
      line-height: 1.65;
      transition: max-height 0.28s linear, opacity 0.2s linear, transform 0.2s linear, visibility 0.2s linear;

      &.show
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
        margin-bottom: 6px;

      &__content
        width: 100%;
        box-sizing: border-box;
        padding: 2px 0 0;

    #information-1 > .product__information-panel__content
      display: block;
      width: 100%;

      > *
        width: 100%;
        min-width: 0;
        max-width: 100%;
        display: block;
        margin-bottom: 10px;

        &:last-child
          margin-bottom: 0;

      #blocoDescricaoAmigavel
        padding: 12px;
        border: 1px solid #E6EEF3;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.05);
        min-width: 0;
        max-width: 100%;
        width: 100%;
        float: none;

        p
          margin-bottom: 10px;
          color: #334155;
          line-height: 1.6;

          &:last-child
            margin-bottom: 0;

        strong
          color: #0D3547;
          font-weight: 700;

        ul,
        ol
          display: block;
          padding-left: 16px;
          margin: 0 0 10px;

        li
          margin: 0 0 6px;

        &,
        > *,
        p,
        div,
        ul,
        ol,
        li,
        span
          width: 100% !important;
          max-width: none !important;
          min-width: 0 !important;
          float: none !important;
          box-sizing: border-box;
          word-break: normal;
          overflow-wrap: break-word;

      #tblCaracteristicas
        width: 100%;
        display: block;
        border-collapse: separate;
        border-spacing: 0;
        overflow: hidden;
        border: 1px solid #E2EAF0;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.05);
        isolation: isolate;

        thead
          display: block;
          border-radius: 14px 14px 0 0;
          overflow: hidden;

        thead th
          display: block;
          width: 100%;
          padding: 10px 12px;
          background: linear-gradient(180deg, #004A68 0%, #053B52 100%);
          border-radius: 14px 14px 0 0;
          color: #fff;
          text-align: left;
          font-weight: 700;
          font-size: 12px;
          letter-spacing: .04em;
          text-transform: uppercase;

        tbody,
        tr,
        td
          display: block;
          width: 100%;

        tr
          padding: 10px 0;
          border-bottom: 1px solid #EEF2F6;

          &:last-child
            border-bottom: none;

        tbody td
          padding: 0 12px;
          border-bottom: none;
          vertical-align: top;

        tbody td:first-child
          width: 100%;
          margin-bottom: 4px;
          background: none;
          color: #004A68;
          font-weight: 700;
          word-break: break-word;
          overflow-wrap: anywhere;

        tbody td:last-child
          color: #334155;
          padding-bottom: 0;

    #information-0 > .product__information-panel__content,
    #information-2 > .product__information-panel__content
      padding: 12px;
      border: 1px solid #E6EEF3;
      border-radius: 14px;
      background: #fff;
      box-shadow: 0 8px 18px rgba(15, 23, 42, 0.05);

    #information-2
      color: #0D3547;
      font-weight: 600;

    iframe
      max-width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;

    @media mobile
      margin-bottom: 60px;
      padding: 12px;
      gap: 8px;

      #information-1 > .product__information-panel__content
        display: block;
        width: 100%;

        > *
          width: 100%;
          min-width: 0;
          max-width: 100%;
          display: block;
          margin-bottom: 12px;

          &:last-child
            margin-bottom: 0;

      #information-1 #blocoDescricaoAmigavel,
      #information-1 #tblCaracteristicas,
      #information-0 > .product__information-panel__content,
      #information-2 > .product__information-panel__content
        padding: 12px;
        box-sizing: border-box;
        width: 100%;
        max-width: 100%;
        min-width: 0;

      #information-1 #blocoDescricaoAmigavel
        display: block;
        min-width: 0;
        max-width: 100%;
        width: 100%;
        float: none;

      #information-1 #blocoDescricaoAmigavel,
      #information-1 #blocoDescricaoAmigavel > *,
      #information-1 #blocoDescricaoAmigavel p,
      #information-1 #blocoDescricaoAmigavel div,
      #information-1 #blocoDescricaoAmigavel ul,
      #information-1 #blocoDescricaoAmigavel ol,
      #information-1 #blocoDescricaoAmigavel li
        width: 100% !important;
        max-width: none !important;
        min-width: 0 !important;
        float: none !important;
        box-sizing: border-box;

      #information-1 #blocoDescricaoAmigavel ul,
      #information-1 #blocoDescricaoAmigavel ol
        display: block;
        padding-left: 16px;
        margin: 0 0 10px;

      #information-1 #blocoDescricaoAmigavel li
        display: list-item !important;
        margin: 0 0 6px;

      #information-1 #tblCaracteristicas thead
        display: none;

      #information-1 #tblCaracteristicas,
      #information-1 #tblCaracteristicas tbody,
      #information-1 #tblCaracteristicas tr,
      #information-1 #tblCaracteristicas td
        display: block;
        width: 100%;

      #information-1 #tblCaracteristicas tr
        padding: 10px 0;
        border-bottom: 1px solid #EEF2F6;

      #information-1 #tblCaracteristicas tr:last-child
        border-bottom: none;

      #information-1 #tblCaracteristicas td
        padding: 0;
        border-bottom: none;

      #information-1 #tblCaracteristicas td:first-child
        margin-bottom: 4px;
        width: 100%;
        background: none;
        word-break: break-word;
        overflow-wrap: anywhere;

      #information-1 #tblCaracteristicas td:last-child
        padding-bottom: 0;

      #information-1 #blocoDescricaoAmigavel p,
      #information-1 #blocoDescricaoAmigavel strong,
      #information-1 #blocoDescricaoAmigavel div,
      #information-1 #blocoDescricaoAmigavel li,
      #information-1 #blocoDescricaoAmigavel span
        word-break: normal;
        overflow-wrap: break-word;

      .product__information-panel
        margin-bottom: 0;

      .product__information-panel__content
        width: 100%;
        box-sizing: border-box;
        padding: 0;

        &.show
          padding-top: 8px;
          margin-bottom: 8px;

  .product-shipping
    margin-bottom: 15px;

    @media desktop
      display: grid;
      align-items: center;
      gap: 5px 7px;
      grid-template-columns: auto 1fr;
      align-contents: center;

      &__help
        grid-area: 2 / 2 / 3 / 3;

      &__response
        max-width: 335px;
        grid-area: 3 / 2 / 4 / 3;

    &__title
      font-weight: 700;
      font-size: 12px;

      @media mobile
        margin-bottom: 20px;

    &__form
      display: flex;

      @media mobile
        margin-bottom: 5px;

    &__input
      max-width: 225px;
      width: 100%;
      height: 35px;
      border: 1px solid #D5D5D5;
      border-radius: 0;
      color: $black;
      font-weight: 500;
      font-size: 12px;

      &::placeholder
        color: #B4B4B4;

      @media mobile
        flex: 1;
        max-width: unset;

    &__submit
      width: 110px;
      height: 35px;
      border-radius: 0;
      background: #0D3547;
      color: #fff;
      font-weight: bold;
      font-size: 12px;
      cursor: pointer;
      transition: $transition;

      &:hover
        background: #1B4A62;
        color: #fff;

    &__help
      display: flex;
      flex: 0 0 100%;

      a
        color: #5D5D5D;
        text-decoration: underline;
        font-size: 9px;
        line-height: 12px;
        transition: $transition;

        &:hover
          color: $primary;

    &__response
      &.hide-pickup
        .free-shipping
          display: none !important;

    &__list
      margin-top: 8px;
      padding: 8px;
      width: 335px;
      border: 1px solid #e8e8e8;
      border-radius: 12px;
      background: #f9fafb;
      box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
      display: flex;
      flex-direction: column;
      gap: 8px;

    &__quote
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 12px;
      font-size: 13px;
      border: 1px solid #eef0f2;
      border-radius: 10px;
      background: #ffffff;

      small
        color: #6b7280;
        font-size: 12px;

    &__value
      color: #0f172a;
      font-weight: 700;
      font-size: 13px;

    &__badge
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 4px 10px;
      border-radius: 999px;
      background: #e8f5ec;
      border: 1px solid #0fa848;
      color: #0fa848;
      font-weight: 700;
      font-size: 11px;
      letter-spacing: 0.02em;
      text-transform: uppercase;

    &__error
      color: $primary;
      font-weight: 500;
      font-size: 12px;

  input
    &:-webkit-autofill
    &:-webkit-autofill:hover
    &:-webkit-autofill:focus
    &:-webkit-autofill:active
      -webkit-box-shadow: 0 0 0 1000px #ffffff inset;
      box-shadow: 0 0 0 1000px #ffffff inset;
      -webkit-text-fill-color: $black;
      caret-color: $black;
      transition: background-color 9999s ease-in-out 0s;

  &__pick-up
    display: none;

  &__similar
    margin-bottom: 30px;

    h3
      margin-bottom: 12px;
      color: #000000;
      font-weight: 500;
      font-size: 14px;
      line-height: 16px;

    .similar
      &__list
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;

  &__buy-together
    h2
      margin-bottom: 20px;
      font-weight: 500;
      font-size: 20px;

      @media mobile
        text-align: center;

    .buy-together-row-div
      display: flex;
      justify-content: space-between;
      margin-bottom: 60px;
      max-width: 935px;

      @media mobile
        flex-direction: column;
        margin-bottom: 40px;
        gap: 40px;

      img
        max-width: 245px;
        width: 100%;
        border: 1px solid #EAEAEA;

    .separator
      display: flex;
      justify-content: center;
      align-items: center;
      max-height: 245px;

      &.equal
        @media mobile
          display: none;

      h3
        color: #333333;
        text-transform: uppercase;
        font-weight: 700;
        font-size: 40px;

    .attribute-selections
      margin: 0 auto;
      margin-bottom: 0;
      padding-bottom: 0;
      max-width: 245px;
      border-bottom: none;

      h3
        margin-bottom: 9px;
        color: #1F1F1F;
        font-weight: 600;

      .attribute
        &:not(:last-child)
          margin-bottom: 15px;

        select
          max-width: 200px;

    .buy-together
      &__image
        margin-bottom: 12px;

        .spot__image-wrapper
          border: none;

      &__quantity
        display: none;

      &__price
        display: flex;
        flex-direction: column;
        justify-content: center;
        max-height: 245px;

        @media mobile
          align-items: center;

        .spot-price
          @media mobile
            margin-bottom: 15px;
            text-align: center;

          .precoDe
            display: block;
            margin-bottom: 8px;
            color: #333333;
            text-decoration: none;
            font-weight: 500;
            font-size: 14px;

          .precoPor
            font-size: 18px;

            small
              display: none;

        .best-installment
          display: none;

        .buy-button
        .pick-up-button
          display: none;

        .add-to-cart-button
          display: flex;
          justify-content: center;
          align-items: center;
          width: 245px;
          height: 40px;
          background: #0FA848;
          color: #ffffff;
          font-weight: 700;
          font-size: 14px;
          cursor: pointer;
          transition: $transition;

          &[disabled]
            background: #656565;
            cursor: not-allowed;

          &:not([disabled]):hover
            background: $primary;

      &__title
        margin-bottom: 15px;
        color: #333333;
        font-size: 16px;

        strong
          color: $primary;

  &__reviews
    margin-bottom: 70px;

    h2
      font-weight: 500;
      font-size: 20px;

  &__recommendation
    margin-bottom: 20px;

    h2
      margin-bottom: 20px;
      font-weight: 500;
      font-size: 20px;

      @media mobile
        text-align: center;

  &__unavailable
    margin-top: 20px;
    margin-bottom: 10px;
    font-weight: bold;

  .obs
    color: #5D5D5D;
    font-size: 11px;

    @media mobile
      margin-bottom: 17px;

  &__customization
    margin-bottom: 25px;

    .term-select
      display: none;

.product-floating
  position: fixed;
  bottom: 0;
  z-index: 1;
  width: 100%;
  background: #F7F7F7;
  transition: $transition;
  transform: translateY(100%);
  border-radius: 24px 24px 0 0;

  @media mobile
    padding: 20px 0;
    bottom: 56px;
    box-shadow: 0 -12px 28px rgba(15, 23, 42, 0.18);

  .show-floating &
    transform: translateY(0);

    @media mobile
      transform: translateY(-16px);

  &__container
    @extend $container;

    display: flex;
    align-items: center;
    padding: 7.5px 35px;
    gap: 10px;

    @media mobile
      flex-direction: column;
      padding: 20px;
      gap: 12px;

  &__image
    @media mobile
      display: none;

  &__title
    flex: 1;
    font-weight: 500;
    font-size: 20px;

    @media mobile
      font-size: 14px;

  .buy-button
  .pick-up-button
    display: none;

  .add-to-cart-button
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 40px;
    background: #0FA848;
    color: #fff;
    font-weight: 500;
    font-size: 14px;
    cursor: pointer;
    transition: $transition;

    @media (min-width: 450px)
      width: 245px;

    &[disabled]
      background: #B4B4B4;
      cursor: not-allowed;

    &:not([disabled]):hover
      background: $primary;

  @media mobile
    .add-to-cart-button
      height: 44px;
      border-radius: 999px;

  .pick-up-button
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 40px;
    border: 1px solid #0FA848;
    background: #fff;
    color: #0FA848;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    transition: $transition;

    @media (min-width: 450px)
      width: 215px;

    &[disabled]
      border: 1px solid #B4B4B4;
      background: #B4B4B4;
      color: #fff;
      cursor: not-allowed;

    &:not([disabled]):hover
      background: #0FA848;
      color: #fff;
