
.seo
  border 1px solid #D5D5D5
  margin-bottom 55px
  padding 20px 25px 60px
  position relative

  &:empty
    display none
  @media mobile
    margin-bottom 40px
  &.expand
    > *
      display block
    .seo__button
      font-size 0
      gap 3.5px
      @media mobile
        gap 5px
      &:before
        content 'Ver menos'
        font-size 20px
        @media mobile
          font-size 16px
      svg
        transform rotate(180deg)
  > h1
    display block
    font-size 20px
    font-weight bold
    margin-bottom 25px
    @media mobile
      margin-bottom 10px
    + *
      display: -webkit-box !important;
      overflow: hidden;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;

  > h2
    font-weight: bold;
    margin-bottom 0
    font-size: 1.5em;

  > p
    margin-bottom 10px
    + h2
    + h3
    + h4
    + h5
      margin-top 20px

  > *
    display none

  &__button
    position absolute
    bottom 20px
    cursor pointer
    display flex !important
    align-items center
    gap 7px
    color #0FA848
    font-size 20px
    font-weight bold
    background none
    @media mobile
      font-size 16px
      font-weight 500
      gap 10px
      svg
        width 15px
        height 15px