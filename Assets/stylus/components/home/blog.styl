
.blog
  &__list
    display flex
    gap 20px

  &__item
    width 100%
    border 1px solid #EAEAEA
    background #fff
    transition $transition

    @media desktop
      &:hover
        border 1px solid $primary

    a
      display block
      padding-bottom 20px

      img
        margin-bottom 20px
        border-bottom 1px solid #EAEAEA

  &__content
    padding 0 10px

    h3 a,
    h3
      margin-bottom 10px
      color $black
      font-weight 500
      font-size 14px
      padding-right 20px

    .text
      display block
      margin-bottom 20px
      color #B4B4B4
      font-size 12px
      padding-right 15px

    .link
      color $black
      text-decoration underline
      font-weight 500
      font-size 14px
      transition $transition
      &:hover
        color $primary