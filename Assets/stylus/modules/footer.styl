#footer
  .footer
    &__container
      @extends $container
      
    &__title
      margin-bottom: 15px;
      color: #004A68
      font-weight: 600;
      font-size: 14px;
    
    &__list
      li
        &:not(:last-child)
          margin-bottom 7px

    &__link
      font-size 13px
      color #5D5D5D
      &:hover
        font-weight 500

    &-top
      display flex
      padding: 45px 0 25px;
      @media mobile
        flex-wrap: wrap;
        padding: 40px 12px;
        gap: 60px;

      .footer
        &__block
          &--newsletter
            flex 400
            padding-bottom 20px
          &--institucional
            flex 255
          &--ajuda
            flex 360
          &--atendimento
            flex 290
          &--institucional
          &--ajuda
          &--atendimento
            border-bottom 1px solid #EAEAEA
          &--atendimento
            .footer
              &__list 
                li
                  &:not(:last-child)
                    margin-bottom 13px
                  a
                    display flex
                    align-items center
                    gap 8px
                    font-size 16px
                    font-weight 500
                    color #5D5D5D
                    &:hover
                      color $primary
                  span
                    color #004A68
                    font-size 13px
            
    &-middle
      display flex
      justify-content space-between
      padding-bottom 80px
      .social
        display: flex;
        align-items: center;
        gap: 10px;

      .security
        display: flex;
        align-items: center;
        gap: 20px;

      .payment
        display: flex;
        align-items: center;
        gap: 10px;

    &-bottom
      background #F0F3F5

      .footer
        &__container
          height 50px
          display flex
          align-items center
          justify-content space-between
          
        &__copyright
          font-size 10px
          color #4D4D4D
        &__signature
          display: flex;
          align-items: center;
          gap: 5px;

  .newsletter
    @media desktop
      max-width 250px
    &__title
      font-size 14px
      font-weight 600
      margin-bottom 10px

    &__form
      position relative
      input
        margin: 0;
        width: 100%;
        height: 50px;
        border: none
        border-radius: 0;
        background: #F7F7F7
        font-size 12px
        font-weight 600
        color $black
        margin-bottom 10px
        transition: $transition;
        &::placeholder
          color $black

      button
        margin-top 5px
        display: flex;
        justify-content: center;
        align-items: center;
        height: 50px;
        width 100%
        background: $black;
        cursor: pointer;
        transition: $transition;
        font-weight: 700;
        font-size: 12px;
        color #fff

        &:hover
          background: $primary;

    &__alert
      position absolute
      bottom -20px
      font-weight 500
