.subcategories, .subTopo
  margin-bottom: 30px;

  @media mobile
    margin-bottom: 20px;

  &__item
    text-align: center;

    @media mobile
      width: 130px;

    .category &
      width: 200px;

    &:hover
      .subcategories
        &__img
          img
            outline: 3px solid $primary;

        &__title
          color: $primary;

  &__title
    font-weight: 500;
    font-size: 14px;
    transition: $transition;

  &__img
    margin-bottom: 12px;

    img
      outline: 3px solid transparent;
      outline-offset: -3px;
      transition: $transition;

  @media mobile
    .swiper
      margin: 0 -15px;
      padding: 0 15px;

      &-button
        &-next, &-prev
          display: none;
