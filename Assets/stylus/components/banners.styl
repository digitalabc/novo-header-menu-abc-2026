// Home - Fullbanner
.fullbanner
  .swiper-container
    position relative

  .swiper-slide
    img
      width: 100%;
      height: auto;
      object-fit: cover;

  &.desktop
    .swiper-button-prev,
    .swiper-button-next
      z-index 2
      width 36px
      height 36px
      border-radius 50%
      color #fff
      background rgba(#000, 0.35)

      svg
        display block

    .swiper-button-prev
      left 20px

    .swiper-button-next
      right 20px

  &.mobile
    .swiper-button-prev,
    .swiper-button-next
      display none

  @media mobile
    padding-bottom 0 !important

// Home - Banner Oportunidades
.banner-oportunidades
  .swiper:not(.swiper-initialized)
    @media mobile
      ul
        gap 10px
  ul
    display flex
    @media desktop
      gap 20px
    li
      overflow: hidden;
      position relative
      @media mobile
        width 125px
      &:after
        content ''
        display block
        position absolute
        inset 0
        background #FFFFFF
        opacity 0
        pointer-events none
        transition $transition

      &:nth-child(n + 5)
        display none

      &:hover
        &:after
          opacity 0.2

      img
        transition: $transition;
        display block

  @media mobile
    .swiper
      margin 0 -15px
      padding 0 15px

  &.banner-oportunidades--metais
    @media mobile
      ul
        width 100%

        li
          width 100%
          flex 0 0 100%

          img
            width 100%
            height auto

// Home - Grid de banners
.banner-grid
  > div
    &:first-child
      margin-bottom 20px
  ul
    display flex
    li
      overflow: hidden;
      position relative
      &:after
        content ''
        display block
        position absolute
        inset 0
        background #FFFFFF
        opacity 0
        pointer-events none
        transition $transition

      &:nth-child(n + 5)
        display none

      &:hover
        &:after
          opacity 0.2

      img
        display block
        margin 0 auto

// Home - Banners lateral
.banner-centro
  ul
    li
      overflow: hidden;
      position relative
      &:after
        content ''
        display block
        position absolute
        inset 0
        background #FFFFFF
        opacity 0
        pointer-events none
        transition $transition

      &:nth-child(n + 4)
        display none
        
      @media mobile
        &:not(:last-child)
          margin-bottom 35px

      &:hover
        &:after
          opacity 0.2

      img
        transition: $transition;
        display block
        margin 0 auto

// Home - Banner Instagram
.banner-instagram
  ul
    li
      overflow: hidden;
      @media mobile
        width 240px
        
      a
        position relative
        display block
        &:after
          content ''
          display block
          background-color rgba(#392F2D, 0.45)
          background-image: url("data:image/png;base64,");
          background-position: center;
          background-repeat: no-repeat;
          position absolute
          inset 0
          opacity 0
          transition $transition

        &:hover 
          &:after
            opacity 1

      img
        transition: $transition;
        display block

  @media mobile
    .swiper
      margin 0 -15px
      padding 0 15px
