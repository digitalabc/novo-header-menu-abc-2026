.stores
  .swiper-button-prev,
  .swiper-button-next
    @media desktop
      display flex
      align-items center
      justify-content center
      top 50%
      width 36px
      height 36px
      z-index 2
      transform translateY(-50%)

      svg
        display block

      &.swiper-button-lock
        display none !important

  .swiper-button-prev
    @media desktop
      left 8px

  .swiper-button-next
    @media desktop
      right 8px

  li
    @media mobile
      width 193px

    a
      position relative
      &:after
        content ''
        display block
        position absolute
        inset 0
        background #FFFFFF
        opacity 0
        pointer-events none
        transition $transition
      &:hover
        &:after
          opacity 0.2
  @media mobile
    .swiper
      margin 0 -15px
      padding 0 15px
      &-button
        &-next
        &-prev
          display none
