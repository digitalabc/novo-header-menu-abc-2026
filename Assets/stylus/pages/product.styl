.product
  .breadcrumb
    justify-content: flex-start;
    margin-bottom: 20px;
    background: none;
    @media mobile
      margin-top 0
      font-size 12px

  &__view
    @media desktop
      display: grid;
      margin-bottom: 120px;
      grid-template-columns: calc((530/1300)*100%) 1fr;
      gap: 60px;

  &__image
    position: relative;
    grid-area: 1 / 1 / 2 / 2;

  &__details
    grid-area: 1 / 2 / 2 / 3;
    max-width 640px
    @media mobile
      margin-bottom 60px

  &__title
    margin-bottom: 10px;
    font-size: 20px;
    font-weight 500

  &__info
    margin-bottom: 10px;
    padding-bottom 10px
    border-bottom 1px solid #D5D5D5
    gap: 20px;
    font-size 12px
    font-weight 500
    color #B4B4B4
    display flex
    align-items center
    gap 5px 20px
    flex-wrap wrap
    a
      color #B4B4B4
      &:hover
        text-decoration underline

    strong
      font-weight 600
  

  &__prices
    margin-bottom: 20px;
    padding-bottom 20px
    border-bottom 1px solid #D5D5D5
    .spot-price
      display flex
      align-items center
      gap 10px 20px
      margin-bottom 10px
      flex-wrap wrap
      white-space nowrap
      .precoDe
        margin-bottom 0
      .precoPor
        &:first-child
          padding-top 0
        span
          @media mobile
            font-size: 20px;
            line-height: 24px;

      .stamps-discount
        display flex
        align-items center
        justify-content center
        gap 5px
        height 25px
        width 90px
        background #0FA848
        font-size 12px
        font-weight 600
        color #fff
    .box-price
      margin-bottom 15px
      width 380px
      max-width 100%
      height 40px
      display flex
      align-items center
      justify-content center
      background #D5D5D5
    .pix
    .best-installment
      font-size 12px
      margin-bottom 10px
      strong
        font-weight 600

  &__installments
    .payment
      &.open
        .payment
          &__list
            max-height 1000px
            margin-top 5px
          &__button
            font-size 0
            gap 3.5px
            &:before
              content 'Ocultar formas de pagamento'
              font-size: 12px;
            svg
              padding-top 0
              padding-bottom 2px
              transform rotateX(180deg)

      &__button
        color $black
        font-weight: 500;
        font-size: 12px;
        cursor: pointer;
        background none
        transition color 0.2s ease-in-out
        display flex
        align-items center
        gap 7px
        text-decoration: underline;
        svg
          padding-top 2px
          transition transform .2s ease-in-out

        &:hover
          color $primary

      &__list
        max-height 0
        overflow hidden
        transition: $transition;

      .option
        &:not(:last-child)
          margin-bottom 5px
        &__button
          color: #392f2d;
          height: 20px;
          background: none;
          line-height: 20px;
          cursor: pointer;
          background none
          display flex
          align-items center
          gap 5px
          transition $transition

          &:hover
            color $primary

          svg
            transition transform .2s ease-in-out

          &.open
            svg
              transform rotateX(180deg)

        &__list
          height 0
          overflow hidden
          transition: $transition;
          max-width 200px

          li
            font-weight: 400;
            font-size: 12px;
            line-height: 20px;
            cursor: pointer;
            &:nth-child(even)
              background #f5f5f5


  .attribute-selections
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid #d5d5d5;

    h3
      font-size 14px
      margin-bottom: 12px;
      color: #5D5D5D
      font-weight: 700;

    .attribute
      &:not(:last-child)
        margin-bottom 30px
      select
        appearance: none
        width 200px
        height 40px
        border 1px solid #D5D5D5
        border-radius 0
        padding 0 7px
        font-size 12px
        font-weight 500
        color #5D5D5D
        background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAFCAYAAAB4ka1VAAAABHNCSVQICAgIfAhkiAAAAG9JREFUCFtjjImJecDAwJCwZMmSA0AaDmJjYxOAnABGEOP///8T/v3757Bs2bILIBXIYowgAaApDUDKn4WFxfHXr18KzMzM+4GaAkGmghVAFS0A0vqMjIwKQLpw8eLFID4DXAFUEciKC0CdIPvBAAB98DALc2GrVAAAAABJRU5ErkJggg==')
        background-repeat no-repeat
        background-position right 10px center
        @media mobile
          width 100%

  &__quantity
    &--wrapper
      position: relative;
      display: flex;
      align-items: center;
      margin-bottom: 20px;
      gap: 25px;
      @media mobile
        flex-wrap wrap
        gap: 15px 25px;

      .warning
        position: absolute;
        top: 50%;
        left: 100%;
        margin-left: 10px;
        color: #f00;
        white-space: nowrap;
        font-weight: 500;
        font-size: 14px;
        transform: translateY(-50%);

      label
        color: #5D5D5D
        font-weight: 700;
        font-size: 14px;
        line-height: 19px;

    .quantity
      position: relative;
      overflow: hidden;
      width: 125px;
      height: 30px;
      border: 1px solid #D5D5D5
      &.fake-quantity
        width 225px
        input.selected-quantity
          display none

      input
        width: 100%;
        height: 100%;
        color: #5D5D5D
        text-align: center;
        font-weight: 700;
        font-style: normal;
        font-size: 14px;
        -moz-appearance: textfield;
        &::-webkit-outer-spin-button,
        &::-webkit-inner-spin-button
          -webkit-appearance: none;
          margin: 0;
        &.fake-quantity
          width 225px

      > button
        position: absolute;
        top: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 30px;
        height: 30px;
        background: #ffffff;
        color: #392F2D
        font-weight: 700;
        font-size: 14px;
        cursor: pointer;
        transform: translateY(-50%);
        transition: $transition;
        &:hover
          background $primary
          color #fff

      &-less
        left: 0;
        border-right 1px solid #D5D5D5

      &-more
        right: 0;
        border-left 1px solid #D5D5D5

  &__buttons
    margin-bottom 35px
    @media (min-width 450px)
      display flex
      margin-bottom 25px
      gap 10px

    .pick-up-button
    .secondary-button
    .buy-whatsapp-button
      display none //Toggled with js

    .buy-button
      display: flex;
      justify-content: center;
      align-items: center;
      height: 40px;
      background: #0FA848
      cursor: pointer;
      transition: $transition;
      color: #fff
      font-weight: 700;
      font-size: 14px;
      width 100%
      @media (max-width 449px)
        margin-bottom 10px
      @media (min-width 450px)
        width: 245px;

      &[disabled]
        background: #B4B4B4;
        cursor: not-allowed;

      &:not([disabled]):hover
        background: $primary;

      &:not([disabled]).hollow
        background #fff
        border 1px solid #0FA848
        color #0FA848
        &:hover
          background: #0FA848
          color #fff

    .pick-up-button
      // display: flex; //applied with js
      justify-content: center;
      align-items: center;
      height: 40px;
      background: #fff
      border 1px solid #0FA848
      cursor: pointer;
      transition: $transition;
      color: #0FA848
      font-weight: 700;
      font-size: 14px;
      width 100%
      @media (min-width 450px)
        width: 215px;

      &[disabled]
        background: #B4B4B4;
        color #fff
        border 1px solid #B4B4B4
        cursor: not-allowed;

      &:not([disabled]):hover
      &.full
        background: #0FA848
        color #fff
      &.full
        &:hover
          background: #fff
          color #0FA848

    .add-to-cart-button
      // display: flex; //applied with js
      justify-content: center;
      align-items: center;
      height: 40px;
      background: #fff
      border 1px solid #0FA848
      cursor: pointer;
      transition: $transition;
      color: #0FA848
      font-weight: 700;
      font-size: 14px;
      width 100%
      @media (min-width 450px)
        width: 245px;

      &[disabled]
        background: #B4B4B4;
        color #fff
        border 1px solid #B4B4B4
        cursor: not-allowed;

      &:not([disabled]):hover
      &.full
        background: #0FA848
        color #fff
      
    .buy-whatsapp-button
      // display: flex; //applied with js
      justify-content: center;
      align-items: center;
      gap 10px
      height: 40px;
      background: #D5D5D5
      cursor: pointer;
      transition: $transition;
      color: #5D5D5D
      font-weight: 700;
      font-size: 12px;
      width 100%
      @media (max-width 449px)
        margin-bottom 10px
      @media (min-width 450px)
        width: 245px;
      svg
        fill #0FA848
        transition: $transition;

      &[disabled]
        background: #B4B4B4;
        cursor: not-allowed;
        svg
          fill #5D5D5D

      &:not([disabled]):hover
        background: #0FA848
        color #fff
        svg
          fill #fff


  &__information
    display flex
    flex-wrap wrap
    @media desktop
      margin-bottom 60px
      &::before
        content ''
        width 100%
        height 3px
        background #E6E6E6
        display block
        order -1
        margin-bottom 25px
    h2
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin: 0;
      font-size: 20px;
      line-height: 19px;
      cursor: pointer;
      font-weight 400
      @media mobile
        font-weight: 500;
        color: #333333
        width 100%
        display flex
        align-items center
        justify-content space-between
        &.active
          svg
            transform: rotate(0);

      @media desktop
        color #6E6D6D
        order -2
        padding 0 25px 10px
        position relative
        &:after
          content ''
          display block
          position absolute
          left 0
          top 100%
          width 100%
          height 3px
          background $primary
          z-index 1
          opacity 0
          transition $transition
        &.active
          color: #333333
          font-weight: 500;
          &:after
            opacity 1
        &:not(last-of-type)
          margin-right 100px

        &:first-of-type
          padding-left 0

      svg
        transition $transition
        transform: rotate(180deg);
        @media desktop
          display none


    > div
      color: #333333
      font-size: 14px;
      line-height: 25px;
      transition $transition
      width 100%
      @media desktop
        display none
      @media mobile
        overflow: hidden;
        max-height: 0;
        margin-bottom 60px
      
      &.show
        @media desktop
          display block
        @media mobile
          max-height: 1500px;
          padding-top 20px
    
    iframe
      max-width 100%
      aspect-ratio 16 / 9
      height: auto;

  .product-shipping
      margin-bottom 15px
      @media desktop
        display: grid;
        align-items: center;
        gap: 5px 7px;
        grid-template-columns auto 1fr
        align-contents center
        &__help { grid-area: 2 / 2 / 3 / 3; }
        &__response { grid-area: 3 / 2 / 4 / 3; }

      &__title
        font-weight: 700;
        font-size: 12px;
        @media mobile
          margin-bottom 20px

      &__form
        display flex
        @media mobile
          margin-bottom 5px

      &__input
        width 100%
        max-width 225px
        height 35px
        border: 1px solid #D5D5D5
        border-radius: 0;
        color: $black
        font-weight: 500;
        font-size: 12px;
        &::placeholder
          color #B4B4B4
        @media mobile
          flex 1
          max-width unset

      &__submit
        height 35px
        width 110px
        border-radius: 0;
        background: #D5D5D5
        color #5D5D5D
        font-size 12px
        font-weight bold
        cursor: pointer;
        transition $transition
        &:hover
          background $primary
          color #fff

      &__help
        flex 0 0 100%
        display flex
        a
          font-size 9px
          line-height 12px
          text-decoration underline
          transition $transition
          color #5D5D5D
          &:hover
            color $primary
      &__response
        &.hide-pickup
          .free-shipping
            display none !important
      &__list
        margin-top 5px
        border: 1px solid #d5d5d5
        width 335px
        padding 3px

      &__quote
        display: grid;
        grid-template-columns: 1fr auto;
        padding: 5px;
        font-size 13px
        span
          font-weight 500
          color $primary

          &.free-shipping
            color: #0FA848

          &:nth-child(2)
            text-align right
        small
          font-size 12px
          color: #5d5d5d

      &__error
        color: $primary
        font-weight: 500;
        font-size: 12px;

  &__pick-up
    display none

  &__similar
    margin-bottom: 30px;

    h3
      margin-bottom: 12px;
      color: #000000;
      font-weight: 500;
      font-size: 14px;
      line-height: 16px;

    .similar
      &__list
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;

  &__buy-together
    h2
      font-size 20px
      font-weight 500
      margin-bottom 20px
      @media mobile
        text-align center

    .buy-together-row-div
      display: flex;
      justify-content: space-between;
      max-width 935px
      margin-bottom 60px

      @media mobile
        margin-bottom 40px
        flex-direction: column;
        gap: 40px;

      img
        max-width: 245px;
        width: 100%;
        border 1px solid #EAEAEA

    .separator
      display: flex;
      justify-content: center;
      align-items: center;
      max-height 245px

      &.equal
        @media mobile
          display: none;

      h3
        color: #333333
        text-transform: uppercase;
        font-weight: 700;
        font-size: 40px;

    .attribute-selections
      margin-bottom 0
      padding-bottom 0
      border-bottom none
      max-width 245px
      margin 0 auto
      h3
        margin-bottom: 9px;
        color: #1F1F1F
        font-weight: 600;
      .attribute
        &:not(:last-child)
          margin-bottom 15px
        select
          max-width 200px

    .buy-together
      &__image
        margin-bottom: 12px;
        .spot__image-wrapper
          border none
      &__quantity
        display: none;

      &__price
        display: flex;
        flex-direction: column;
        justify-content: center;
        max-height 245px
        @media mobile
          align-items center
        .spot-price
          @media mobile
            text-align center
            margin-bottom 15px
          .precoDe
            display block
            font-size 14px
            text-decoration none
            color #333333
            margin-bottom 8px
            font-weight 500
          .precoPor
            font-size 18px
            small
              display none
        .best-installment
          display none

        .buy-button
        .pick-up-button
          display none
        
        .add-to-cart-button
          display: flex;
          justify-content: center;
          align-items: center;
          width: 245px;
          height: 40px;
          background: #0FA848;
          cursor: pointer;
          color: #ffffff;
          font-weight: 700;
          font-size: 14px;
          transition: $transition;

          &[disabled]
            background: #656565;
            cursor: not-allowed;

          &:not([disabled]):hover
            background: $primary;

      &__title
        color: #333333
        font-size: 16px;
        margin-bottom 15px
        strong
          color $primary

  &__reviews
    margin-bottom 70px
    h2
      font-size 20px  
      font-weight 500
    
  &__recommendation
    margin-bottom: 20px;
    h2
      font-size 20px
      font-weight 500
      margin-bottom 20px
      @media mobile
        text-align center
  &__unavailable
    font-weight bold
    margin-bottom 10px
    margin-top 20px
  .obs
    font-size 11px
    color #5D5D5D
    @media mobile
      margin-bottom 70px
.product-floating
  position fixed
  z-index 1
  bottom 0
  width 100%
  background #F7F7F7
  transform translateY(100%)
  transition $transition
  @media mobile
    padding 0
  .show-floating &
    transform translateY(0)
    @media mobile
      transform translateY(-75px)

  &__container
    @extends $container
    display flex
    align-items center
    gap 10px
    padding 7.5px 35px
    @media mobile
      flex-direction column
      padding 20px 20px 0
      gap 20px

  &__image
    @media mobile
      display none

  &__title
    flex 1
    font-size 20px
    font-weight 500
    @media mobile
      font-size 14px
  .buy-button
    display none

  .add-to-cart-button
    display: flex;
    justify-content: center;
    align-items: center;
    height: 40px;
    background: #0FA848
    cursor: pointer;
    transition: $transition;
    color: #fff
    font-weight: 500;
    font-size: 14px;
    width 100%
    @media (min-width 450px)
      width: 245px;

    &[disabled]
      background: #B4B4B4;
      cursor: not-allowed;

    &:not([disabled]):hover
      background: $primary;
