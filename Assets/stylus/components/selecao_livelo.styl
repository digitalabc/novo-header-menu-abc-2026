.livelo
  position: fixed;
  top: 50%;
  left: 50%;
  z-index: 999;
  visibility: hidden;
  padding: 32px;
  border-radius: 1.6rem;
  background: #FFF;
  box-shadow: 0 0 2px 0 #000, 0 6px 6px 0 rgba(0, 0, 0, 0.25);
  opacity: 0;
  transform: translate(-50%, -50%);

  &.visible
    visibility: visible;
    opacity: 1;

  &_modal
    position: fixed;
    top: 0;
    left: 0;
    z-index: 999;
    visibility: hidden;
    width: 100%;
    height: 100%;
    background-color: rgba(#000000, 0.3);
    opacity: 0;
    transition: all ease-in-out 0.2s;

    &.visible
      visibility: visible;
      opacity: 1;

  &__close
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    padding: 8px;
    background: none;
    color: #949494;
    transition: $transition;

    &:hover
      color: $primary;

  .livelo__title
    margin-bottom: 16px;
    color: $primary;
    text-align: center;
    font-weight: 700;
    font-size: 24px;

  &__paragraph
    margin-bottom: 16px;
    max-width: 395px;
    color: $black;
    font-weight: 700;
    font-style: normal;
    font-size: 14px;
    line-height: normal;

    @media mobile
      width: 250px;

    span
      color: $primary;
      font-weight: 400;

  &__buttons
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 22px;

    @media mobile
      justify-content: space-between;

  &__stay
    padding: 12px 8px;
    border: 1px solid $black;
    border-radius: 4px;
    background-color: $black;
    color: #FFF;
    font-weight: 700;
    font-size: 12px;
    transition: $transition;

    &:hover
      background-color: #ffffff;
      color: $black;

  &__leave
    padding: 12px 8px;
    border: 1px solid $primary;
    border-radius: 4px;
    background-color: transparent;
    color: $primary;
    font-weight: 700;
    font-size: 12px;
    line-height: normal;
    transition: $transition;

    &:hover
      background-color: $primary;
      color: #ffffff;
