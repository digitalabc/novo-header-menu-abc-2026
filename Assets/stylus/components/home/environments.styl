.environments
  &__item
    @media mobile
      width 200px
    @media desktop
      &:hover 
        .environments__img
          &:after
            opacity 0.2
  &__img
    margin-bottom 15px
    position relative
    border-radius 12px
    overflow hidden
    &:after
      pointer-events none
      content ''
      display block
      position absolute
      inset 0
      background #FFFFFF
      opacity 0
      transition $transition  
  &__title
    font-weight 500

  @media mobile
    .swiper
      margin 0 -15px
      padding 0 15px
      &-button
        &-next
        &-prev
          display none