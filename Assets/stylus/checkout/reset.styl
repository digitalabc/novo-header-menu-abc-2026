input,
textarea,
button,
select
  font-family 'Montserrat', sans-serif !important

body.fbits-carrinho,
body.fbits-login,
html
  background #fff !important
  font-family 'Montserrat', sans-serif !important

*
  box-sizing border-box
  margin 0
  padding 0
  outline none
  border none
  list-style none
  -moz-box-sizing border-box
  -ms-box-sizing border-box
  -webkit-box-sizing border-box
  -o-box-sizing border-box

.btn.active.focus,
.btn.active:focus,
.btn.focus,
.btn:active.focus,
.btn:active:focus,
.btn:focus
  outline none


.container.tyc_container::before
  background-color: #fff3cd;
  color: #856404;
  padding: 16px;
  border-radius: 4px;
  font-family: Arial, sans-serif;
  font-size: 14px;
  text-align: center;
  margin: auto;
  margin-top: 30px;
  width: -webkit-fill-available;