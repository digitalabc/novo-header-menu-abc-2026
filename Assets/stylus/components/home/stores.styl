.stores
  li
    @media mobile
      width 193px

    a
      position relative
      &:after
        content ''
        display block
        position absolute
        inset 0
        background #FFFFFF
        opacity 0
        pointer-events none
        transition $transition
      &:hover
        &:after
          opacity 0.2
  @media mobile
    .swiper
      margin 0 -15px
      padding 0 15px
      &-button
        &-next
        &-prev
          display none