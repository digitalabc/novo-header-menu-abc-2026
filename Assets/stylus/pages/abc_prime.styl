                                    display inline-block

                .spot__buttons .add-to-cart-button
                    display none


            .swiper-slide
                max-width: 277px

                @media desktop
                    transform scale(1)

                &:not(.swiper-slide-next)
                    @media desktop
                        transform scale(0.89)

            .swiper-button-prev, .swiper-button-next
                display none

        &__button
            display: inline-block
            max-width 370px
            width 100%
            height 68px
            line-height: 68px
            border-radius: 32px;
            background: #FFE2AA;
            color: #3E3E3E;
            font-family: "Poppins", sans-serif;
            font-size: 24px;
            font-style: normal;
            font-weight: 700;
            text-align: center
            margin-top 24px
            margin-bottom 36px

            &:hover
                background: #fff
                color: #3E3E3E;

//primeReviews
    .primeReviews
        background: #3E3E3E
        color: #FFF;
        font-family: Nunito;

        h2.abcPrime-title
            font-size: 20px
            line-height: 30px
            font-weight: 400
            font-family: "Poppins", sans-serif
            
            strong
                font-weight: 800
                font-size: 20px
                line-height: 30px
                font-family: "Poppins", sans-serif
                display: inline
        
        &__list
            max-width: 1200px
            margin: 0 auto

            .swiper-wrapper
                @media mobile
                    padding: 0 0 0 10px

            .swiper-button-next, .swiper-button-prev
                @media mobile
                    display none

        &__topo
            display flex
            justify-content: space-between
            align-items: center
            margin-bottom 16px

            img
                @media mobile
                    width 80px
                    height 18px

            p
                text-align: right;
                font-size: 14px;
                font-style: normal;
                font-weight: 700;
                line-height: 21px;
                font-family: "Poppins", sans-serif

                @media mobile
                    font-size 15px

        &__item
            width: 280px;
            padding: 24px;
            font-size: 12px;
            font-style: normal;
            font-weight: 400;
            line-height: 18px;
            border-radius: 10px;
            border: 1.2px solid #FFF;
            font-family: "Poppins", sans-serif

        &__person
            margin-top 16px
            display flex
            gap 13px
            align-items: center

            img
                border-radius: 50%

        &__name
            color: #FFF;
            font-family: "Poppins", sans-serif;
            font-size: 14px;
            font-style: normal;
            font-weight: 700;
            line-height: 21px;

//FAQ
    .primeFAQ
        background: #3E3E3E
        display flex
        flex-direction: column
        align-items: center
        padding-bottom 40px

        h2.abcPrime-title
            padding: 0 0 24px

        @media mobile
            padding: 0 10px 40px

        &__question
            max-width: 930px
            margin: 0 auto
            padding: 0 40px 32px
            border-radius: 16px;
            border: 1.2px solid #FFF;
            margin-bottom: 8px
            @media mobile
                padding: 0 10px 20px

            button
                width 100%
                display flex
                align-items: center
                justify-content: space-between
                background: transparent
                font-family: "Poppins", sans-serif;
                color: #FFF;
                font-size: 20px;
                font-style: normal;
                font-weight: 600;
                line-height: 30px;
                margin: 32px 0 0
                transition all .2s ease-in-out

                @media mobile
                    margin: 20px 0 0
                    font-size 18px
                    gap 5px

                svg
                    fill: none
                    flex-shrink: 0;
                    transition: all .2s ease-in-out;

            button.active
                svg
                    transform: rotateZ(180deg)

        &__response
            max-height: 0
            overflow: hidden

            p
                color: #FFE2AA;
                font-family: "Poppins", sans-serif;
                font-size: 14px;
                font-style: normal;
                font-weight: 400;
                line-height: 21px;
                max-width: 768px
                padding-top 32px
 
        a
            width 215px
            height 68px
            display: inline-block
            color: #3D4544;
            font-family: "Poppins", sans-serif;
            font-size: 24px;
            font-style: normal;
            font-weight: 700;
            line-height: 68px;
            border-radius: 32px;
            background: #FFE2AA;
            text-align: center
            margin-top 16px

            &:hover
                background: #fff