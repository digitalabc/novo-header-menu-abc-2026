.container__total
  width 100%
  height 100%
  background: #F0F3F5;

.container-lojas
  margin 0 auto
  padding-top 15px
  max-width 1300px

.lojas__top
  margin-bottom 65px
  padding 35px
  border-radius 2.5px
  background #FFFFFF
  b
    font-weight 400

  &--title
    margin-bottom 30px
    color #494949
    font-weight 300
    font-size 32px
    line-height 39px

  &--text
    position relative
    overflow hidden
    height 78px
    color #0D3547
    font-weight 300
    font-style normal
    font-size 16px
    line-height 26px

    &:before
      position absolute
      bottom 0
      width 100%
      height 52px
      background linear-gradient(transparent, #fff)
      content ''
      
    &.show-text
      height auto
      &:before
        display none
    
    h2
      font-weight 400

  &--show
    width 100%

  &--button
    position relative
    padding-right 10px
    border none
    background transparent
    color #000
    font-weight 400
    font-size 14px
    cursor pointer

    &:after
      position absolute
      top 50%
      right -10px
      display block
      width 12px
      height 6px
      background-image url("data:image/svg+xml,%3Csvg width='14' height='8' viewBox='0 0 14 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L7 7L13 1' stroke='black' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E%0A")
      background-size contain
      background-repeat no-repeat
      transform translateY(-50%)
      content ''

    &.rotate
      font-size 0
      &:before
        content 'Mostrar menos'
        font-size 14px
      &:after
        top calc(50% - 3px)
        transform rotate(180deg)

.lojas__middle
  display flex
  justify-content space-between
  padding-bottom 65px

  @media (max-width 991px)
    flex-direction column
    justify-content center
    align-items center
    margin 0 15px

  &--title
    color #494949
    font-weight 300
    font-size 24px
    line-height 29px

    @media (max-width 991px)
      margin-bottom 25px

.lojas__form
  &--endereco
    select,
    input
      width 230px
      padding 15px 25px
      height auto
      border 1px solid #80ADC2
      border-radius 50px
      background #F0F3F5
      color #0D3547
      text-indent 0
      font-weight 400
      font-size 12px
      line-height 15px
      @media desktop
        margin-right 15px
      @media mobile
        width 100%
        margin-bottom 15px
    select
      appearance none
      -webkit-appearance none 
      -moz-appearance none 
      background-image svg-inline(select-arrow)
      background-position top 20px right 25px
      background-repeat no-repeat


  &--button
    padding 15px 25px
    height auto
    border-radius 50px
    background #0D3547
    color #fff
    font-weight 400
    font-size 12px
    line-height 15px
    transition $transition  
    &:hover
      background $primary
    @media mobile
      width 100%

.lojas__bottom
  margin 0 auto
  max-width 1300px

  @media (max-width 1325px)
    margin 0 15px

  &--title
    margin-bottom 50px
    color #494949
    font-weight 500
    font-size 24px
    line-height 29px

  &--container
    display grid
    padding-bottom 150px
    grid-template-columns repeat(4, 1fr)
    gap 65px
    @media mobile
      grid-template-columns repeat(3, 1fr)
      gap 50px 30px
    @media (max-width 500px)
      grid-template-columns repeat(2, 1fr)
    .col
      display flex
      flex-direction column
      gap 40px
      @media (max-width 500px)
        gap 30px
    ul
      h3
        margin-bottom 20px
        color #0D3547
        font-weight: 400;
        font-size: 18px;
        line-height: 22px;

      li
        >a
          color #323232
          font-weight 300
          font-size 16px
          line-height 32px
          transition $transition

          &:hover
            color #e11e3c
