#footer
  .footer
    &__container
      @extend $container;

    &__block
      @media mobile
        width: 100%;

      @media desktop
        &--newsletter
          flex: 400;
          padding-bottom: 20px;

        &--institucional
          flex: 255;

        &--ajuda
          flex: 360;

        &--atendimento
          flex: 290;

        &--institucional, &--ajuda, &--atendimento
          border-bottom: 1px solid #EAEAEA;

      &--atendimento
        .footer
          &__list
            li
              &:not(:last-child)
                margin-bottom: 13px;

              a
                display: flex;
                align-items: center;
                color: #5D5D5D;
                font-weight: 500;
                font-size: 16px;
                gap: 8px;

                &:hover
                  color: $primary;

              span
                color: #004A68;
                font-size: 13px;

    &__title
      margin: 0;
      color: #004A68;
      font-weight: 600;
      font-size: 14px;

      @media desktop
        margin-bottom: 15px;

        svg
          display: none;

      @media mobile
        display: flex;
        justify-content: space-between;
        align-items: center;

        svg
          transform: rotateX(180deg);

        + *:not(.social)
          overflow: hidden;
          height: 0;
          transition: $transition;

        &.open
          svg
            transform: rotateX(0);

          + *
            margin-top: 15px;

    &__list
      li
        &:not(:last-child)
          margin-bottom: 7px;

    &__link
      color: #5D5D5D;
      font-size: 13px;

      &:hover
        font-weight: 500;

    &-top
      display: flex;
      padding: 45px 0 25px;

      @media mobile
        flex-wrap: wrap;
        padding: 20px 0 40px;
        gap: 40px;

    &-middle
      display: flex;
      justify-content: space-between;
      padding-bottom: 80px;

      @media mobile
        flex-wrap: wrap;
        padding-bottom: 40px;
        gap: 40px;

      .social
        display: flex;
        align-items: center;
        gap: 10px;

        @media mobile
          margin-top: 15px;

      .security
        li
          display: inline;
          font-size: 0;

          &:not(:last-child)
            margin-right: 20px;

      .payment
        li
          display: inline;
          font-size: 0;

          &:not(:last-child)
            margin-right: 10px;

    &-bottom
      background: #F0F3F5;

      .footer
        &__container
          @media mobile
            padding-top: 35px;
            padding-bottom: 30px;

          @media desktop
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 50px;

        &__copyright
          color: #4D4D4D;
          font-size: 10px;

          @media mobile
            margin-bottom: 30px;
            text-align: center;

        &__signature
          display: flex;
          align-items: center;
          gap: 5px;

          @media mobile
            justify-content: center;

  .newsletter
    @media desktop
      max-width: 250px;

    &__title
      margin-bottom: 10px;
      font-weight: 600;
      font-size: 14px;

      @media mobile
        text-align: center;

    &__form
      position: relative;

      input
        margin: 0;
        margin-bottom: 10px;
        width: 100%;
        height: 50px;
        border: none;
        border-radius: 0;
        background: #F7F7F7;
        color: $black;
        font-weight: 600;
        font-size: 12px;
        transition: $transition;

        &::placeholder
          color: $black;

      button
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 5px;
        width: 100%;
        height: 50px;
        background: $black;
        color: #fff;
        font-weight: 700;
        font-size: 12px;
        cursor: pointer;
        transition: $transition;

        &:hover
          background: $primary;

    &__alert
      position: absolute;
      bottom: -20px;
      font-weight: 500;

#whatsapp
  position: fixed;
  right: 10px;
  bottom: 40px;
  z-index: 999999;
  filter: drop-shadow(2px 4px 6px #999);
  transition: $transition;

  .show-mobile-nav &
    bottom: 80px;