.buy_list
  &__product
    &-wrap
      display: flex;
      margin-bottom: 20px;
      padding-bottom 25px
      border-bottom 1px solid #d5d5d5

  &__wrapper
    display: flex;
    align-items center
    gap: 20px;

    @media mobile
      gap: 10px;

    .best-installment
      display: none;

  &__block
    display: flex;
    flex-direction: column;
    width: calc(100% - 90px);

  &__name
    display: flex;
    margin-bottom: 15px;
    gap: 3px;

    input
      display none
      &:checked
        +.fake-checkbox
          border: 1px solid $primary;
          svg
            opacity 1

    .fake-checkbox
      flex-shrink 0
      width: 16px;
      height: 16px;
      border: 1px solid #5D5D5D;
      cursor: pointer;
      position relative
      transition: $transition;
      display flex
      align-items center
      justify-content center
      svg
        opacity 0
        transition: $transition;

    a
      h5
        font-size: 13px;
        line-height: 16px;
        transition: $transition;
        &:hover
          color $primary

  &__image
    margin: 0 20px 0 0;
    flex-shrink 0

    img
      max-width: 90px;
      object-fit: cover;

  &__attributes
    .attribute-selections
      margin-bottom 0
      padding-bottom 0
      border-bottom none
      .attribute
        margin-bottom 15px !important
      h3
        font-size 12px
        margin-bottom 7px
      
  &__quantity
    
    .warning
      position: absolute;
      top: 50%;
      left: 100%;
      margin-left: 10px;
      color: #f00;
      white-space: nowrap;
      font-weight: 500;
      font-size: 14px;
      transform: translateY(-50%);

    .quantity
      position: relative;
      overflow: hidden;
      width: 125px;
      height: 30px;
      border: 1px solid #D5D5D5

      input
        width: 100%;
        height: 100%;
        color: #5D5D5D
        text-align: center;
        font-weight: 700;
        font-style: normal;
        font-size: 14px;
        -moz-appearance: textfield;
        &::-webkit-outer-spin-button,
        &::-webkit-inner-spin-button
          -webkit-appearance: none;
          margin: 0;

      > button
        position: absolute;
        top: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 30px;
        height: 30px;
        background: #D5D5D5
        color: #392F2D
        font-weight: 700;
        font-size: 14px;
        cursor: pointer;
        transform: translateY(-50%);
        transition: $transition;
        &:hover
          background $primary
          color #fff

      &-less
        left: 0;
        border-right 1px solid #D5D5D5

      &-more
        right: 0;
        border-left 1px solid #D5D5D5


  &__price
    > span
      color: #010101;
      font-weight: 500;
      font-size: 14px;

    .spot-price
      margin-bottom 0
      s
        font-size 12px
        line-height 15px
        margin-bottom 0
      h3 
        span
          font-size 14px
          line-height: 18px;

      small
        display: none;

  .buy-button
  .pick-up-button
    display none

  .add-to-cart-button
    display: flex;
    justify-content: center;
    align-items: center;
    height: 40px;
    background: #0FA848
    cursor: pointer;
    transition: $transition;
    color: #fff
    font-weight: 700;
    font-size: 14px;
    width 100%
    @media (max-width 449px)
      margin-bottom 10px
    @media (min-width 450px)
      width: 245px;

    &[disabled]
      background: #B4B4B4;
      cursor: not-allowed;

    &:not([disabled]):hover
      background: $primary;
