.search
  &__form
    position: relative;
    width: 420px;

    @media mobile
      width: 100%;

    input
      width: 100%;
      height: 40px;
      border: none;
      border-bottom: 1px solid #5D5D5D;
      background: none;
      color: $black;

      &::placeholder
        color: #5D5D5D;

      &:focus
        outline: none;

  &__submit
    position: absolute;
    top: 0;
    right: 0;
    display: grid;
    height: 40px;
    border: none;
    background: none;
    color: $primary;
    cursor: pointer;
    transition: color 0.2s ease-in-out;
    place-items: center;

    &:hover
      color: $black;

  &__close
    @media desktop
      display: none;

.show-mobile-nav
  .search
    &__form
      position: fixed;
      top: -100vh;
      z-index: 5;
      padding: 20px 15px;
      height: 500px;
      background: #fff;
      transition: transform 0.2s ease-in-out;
      inset: 0;

      .show-search&
        transform: translateY(100vh);

    &__submit
      top: 20px;
      right: 15px;

    &__close
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      height: calc(100vh - 500px);
      background: rgba(0, 0, 0, 0.3);
      content: "";

  .virtual_reality__icons
    bottom: 155px;

@import "./autocomplete.styl";