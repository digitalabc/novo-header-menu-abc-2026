#zone
  display: flex;
  align-items: center;
  color: #5D5D5D;
  font-weight: 300;
  font-size: 13px;
  line-height: 130%;
  cursor: pointer;
  gap: 9px;

  > p
    color: #392F2D;
    font-weight: 500;
    font-size: 17px;
    text-decoration-line: underline;

  &-popup
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 99;
    display: none;
    padding: 36px 24px 24px;
    border-radius: 12px;
    background-color: #fff;
    box-shadow: 0 0 2px 0 #000, 0 6px 6px 0 rgba(0, 0, 0, 0.25);

    @media mobile
      left: 15px;
      max-width: calc(100% - 30px);
      width: 100%;

    i
      position: absolute;
      top: -10px;
      left: 18px;
      z-index: -1;
      filter: drop-shadow(0 -3px 0 rgba(0, 0, 0, 0.3));

    > h3
      margin-bottom: 18px;
      color: #392F2D;
      font-weight: 600;
      font-size: 16px;
      line-height: 110%;

    > button
      position: absolute;
      top: 0;
      right: 0;
      display: flex;
      padding: 12px;
      background: none;

    div
      display: flex;
      align-items: center;

      input
        padding: 0 20px;
        height: 48px;
        border-color: #5D5D5D;
        border-right: 0;
        border-radius: 6px 0 0 6px;
        color: #949494;
        font-weight: 500;
        font-size: 12px;
        line-height: normal;

      button
        padding: 16px 40px;
        border-radius: 0 6px 6px 0;
        background-color: $primary;
        color: #ffffff;
        font-weight: 600;
        font-size: 13px;
        line-height: normal;