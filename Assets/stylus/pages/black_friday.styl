$bf_primary = #D88730;

.black_friday
  .container
    max-width: 950px;

  &__fullbanner
    padding: 54px 0;
    background-image: url("https://abcdaconstrucao.fbitsstatic.net/sf/img/blackfriday/fullbanner.jpg?v=9203");
    background-size: cover;
    background-repeat no-repeat;
    background-color: #141615;

    .container
      display flex;
      align-items center;

      @media mobile
        flex-direction column;

      > div
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        max-width: 550px;
        gap: 16px;

  &__title
    color: #FFF;
    font-weight: 700;
    font-size: 32px;

  &__subtitle
    margin-bottom: 32px;
    color: #FFF;
    text-align: center;
    font-weight: 700;
    font-size: 32px;

  &__paragraph
    color: #FFF;
    font-weight: 500;
    font-size: 20px;
    line-height: 140%;

  &__link
    padding: 11px 57px;
    border-radius: 8px;
    background-color: $bf_primary;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 20px;

    &:hover
      color: #ffffff;

  &__disclaimer
    color: #FFFFFF;
    font-weight: 400;
    font-size: 10px;
    line-height: 140%;

  &__advantages
    padding: 32px 0;
    background-color: $bf_primary;

    h2
      margin-bottom: 8px;

    p
      margin-bottom: 32px;
      text-align: center;

  &__cards
    display: flex;
    justify-content: space-between;
    align-items: center;

    @media mobile
      flex-wrap: wrap;

  &__card
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 9px;
    width: calc(((100% - 3 * 75px) / 4));
    height: auto;
    background-color: #000000;
    aspect-ratio: 180 / 150;
    border-radius: 8px

    @media mobile
      margin-bottom: 32px;
      width: calc(((100% - 1 * 32px) / 2));

    i
      display: flex;
      justify-content: center;
      align-items: center;
      margin-bottom: 8px;

      img
        height: 60px

    h3
      color: #FFFFFF;
      text-align: center;
      font-weight: 700;
      font-size: 16px;

  &__categories
    padding: 32px 0;
    background-color: #141615;
    text-align: center;

    .container
      > h2
        margin-bottom: 32px;

  &__showcase
    margin-bottom: 32px;

    @media mobile
      display: flex;
      flex-direction: column;

    &-title
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      margin-bottom: 32px;

      @media mobile
        display: contents;
        margin-bottom: 0;

      h3
        color: #FFFFFF;
        text-align: center;
        font-weight: 700;
        font-size: 32px;

        @media mobile
          margin-bottom: 32px;

      a
        display: block;
        padding: 4px 16px;
        width: max-content;
        border-radius: 16px;
        background-color: $bf_primary;
        color: #FFFFFF;
        font-weight: 500;
        font-size: 16px;
        transition: $transition;

        @media desktop
          position: absolute;
          right: 0;

          &:hover
            background-color: #000000;
            color: $bf_primary;

        @media mobile
          order: 1;
          margin: 0 auto;

    &-list
      display: flex;
      justify-content: space-between;
      align-items: center;

      @media mobile
        flex-wrap: wrap;

  &__spot
    display: flex;
    justify-content: center;
    align-items: center;
    width: calc(((100% - 3 * 75px) / 4));
    height: auto;
    border: 1px solid #FFF;
    border-radius: 8px;
    background: #454041;
    aspect-ratio: 180 / 150;
    overflow hidden; 

    @media mobile
      margin-bottom: 32px;
      width: calc(((100% - 1 * 32px) / 2));

  &__faq
    padding: 32px 0;
    background-color: #060606;

    &-container
      margin: 0 auto;
      max-width: 930px;

      @media mobile
        padding: 0 15px;

    .black_friday__link
      display: block;
      margin: 32px auto 0;
      max-width: fit-content;

  &__question
    margin-bottom: 8px;

    button
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 32px 16px 32px 40px;
      width: 100%;
      border-radius: 16px;
      background: #1D1D1D;
      color: #D88730;
      font-weight: 600;
      font-size: 24px;
      transition: $transition;

      &.active
        border-radius: 16px 16px 0 0;

        svg 
          transform: rotate(180deg);

      svg
        fill: none;
        flex-shrink 0;
        transition: $transition;

    div
      overflow: hidden;
      max-height: 0;
      border-radius: 0 0 16px 16px;
      background-color: #1D1D1D;
      transition: $transition;

      p
        padding-bottom: 32px;
        color: #FFF;
        font-weight: 400;
        font-size: 18px;
        padding-inline: 40px;

// Legacy Black Friday header/menu overrides kept in auaha.css
@media (min-width: 99999px)
  body header .menu__button svg path,
  body header .menu__button svg rect,
  body header .menu__button svg circle,
  body header .nav-mobile__open svg path,
  body header .nav-mobile__open svg rect,
  body header .nav-mobile__open svg circle
    fill #d4af87 !important

  #menu-offcanvas .nav-mobile__others ul li:not(.nav-mobile__others-item--launches):not(.nav-mobile__others-item--consumer):not(.nav-mobile__others-item--chance):not(.nav-mobile__others-item--cupons):not(.nav-mobile__others-item--specialist):not(.nav-mobile__others-item--store-offers)
    border none !important

  #menu-offcanvas .nav-mobile__item--nv2
    border none !important

  #menu-offcanvas .nav-mobile__back
    border none !important
    color #d4af87 !important

    svg path,
    svg rect,
    svg circle
      fill #d4af87 !important

  #menu-offcanvas .nav-mobile__header .nav-mobile__header-icon
    color #d4af87 !important

  #menu-offcanvas .nav-mobile__open
    right 0 !important
    width 56px !important
    justify-content flex-end !important
    padding-right 14px !important

    svg path,
    svg rect,
    svg circle
      fill #d4af87 !important

  #menu-offcanvas .nav-mobile__header,
  #menu-offcanvas .nav-mobile__others,
  #menu-offcanvas .nav-mobile__dropdown--nv1,
  #menu-offcanvas .nav-mobile__dropdown--nv2,
  #menu-offcanvas .nav-mobile__item--nv1,
  #menu-offcanvas .nav-mobile__item--nv2
    background #141111 !important

  #menu-offcanvas .nav-mobile__item--nv1
    padding-right 56px

  #menu-offcanvas .nav-mobile__link,
  #menu-offcanvas .nav-mobile__others ul li:not(.nav-mobile__others-item--launches):not(.nav-mobile__others-item--consumer):not(.nav-mobile__others-item--chance):not(.nav-mobile__others-item--cupons):not(.nav-mobile__others-item--specialist):not(.nav-mobile__others-item--store-offers) a
    color #e5e5e5 !important

  #menu-offcanvas .nav-mobile__others ul
    padding 0 8px

  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--launches,
  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--consumer,
  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--chance,
  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--cupons,
  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--specialist,
  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--store-offers
    height auto
    min-height 34px
    padding 6px 10px
    padding-left 10px
    border 1px solid #d8d8d8
    border-radius 8px
    background-color #f7f7f7
    overflow hidden
    margin-bottom 6px

  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--launches a,
  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--consumer a,
  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--chance a,
  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--cupons a,
  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--specialist a,
  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--store-offers a
    display flex
    align-items center
    gap 6px
    height auto
    padding 0
    line-height 1.2
    color #392f2d

  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--launches a strong,
  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--consumer a strong,
  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--chance a strong,
  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--cupons a strong,
  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--store-offers a strong
    color #392f2d
    font-weight 600

  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--cupons
    border-color #E30613
    background-color #FDEDEE

  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--cupons a,
  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--cupons a strong
    color #E30613

  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--cupons .nav-mobile__others-icon--cupons
    display inline-flex
    align-items center
    justify-content center
    margin-left auto
    width 18px
    height 18px
    flex-shrink 0
    color #E30613
    font-size 18px
    line-height 1

  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--specialist
    border-color #25d366
    background-color #25d3661a

  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--specialist a,
  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--specialist a strong
    color #00ad14
    font-weight 500

  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--specialist .nav-mobile__others-icon
    display inline-flex
    align-items center
    justify-content center
    margin-left auto
    width 15px
    height 15px
    flex-shrink 0

  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--specialist .nav-mobile__others-icon svg
    width 15px
    height 15px

  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--specialist .nav-mobile__others-icon svg path
    fill #25d366

  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--store-offers .nav-mobile__others-icon
    display inline-flex
    align-items center
    justify-content center
    margin-left auto
    flex-shrink 0

  #menu-offcanvas .nav-mobile__others .nav-mobile__others-item--store-offers .nav-mobile__others-icon img
    display block
    width 15px
    height 15px
    object-fit contain

  #menu-offcanvas .ah-offcanvas-bar .ah-close
    position absolute
    right -42px
    top 5px
    width 24px
    height 24px
