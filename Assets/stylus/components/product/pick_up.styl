.pick-up
  .state
    display flex
    align-items center
    &__header
      margin-right 20px
      color #392F2D
      font-size 12px
      font-weight bold
    &__select
      appearance: none
      width 225px
      height 35px
      border 1px solid #D5D5D5
      border-radius 0
      padding 0 10px
      font-size 12px
      font-weight 500
      color #B4B4B4
      background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAFCAYAAAB4ka1VAAAABHNCSVQICAgIfAhkiAAAAG9JREFUCFtjjImJecDAwJCwZMmSA0AaDmJjYxOAnABGEOP///8T/v3757Bs2bILIBXIYowgAaApDUDKn4WFxfHXr18KzMzM+4GaAkGmghVAFS0A0vqMjIwKQLpw8eLFID4DXAFUEciKC0CdIPvBAAB98DALc2GrVAAAAABJRU5ErkJggg==')
      background-repeat no-repeat
      background-position right 10px center
      margin-right 10px
    &__button
      cursor pointer
      width 110px
      height 35px
      display flex
      align-items center
      justify-content center
      background #392F2D
      color #fff
      font-size 12px
      font-weight bold
      transition $transition
      &:hover
        background $primary
  .stores
    margin-top 40px
    display none
    &__header
      display flex
      align-items center
      gap 10px
      width 100%
      padding-bottom 7px
      border-bottom 1px solid #D5D5D5
      font-weight bold
      color #5D5D5D
    &__list
      max-height 170px
      overflow auto
      padding-right 120px
      padding-top 7px
      &::-webkit-scrollbar
        width 6px
      &::-webkit-scrollbar-track
        background-color #EFEFEF
      &::-webkit-scrollbar-thumb
        background-color #392F2D
      .store
        font-size 12px
        &:not(:last-child)
          margin-bottom 12px
          padding-bottom 12px
          border-bottom 1px solid #D5D5D5
        &__name
          font-weight bold
          margin-bottom 7px
        &__adress
          margin-bottom 7px
