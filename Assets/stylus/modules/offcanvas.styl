$offcanvas-button-size = 55px
$offcanvas-width = 475px
$offcanvas-width-mobile = 320px

.ah-offcanvas-container
  overflow hidden

  @media desktop
    padding-right 5px

.ah-offcanvas
  position fixed
  top 0
  bottom 0
  left 0
  z-index 1000
  display none
  width 100vw

  &::before
    position absolute
    top 0
    right 0
    bottom 0
    left 0
    background rgba(0, 0, 0, 0.3)
    content ''
    opacity 0
    transition opacity 0.15s linear

.ah-offcanvas-bar
  position absolute
  top 0
  left "calc(-1 * (%s + %s))" % ($offcanvas-width $offcanvas-button-size)
  bottom 0
  box-sizing border-box
  width $offcanvas-width
  background #fff
  transition left 0.3s ease-out
  // -webkit-overflow-scrolling touch
  @media mobile
    width $offcanvas-width-mobile
    left "calc(-1 * (%s + %s))" % ($offcanvas-width-mobile $offcanvas-button-size)

  .ah-close
    position absolute
    top 0
    left 100%
    width $offcanvas-button-size
    height $offcanvas-button-size
    background $primary
    cursor pointer

    svg
      pointer-events none

  .ah-right &
    transition-property right
    left unset !important
    right "calc(-1 * (%s + %s))" % ($offcanvas-width $offcanvas-button-size)

    .ah-close
      right 100%
      left unset

.ah-offcanvas-open
  &::before
    opacity 1
    cursor pointer

  .ah-offcanvas-bar
    left 0

    .ah-right&
      right 0

.ah-offcanvas-close
  svg
    pointer-events none