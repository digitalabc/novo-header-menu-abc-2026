$offcanvas-button-size = 55px
$offcanvas-width = 475px
$offcanvas-width-mobile = 320px

.ah-offcanvas-container
  overflow hidden

  @media desktop
    padding-right 5px

  .home-info-bar
  .abc-newsletter-widget
    z-index 1 !important
    pointer-events none

.ah-offcanvas
  position fixed
  top 0
  bottom 0
  left 0
  z-index 1000
  display none
  width 100vw
  height 100vh
  height 100dvh
  overflow hidden
  background transparent

  &::before
    position absolute
    top 0
    right 0
    bottom 0
    left 0
    background rgba(0, 0, 0, 0.3)
    content ''
    opacity 0
    transition opacity 0.15s linear
    pointer-events auto
    z-index 1

.ah-offcanvas-bar
  position absolute
  top 0
  left 0
  transform "translateX(calc(-100% - %s))" % $offcanvas-button-size
  bottom 0
  box-sizing border-box
  z-index 2
  width $offcanvas-width
  max-height 100vh
  max-height 100dvh
  overflow-y auto
  overscroll-behavior contain
  -webkit-overflow-scrolling touch
  background #fff
  transition transform 0.25s cubic-bezier(0.4, 0, 0.2, 1)
  will-change transform
  @media mobile
    width $offcanvas-width-mobile

  .ah-close
    position absolute
    top 0
    left 100%
    z-index 3
    width $offcanvas-button-size
    height $offcanvas-button-size
    background $primary
    cursor pointer

    svg
      pointer-events none

  .ah-right &
    transition-property transform
    left unset !important
    right 0
    transform "translateX(calc(100% + %s))" % $offcanvas-button-size

    .ah-close
      right 100%
      left unset

.ah-offcanvas-open
  &::before
    opacity 1
    cursor pointer

  .ah-offcanvas-bar
    transform translateX(0)

    .ah-right&
      transform translateX(0)

.ah-offcanvas-close
  svg
    pointer-events none
