.filter
  @media desktop
    flex: 0 0 220px;

  @media mobile
    position: fixed;
    top: 0;
    left: -100%;
    z-index: 999;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    transition: $transition;
    isolation: isolate;

    &:before
      position: absolute;
      top: 0;
      left: 0;
      z-index: 9;
      z-index: -1;
      display: block;
      visibility: hidden;
      width: 100%;
      height: 100%;
      background: rgba(#000000, 30%);
      content: "";
      opacity: 0;
      transition: $transition;

    .on-filter &
      left: 0;

      &:before
        visibility: visible;
        opacity: 1;

  &__button
    display: flex;
    justify-content: center;
    align-items: center;
    background: none;
    color: #5D5D5D;
    font-weight: 500;
    font-size: 16px;
    gap: 10px;

    @media mobile
      flex-shrink: 0;
      width: 165px;
      height: 40px;
      background: $black;
      color: #fff;
      cursor: pointer;

    svg
      fill: $primary;

      @media mobile
        fill: #ffffff;

  &__top
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 320px;
    height: 55px;
    padding: 0 14px 0 18px;
    background: #392F2D;

    .filter__top-title
      margin: 0
      color: #fff
      text-transform: uppercase
      font-weight: 700
      font-size: 18px
      line-height: 1

    @media desktop
      display: none;

  &__close
    display: flex;
    justify-content: center;
    align-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(#ffffff, .14);
    border-radius: 50%;
    background: rgba(#ffffff, .08);
    cursor: pointer;
    transition: $transition;

    &:hover
      background: rgba(#ffffff, .16)
      transform: translateY(-1px)

    svg
      pointer-events: none;

  &__list
    @media mobile
      flex: 1;
      overflow: auto;
      padding: 20px 15px;
      max-height: 100vh;
      max-height: 100dvh;
      width: 320px;
      background: #fff;
      box-shadow: 12px 0 34px rgba(#000000, .14);

  &__item
    &:not(:last-child)
      margin-bottom: 20px;
      padding-bottom: 20px;
      border-bottom: 1px solid #D5D5D5;

    &--price
      .filter__price-title
        margin: 0 0 4px
        color: $black
        font-size: 20px
        font-weight: 900
        line-height: 22px
        cursor: default

      .price-filter__subtitle
        margin: 0 0 16px
        color: #666666
        font-size: 11px
        font-weight: 400
        line-height: 14px

      .price-filter
        display: flex
        flex-direction: column

      .price-filter__fields
        display: grid
        grid-template-columns: repeat(2, minmax(0, 1fr))
        gap: 20px
        margin-top: 0
        padding-bottom: 0

      .price-filter__field
        display: flex
        flex-direction: column
        gap: 8px
        color: $black
        font-size: 12px
        font-weight: 600
        line-height: 16px

      .price-filter__field-head
        display: flex
        justify-content: space-between
        align-items: center
        gap: 8px
        min-height: 20px

      .price-filter__label
        display: block
        color: $black
        font-size: 11px
        font-weight: 700
        line-height: 14px
        letter-spacing: .02em

      .price-filter__control
        position: relative
        display: flex
        align-items: center
        width: 100%
        min-height: 38px

      .price-filter__input
        width: 100%
        height: 38px
        padding: 0 12px 0 36px
        border: 1px solid #EAEAEA
        border-radius: 12px
        background: #fff
        text-align: right
        font-size: 12px
        font-weight: 600
        line-height: 16px
        font-variant-numeric: tabular-nums

        &:focus
          border-color: $primary

      .price-filter__currency
        position: absolute
        left: 12px
        z-index: 1
        color: #5D5D5D
        font-size: 12px
        font-weight: 600
        pointer-events: none

      .price-filter__stepper
        display: flex
        align-items: center
        gap: 4px
        flex-shrink: 0

      .price-filter__step
        display: flex
        justify-content: center
        align-items: center
        width: 20px
        height: 20px
        padding: 0
        border: 1px solid #EAEAEA
        border-radius: 6px
        background: #F7F7F7
        color: $black
        font-size: 11px
        font-family: inherit
        line-height: 1
        appearance: none
        cursor: pointer
        transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease

        &:hover
          background: rgba($primary, .08)
          border-color: rgba($primary, .35)
          color: $primary

        &:active
          transform: translateY(1px)

      .price-filter__button
        grid-column: 1 / -1
        width: 100%
        height: 36px
        border: none
        border-radius: 12px
        background-color: $primary
        color: #fff
        font-weight: 700
        font-size: 14px
        transition: background-color 0.2s ease, transform 0.2s ease

        &:hover
          background-color: #F0444E

        &:active
          transform: translateY(1px)

    &.open
      .filter
        &__options
          margin-top: 15px;

        &__title
          svg
            transform: rotateX(180deg);

      .show-more
        margin-top: 15px;
        max-height: 16px;

  &__title
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: $black;
    font-weight: 500;
    cursor: pointer;

    svg
      transition: $transition;

    @media mobile
      margin: 0;

  &__options
    overflow: hidden;
    height: 0;
    transition: $transition;

    &.collapsed
      overflow: hidden;
      max-height: 140px;
      transition: $transition;

    .option
      display: flex;
      gap: 5px;

      &:not(:last-child)
        margin-bottom: 15px;

      &__checkbox
        display: none;

        &:checked
          +.fake-checkbox
            border: 1px solid $primary;

            svg
              opacity: 1;

      .fake-checkbox
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 16px;
        height: 16px;
        border: 1px solid #5D5D5D;
        cursor: pointer;
        transition: $transition;

        svg
          opacity: 0;
          transition: $transition;

      &__label
        color: #000000;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 400;
        font-size: 12px;
        line-height: 16px;
        cursor: pointer;
        cursor: pointer;

  .color-filter
    position: relative;
    display: flex;
    align-items: center;
    gap: 3px;

    @media mobile
      gap: 8px;

    &.selected
      img
        border: 1px solid $primary;

    img
      position: absolute;
      top: 50%;
      left: 0;
      transform: translateY(-50%);
      pointer-events: none;

    input
      border: none;

    label
      color: #000;
      letter-spacing: 0.05em;
      font-weight: 400;
      font-size: 12px;
      line-height: 16px;

  .show-more
    display: block;
    overflow: hidden;
    max-height: 0;
    background: none;
    color: $primary;
    text-decoration: underline;
    font-size: 13px;
    cursor: pointer;
    transition: color 0.2s ease-in-out, max-height 0.2s ease-in-out, margin 0.2s ease-in-out;

    &.ver-menos
      font-size: 0;

      &:after
        content: "Ver menos";
        font-size: 13px;

.relative
  position: relative;

.mt-4
  margin-top: 1rem;

.h-3
  height: 0.75rem;

#price-selection-fields>input::-webkit-outer-spin-button, #price-selection-fields>input::-webkit-inner-spin-button
  margin: 0;
  -webkit-appearance: none;

#price-selection-fields>input[type=number]
  -moz-appearance: textfield;

#price-selection-fields
  position: relative;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin-top: 8px;
  padding-bottom: 0;

  #minimum-price-filter, #maximum-price-filter
    width: 100%;
    height: 40px;
    border: 1px solid #EAEAEA;
    border-radius: 12px;
    text-align: center;
    font-weight: 600;
    background: #fff;

    &:focus
      border-color: $primary;

  #apply-price-filter
    grid-column: 1 / -1;
    width: 100%;
    height: 40px;
    border: none;
    border-radius: 12px;
    background-color: $primary;
    color: #fff;
    font-weight: 600;

  > span
    grid-column: 1 / -1;
    font-size: 10px;
    color: #5D5D5D;
