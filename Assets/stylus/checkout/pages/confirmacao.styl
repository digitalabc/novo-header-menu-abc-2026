.fbits-confirmacao
  padding: 0 !important;
  max-width: 100% !important;

  .box-pedido-numero+.box-pedido-numero
    position: static;

  section.confirmacao-box
    width: 100%;

  .container
    margin: 0 auto;
    max-width: 1300px;

  section.confirmacao-buttons
    @media desktop
      display: flex;
      justify-content: space-between;

    >*
      float: none !important;

      @media mobile
        display: block;
        margin: 0 auto 10px;
        max-width: 400px;

    a
      @extend $default-button;
      text-transform: none;

.fbits-gateway-status-reprovado
  @media mobile
    div
      width: 90%;

      >h3
        >svg
          top: 10px;
          right: 10px;

h2.title-confirmacao
  margin-top: 20px;