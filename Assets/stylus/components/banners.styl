// Home - Fullbanner
.fullbanner
  @media mobile
    padding-bottom 30px !important

// Home - Banner Oportunidades
.banner-oportunidades
  .swiper:not(.swiper-initialized)
    @media mobile
      ul
        gap 10px
        li
          flex 0 0 calc((100%/2.6) - 5px)
  ul
    display flex
    @media desktop
      gap 20px
    li
      overflow: hidden;
      position relative
      &:after
        content ''
        display block
        position absolute
        inset 0
        background #FFFFFF
        opacity 0
        pointer-events none
        transition $transition

      &:nth-child(n + 5)
        display none

      &:hover
        &:after
          opacity 0.2

      img
        transition: $transition;
        display block

// Home - Grid de banners
.banner-grid
  > div
    &:first-child
      margin-bottom 20px
  ul
    li
      overflow: hidden;
      position relative
      &:after
        content ''
        display block
        position absolute
        inset 0
        background #FFFFFF
        opacity 0
        pointer-events none
        transition $transition

      &:nth-child(n + 5)
        display none

      &:hover
        &:after
          opacity 0.2

      img
        display block

// Home - Banners lateral
.banner-centro
  ul
    li
      overflow: hidden;
      position relative
      &:after
        content ''
        display block
        position absolute
        inset 0
        background #FFFFFF
        opacity 0
        pointer-events none
        transition $transition

      &:nth-child(n + 4)
        display none

      &:hover
        &:after
          opacity 0.2

      img
        transition: $transition;
        display block

// Home - Banner Instagram
.banner-instagram
  ul
    display flex
    gap 20px
    li
      overflow: hidden;
      &:nth-child(n + 6)
        display none
        
      a
        position relative
        display block
        &:after
          content ''
          display block
          background-color rgba(#392F2D, 0.45)
          background-image: url("data:image/png;base64,");
          background-position: center;
          background-repeat: no-repeat;
          position absolute
          inset 0
          opacity 0
          transition $transition

        &:hover 
          &:after
            opacity 1

      img
        transition: $transition;
        display block
