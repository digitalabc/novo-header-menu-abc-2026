.buy_list
  &__product
    &-wrap
      display: flex;
      margin-bottom: 20px;
      padding-bottom 25px
      border-bottom 1px solid #d5d5d5

  &__wrapper
    display: flex;
    align-items center
    gap: 20px;

    @media mobile
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;

    .best-installment
      display: none;

  &__block
    display: flex;
    flex-direction: column;
    width: calc(100% - 90px);

  &__name
    display: flex;
    align-items: center;
    margin-bottom: 30px;
    gap: 5px;

    @media mobile
      margin-bottom: 20px;

    input
      display none
      &:checked
        +.fake-input
          &:before
            opacity 1

    .fake-input
      flex-shrink 0
      width: 16px;
      height: 16px;
      border: 1px solid $primary;
      cursor: pointer;
      position relative
      transition: $transition;
      &:before
        content ''
        position absolute
        inset 0
        background-position center
        background-repeat no-repeat
        background-image url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAYAAAAGCAMAAADXEh96AAAAD1BMVEUAAADkBRPiBRLiBRLjBhMFDkERAAAABHRSTlMAYO/wnx+whQAAAB9JREFUeNpjYGZkYGBkYmBkYQQiBiANJKEUVBCihBkABPIAPKjQyb8AAAAASUVORK5CYII=")
        opacity 0
        transition: $transition;

    a
      h5
        color: #010101;
        font-weight: 700;
        font-size: 18px;
        line-height: 24px;
        transition: $transition;
        &:hover
          color $primary

        @media mobile
          font-size: 14px;

  &__image
    margin: 0 20px 0 0;

    img
      max-width: 90px;
      object-fit: cover;

  &__attributes
    margin-bottom 15px

    .attribute-selections
      margin-bottom 0
      padding-bottom 0
      border-bottom none
      


  &__quantity
    
    .warning
      position: absolute;
      top: 50%;
      left: 100%;
      margin-left: 10px;
      color: #f00;
      white-space: nowrap;
      font-weight: 500;
      font-size: 14px;
      transform: translateY(-50%);

    .quantity
      position: relative;
      overflow: hidden;
      width: 125px;
      height: 30px;
      border: 1px solid #D5D5D5

      input
        width: 100%;
        height: 100%;
        color: #5D5D5D
        text-align: center;
        font-weight: 700;
        font-style: normal;
        font-size: 14px;
        -moz-appearance: textfield;
        &::-webkit-outer-spin-button,
        &::-webkit-inner-spin-button
          -webkit-appearance: none;
          margin: 0;

      > button
        position: absolute;
        top: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 30px;
        height: 30px;
        background: #D5D5D5
        color: #392F2D
        font-weight: 700;
        font-size: 14px;
        cursor: pointer;
        transform: translateY(-50%);
        transition: $transition;
        &:hover
          background $primary
          color #fff

      &-less
        left: 0;
        border-right 1px solid #D5D5D5

      &-more
        right: 0;
        border-left 1px solid #D5D5D5


  &__price
    > span
      color: #010101;
      font-weight: 500;
      font-size: 14px;

    .spot-price
      h3, s
        white-space: nowrap;

      small
        display: none;

  .buy-button
    display none

  .add-to-cart-button
    display: flex;
    justify-content: center;
    align-items: center;
    height: 40px;
    background: #0FA848
    cursor: pointer;
    transition: $transition;
    color: #fff
    font-weight: 700;
    font-size: 14px;
    width 100%
    @media (max-width 449px)
      margin-bottom 10px
    @media (min-width 450px)
      width: 245px;

    &[disabled]
      background: #B4B4B4;
      cursor: not-allowed;

    &:not([disabled]):hover
      background: $primary;

    &:not([disabled]).hollow
      background #fff
      border 1px solid #0FA848
      color #0FA848
      &:hover
        background: #0FA848
        color #fff