.product-shipping
  &__invalid
    position: fixed;
    top: 50%;
    left: 50%;
    z-index: 9999;
    visibility: hidden;
    width: 100%;
    height: 100%;
    background-color: rgba(#B8B8B8, 0.3);
    opacity: 0;
    transition: $transition;
    transform: translate(-50%, -50%);

    &.visible
      visibility: visible;
      opacity: 1;

  &__modal
    position: absolute;
    top: 50%;
    left: 50%;
    padding: 32px;
    border-radius: 1.6rem;
    background: #FFF;
    box-shadow: 0 0 2px 0 #000, 0 6.02px 6.02px 0 rgba(0, 0, 0, 0.25);
    transform: translate(-50%, -50%);

    > button
      position: absolute;
      top: 20px;
      right: 20px;
      display: flex;
      background: none;
      cursor: pointer;

      svg
        pointer-events: none;

    h3
      margin-bottom: 16px;
      color: $black;
      font-weight: 700;
      font-size: 24px;

      @media mobile
        max-width: 200px;
        text-align: center;
        margin-inline: auto;

    p
      margin-bottom: 16px;
      min-width: 250px;
      max-width: 395px;
      color: $black;
      font-size: 14px;

      strong
        color: $primary;
        font-weight: 600;

    > div
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 22px;

  &__button
    padding: 12px 8px;
    border-radius: 4px;
    font-weight: 700;
    font-size: 12px;

    &--deny
      border: 1px solid $primary;
      background: none;
      color: $primary;

    &--accept
      border: 1px solid $black;
      background-color: $black;
      color: #ffffff;