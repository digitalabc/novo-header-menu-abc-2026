.filter
  @media desktop
    flex 0 0 220px

  @media mobile
    display flex
    flex-direction column
    position fixed
    top 0
    left -100%
    z-index 999
    width 100%
    height 100%
    transition $transition
    isolation isolate

    &:before
      position absolute
      top 0
      left 0
      z-index 9
      display block
      visibility hidden
      width 100%
      height 100%
      background rgba(#000000, 30%)
      content ''
      opacity 0
      transition $transition
      z-index -1

    .on-filter &
      left 0

      &:before
        opacity 1
        visibility visible

  &__button
    display flex
    justify-content center
    align-items center
    background none
    color #5D5D5D
    font-weight 500
    font-size 16px
    gap 10px

    @media mobile
      width 165px
      height 40px
      background $black
      color #fff
      cursor pointer
      flex-shrink 0

    svg
      fill $primary

      @media mobile
        fill #ffffff

  &__top
    display flex
    justify-content center
    align-items center
    background #392F2D
    width 320px
    position relative
    h4
      line-height 55px 
      color #fff
      font-weight bold

    @media desktop
      display none

  &__close
    position absolute
    right -55px
    display flex
    justify-content center
    align-items center
    width 55px
    height 55px
    background $primary
    cursor pointer

    svg
      pointer-events none

  &__list
    @media mobile
      background #fff
      width 320px
      flex 1
      padding 20px 15px
      overflow auto
      max-height 100vh
      max-height 100dvh

  &__item
    &:not(:last-child)
      margin-bottom 20px
      padding-bottom 20px
      border-bottom 1px solid #D5D5D5

    &.open
      .filter
        &__options
          margin-top 15px

        &__title
          svg
            transform rotateX(180deg)

      .show-more
        margin-top 15px
        max-height 16px

  &__title
    display flex
    justify-content space-between
    align-items center
    color $black
    font-weight 500
    cursor pointer

    svg
      transition $transition

    @media mobile
      margin 0
      

  &__options
    overflow hidden
    height 0
    transition $transition

    &.collapsed
      overflow hidden
      max-height 140px
      transition $transition

    .option
      display flex
      align-items center
      gap 3px

      &:not(:last-child)
        margin-bottom 15px

      &__checkbox
        display none

        &:checked,
        &:hover
          +.fake-checkbox
            border 1px solid $primary

            &:before
              opacity 1

      .fake-checkbox
        position relative
        width 16px
        height 16px
        border 1px solid #5D5D5D
        cursor pointer
        transition $transition

        &:before
          position absolute
          background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAYAAAAGCAMAAADXEh96AAAAD1BMVEUAAADkBRPiBRLiBRLjBhMFDkERAAAABHRSTlMAYO/wnx+whQAAAB9JREFUeNpjYGZkYGBkYmBkYQQiBiANJKEUVBCihBkABPIAPKjQyb8AAAAASUVORK5CYII=')
          background-position center
          background-repeat no-repeat
          content ''
          opacity 0
          transition $transition
          inset 0

      &__label
        color #000000
        text-transform uppercase
        letter-spacing 0.05em
        font-weight 400
        font-size 12px
        line-height 16px
        cursor pointer
        cursor pointer

  .color-filter
    position relative
    display flex
    align-items center
    gap 3px

    @media mobile
      gap 8px

    &.selected
      img
        border 1px solid $primary

    img
      position absolute
      top 50%
      left 0
      transform translateY(-50%)
      pointer-events none

    input
      border none

    label
      color #000
      letter-spacing 0.05em
      font-weight 400
      font-size 12px
      line-height 16px

  .show-more
    display block
    overflow hidden
    max-height 0
    background none
    color $primary
    text-decoration underline
    font-size 13px
    cursor pointer
    transition color 0.2s ease-in-out, max-height 0.2s ease-in-out, margin 0.2s ease-in-out

    &.ver-menos
      font-size 0

      &:after
        content 'Ver menos'
        font-size 13px

  #price-range
    display none
    .filter__title
      margin-bottom 15px

    .range-values
      margin-bottom 10px
      display flex
      align-items center
      justify-content space-between
      font-weight 500
      
    .range-slider
      display flex
      #maximum-price-filter
        position relative
        width 220px
        height 7px
        border none
        -webkit-appearance none
        &::-webkit-slider-thumb
          width 14px
          height 14px
          border-radius 50%
          background $primary
          -webkit-appearance none
        &::-moz-range-thumb
          border none
          width 14px
          height 14px
          border-radius 50%
          background $primary
