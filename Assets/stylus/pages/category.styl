.hotsite
.category
.search
  h1
    font-size 20px
    font-weight bold
    margin-bottom 25px

  h2
    font-size 20px
    font-weight 500
    margin-bottom 20px

  .banner
    margin-bottom: 55px;

  .showcase
    margin-bottom: 55px;
    &__banner
      @media mobile
        ul
          margin-bottom 20px
      @media desktop
        display flex
        gap 20px
        >*
          width calc(50% - 10px)
        .swiper
          max-width 555px
          margin-right 20px
          margin-left auto
        .swiper-button-prev
          left 0

  .gray-bg
    padding-top 35px
    padding-bottom 35px
    background #F5F5F5
    margin-bottom 55px

  .category
    &__toolbar
      display flex
      justify-content space-between
      align-items center
      padding-bottom 10px
      margin-bottom 30px
      border-bottom 1px solid #D5D5D5

    &__main
      @media desktop
        display flex
        gap 45px
    
  .seo
    border 1px solid #D5D5D5
    margin-bottom 55px
    padding 20px 25px
    &.expand
      .seo
        &__text
          max-height unset
        &__button
          font-size 0
          gap 3.5px
          &:before
            content 'Ver menos'
            font-size 20px
          svg
            transform rotate(180deg)
    &__text
      overflow hidden
      max-height 54px
      p
        margin-bottom 10px
    &__button
      cursor pointer
      display flex
      align-items center
      gap 7px
      color #0FA848
      font-size 20px
      font-weight bold
      background none
      margin-top 25px

  .spots
    display: grid;
    margin-bottom: 70px;
    grid-template-columns: repeat(4, calc(25% - (3*20px)/4));
    gap: 70px 20px;
    justify-items: center;
    .spot
      width 100%

    @media (max-width: 1300px)
      grid-template-columns: repeat(3, calc((100%/3) - (2*20px)/3));

    @media mobile
      grid-template-columns: repeat(2, calc(50% - 5px));
      gap: 60px 10px;

.empty-search
  padding 60px 0
  strong
    display block
    margin-bottom: 12px;
    text-align: center;
    font-weight: 700;
    font-size: 25px;
    line-height: 30px;

  p
    color #676767
    text-align: center;
    font-size: 15px;
    a
      color #00CC00
      font-weight bold
      text-decoration underline
      transition $transition
      &:hover
        color $primary