.swiper
  &:not(.swiper-initialized)
    .swiper-button, ~.swiper-button
      &-prev, &-next
        display: none;

  &-container
    position: relative;

    @media (max-width: 1330px)
      padding: 0 40px;

  &-wrapper
    margin: 0;
    padding: 0;

  &-button
    &-prev, &-next
      z-index: 1;
      margin: 0;
      width: 30px;
      height: 30px;
      background-color: unset;
      color: #5D5D5D;
      transition: $transition;
      transform: translateY(-50%);

      &:hover
        color: $primary;

      &:after
        content: none;

      &.swiper-button-disabled
        pointer-events: all;

        &:hover
          color: inherit;

    &-prev
      @media desktop
        left: -50px;

      @media (max-width: 1330px)
        left: 0;

    &-next
      @media desktop
        right: -50px;

      @media (max-width: 1330px)
        right: 0;