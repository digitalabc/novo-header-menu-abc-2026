                                    small
                                        font-family: "Montserrat", sans-serif;
                                        font-size: 13.893px;
                                        font-style: normal;
                                        line-height: 112%;
                                    
                                .precoDe
                                    display: none
                                    color: #4F4F4F;
                                    font-family: "Montserrat", sans-serif;
                                    font-size: 11px;
                                    font-style: normal;
                                    font-weight: 400;
                                    line-height: 130%; 
                                    margin-bottom 8px

                                .desconto_prime
                                    width: 100%
                                    display flex
                                    justify-content: center
                                    align-items: center
                                    border-radius: 3.6px;
                                    background: linear-gradient(85.64deg, #247067 18.39%, #38B0A1 136.66%);
                                    padding: 13px
                                    color: #FFF;
                                    font-family: "Montserrat", sans-serif;
                                    font-size: 15px;
                                    font-style: normal;
                                    font-weight: 800;
                                    line-height: 19px;
