.product-shipping
  &__invalid
    position: fixed;
    top: 50%;
    left: 50%;
    z-index: 9999;
    visibility: hidden;
    width: 100%;
    height: 100%;
    background-color: rgba(#000000, 0.3);
    opacity: 0;
    transition: $transition;
    transform: translate(-50%, -50%);

    &.visible
      visibility: visible;
      opacity: 1;

  &__modal
    position: absolute;
    top: 50%;
    left: 50%;
    padding: 20px 40px;
    border-radius: 6px;
    background-color: #ffffff;
    box-shadow: 0 3px 6px 0 rgba(#000000, 0.16);
    text-align: center;
    transform: translate(-50%, -50%);

    > button
      position: absolute;
      top: 20px;
      right: 20px;
      display: flex;
      background: none;
      cursor: pointer;

    h3
      margin-bottom: 12px;
      color: $black;
      font-size: 28px;

    p
      margin-bottom: 12px;
      max-width: 275px;
      color: $black;
      font-size: 16px;
      line-height: 140%;

      strong
        color: $primary;

    > div
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 12px;

  &__button
    padding: 12px 6px;
    border-radius: 3px;
    font-weight: 500;
    font-size: 14px;

    &--deny
      border: 1px solid $primary;
      background: none;
      color: $primary;

    &--accept
      border: 1px solid $black;
      background-color: $black;
      color: #ffffff;