.hotsite.vr-category
  .vr_showcase
    margin-bottom: 28px;

    @media mobile
      margin-right: -15px;

      .swiper-button-next, .swiper-button-prev
        display: none;

  .stamps-vr
    position: absolute;
    top: 50px;
    right: 10px;
    z-index: 1;

    &--no_discount
      top: 10px;

  .vr-banners
    padding: 0;

    > ul
      margin-bottom: 16px;

    ul
      a
        display: flex;

    > div
      display: flex;
      align-items: center;
      gap: 16px;

      ul
        width: calc(50% - 8px);

        img
          width: 100%;