.showcase
  .swiper
    margin: -10px;
    padding: 10px;

    @media mobile
      margin: -10px -15px;
      padding: 10px 15px;

    &:not(.swiper-initialized)
      ul
        gap: 5px;

        @media desktop
          gap: 20px;

        li
          flex: 0 0 calc((100% / 2.1) - (2 * 5px / 5));

          @media (min-width: 768px)
            flex: 0 0 calc((100% / 3.1) - (3 * 5px / 5));

          @media (min-width: 768px)
            flex: 0 0 calc((100% / 4) - (3 * 20px / 5));

          @media (min-width: 768px)
            flex: 0 0 calc((100% / 5) - (4 * 20px / 5));

    &-container
      position: relative;

.swiper.swiper-initialized.swiper-horizontal
  .spot
    border-radius: 16px;

.spot
  border: 1px solid #EAEAEA;
  font-family var(--font-brand)
  transition: $transition;
  overflow hidden
  border-radius 16px

  @media desktop
    &:hover
      box-shadow: $bs;

      .add-to-cart-button
        opacity: 1;

      .spot
        &__overlay
          visibility: visible;
          opacity: 1;

        &__unavailable
          visibility: visible;
          opacity: 1;

  &__image
    position: relative;
    overflow: hidden;

    img
      width: 100%;

    &-wrapper
      position: relative;
      margin: 0 auto;
      width 100%
      max-width: 200px;
      aspect-ratio 1 / 1
      overflow hidden
      border-bottom: 1px solid #EAEAEA;

      a
        display block
        width 100%
        height 100%

      img
        width 100%
        height 100%
        object-fit cover
        object-position center

    .stamps-discount
      position: absolute;
      top: 10px;
      right: 10px;
      z-index: 10;
      display: flex;
      justify-content: center;
      align-items: center;
      width: 35px;
      height: 35px;
      border-radius: 50%;
      background: #392F2D;
      color: #ffffff;
      font-weight var(--peso-fonte-semibold)
      font-size: 12px;

  &__buttons
    >*:not(.add-to-cart-button)
      display: none !important;

    .add-to-cart-button
      display: flex;
      justify-content: center;
      align-items: center;
      margin-top: 15px;
      width: 100%;
      height: 40px;
      background: $buy-btn;
      color: #fff;
      font-weight: 500;
      cursor: pointer;
      gap: 6px;

      @media mobile
        border-radius: 8px;

      @media desktop
        position: absolute;
        bottom: 0;
        left: 0;
        opacity: 0;
        transition: $transition;

        &:hover
          background: $black;

  &__overlay
    position: absolute;
    top: 0;
    left: 0;
    visibility: hidden;
    width: 100%;
    opacity: 0;
    transition: $transition;

  &__content
    padding: 20px 10px;
    background: #fff;

  &__title
    h3
      display: -webkit-box;
      overflow: hidden;
      margin-bottom: 20px;
      height: 60px;
      color: $black;
      text-overflow: ellipsis;
      font-weight: $peso-fonte-medium;
      font-size: $fonte-paragrafo;
      line-height: 20px;
      transition: $transition;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;

      @media mobile
        margin-bottom: 15px;
        height: 57px;
        font-size: $fonte-paragrafo;
        line-height: 19px;

      &:hover
        color: $primary;

  &__unavailable
    @media desktop
      visibility: hidden;
      opacity: 0;
      transition: $transition;

      &:focus-within
        visibility: visible;
        opacity: 1;

    p
      margin-bottom: 10px;
      font-size: $fonte-paragrafo;

    .bis
      @media mobile
        margin-bottom: 0;

      &__alert
        position: absolute;
        margin-top: 0;
        font-weight: 400;

      input
        flex: 1;
        width: 100%;

  &-price
    margin-bottom: 5px;

    @media mobile
      margin-bottom: 2px;

    .precoDe
      display: block;
      margin-bottom: 5px;
      color: #B4B4B4;
      font-weight: $peso-fonte-medium;
      font-size: $fonte-subtitulo;
      line-height: 18px;

      @media mobile
        margin-bottom: 3px;
        font-size: $fonte-paragrafo;
        line-height: 15px;

    .precoPor
      &:first-child
        padding-top: 23px;

        @media mobile
          padding-top: 18px;

      span
        color: $primary;
        font-weight: $peso-fonte-bold;
        font-size: $fonte-titulo-grande;
        line-height: 24px;

        @media mobile
          font-size: $fonte-titulo;
          line-height: 19px;

      small
        color: #000000;
        font-weight: $peso-fonte-regular;
        font-size: $fonte-paragrafo;

    .precoCalculado
      margin-top: 5px;
      color: #000;

      span
        font-weight: $peso-fonte-bold;
        font-size: $fonte-titulo-grande;
        line-height: 24px;

        @media mobile
          font-size: $fonte-titulo;
          line-height: 19px;

      small
        font-weight: $peso-fonte-regular;
        font-size: $fonte-paragrafo;

  .best-installment
    font-size: $fonte-paragrafo;
    line-height: 15px;

    @media mobile
      min-height: 30px;

    strong
      font-weight: $peso-fonte-regular;

    span
      @media mobile
        display: block;

  .spot-price
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 80px;

    .discount
      display: block;
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0;
      box-sizing: border-box;
      padding: 5px;
      margin-bottom: 8px;
      background-color: #e8f8f5 !important;
      border-radius: 8px;
      color: #20a389 !important;
      font-weight: $peso-fonte-regular !important;
      font-size: $fonte-paragrafo !important;
      text-align: center !important;
      white-space: nowrap;
      margin-top: 0 !important;

      .discount__value
        display: inline;
        font-weight: $peso-fonte-bold;

      @media mobile
        white-space: normal;

        .discount__value
          display: block;
