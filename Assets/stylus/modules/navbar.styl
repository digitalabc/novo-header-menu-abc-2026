.navbar
  @media desktop
    box-shadow $bs
  &__container
    @extends $container
    padding-block 15px
    @media mobile
      flex-wrap wrap
      padding-block 25px

  &__collapse
    display flex
    justify-content: flex-start;
    @extends $container
  &__logo
    @media mobile
      max-width 80px
  &__right, &__search
    @media desktop
      flex: 1;

  &__right
    justify-content: flex-end;
    gap 30px
    @media mobile
      gap 20px

  &__search
    @media mobile
      width 100%
      order 10
      margin-top 20px
      height 40px

  &__lojas
    font-weight 500
    display flex
    align-items center
    gap 5px
    color $black
    transition $transition
    @media mobile
      display none
    svg
      fill $primary
    &:hover
      color $primary


  &__wrapper
    width 100%
    display: flex;
    justify-content space-between
    margin: 0;
    padding: 0;

    @media desktop
      justify-content: space-between;
      align-items: center;

    .nav-item
      &--nv1
        display: flex;
        align-items: center;
        height: 40px;
        position relative

        &:nth-child(4)
          > .dropdown-menu
            left: 50%;
            transform translateX(-50%)
        &:nth-child(n + 5)
          > .dropdown-menu
            right: -60px;
            left: unset;
            
        > .dropdown-menu
          position: absolute;
          top: 100%;
          left: -60px;
          display: flex;
          gap 35px
          visibility: hidden;
          justify-content: space-between;
          background: #ffffff;
          opacity: 0;
          transition: $transition;
          padding: 30px 15px;
          width: max-content;
          box-shadow 0 1px 4px rgba(#000, 0.16)
          
          >ul
            display grid
            grid-template-columns repeat(3, 1fr)
            grid-gap 30px
          > .nav-item--sub
            > ul
              display none

            > .nav-link
              margin-bottom: 10px;
              color: #000000;
              text-transform: uppercase;
              font-weight: 700;

        > .nav-link
          color: #5D5D5D
          font-weight: 300;
          font-size: 14px;
          &.highlight
            color #392F2D
            font-weight 400

        @media desktop
          &:hover
            > .dropdown-menu
              visibility: visible;
              opacity: 1;

            > .nav-link
              color #000

      &--sub
        display: flex;
        flex-direction: column;
        > .dropdown-menu
          display none
        > a.nav-link
          color: #000000
          font-size: 14px;
          font-weight 500
          transition $transition
          &:hover
            color $primary

