
/* Dots */
.slick-dotted.slick-slider
  margin-bottom 30px

.slick-dots
  position absolute
  bottom -25px
  display block
  margin 0
  padding 0
  width 100%
  list-style none
  text-align center

.slick-dots li
  position relative
  display inline-block
  margin 0 5px
  padding 0
  width 20px
  height 20px
  cursor pointer

.slick-dots li button
  display block
  padding 0
  width 8px
  height 8px
  outline none
  border none
  border-radius 50%
  background transparent
  color transparent
  font-size 0
  line-height 0
  cursor pointer

.slick-dots li button:hover,
.slick-dots li button:focus
  outline none

.slick-dots li button:hover:before,
.slick-dots li button:focus:before
  opacity 1

.slick-dots li button:before
  display none

