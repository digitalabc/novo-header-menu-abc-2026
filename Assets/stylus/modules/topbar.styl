.topbar
  background #0D3547
  color #fff
  font-size var(--fonte-11)
  font-family var(--font-brand)

  &__container
    @extends $container
    @media mobile
      padding 0
    > ul
      @media desktop
        display flex
        justify-content space-between
        align-items center

    > ul > li
      height: 30px;
      display: flex;
      align-items: center;
      @media mobile
        justify-content center
      @media desktop
        width auto
    
      a
        display flex
        align-items center
        color #fff
        transition $transition
        &:hover
          color #D4AF37
        svg
          margin-right 5px
        &:not(.topbar__prime-logo)
          svg
            path
              fill currentColor
      
      strong
        font-weight var(--peso-fonte-semibold)
        color inherit

  &__left
  &__right
    @media desktop
      flex 1
  &__center
    @media desktop
      justify-content center

    &--info
      display none !important

      @media desktop
        justify-content center

  &__right
    gap 10px
    @media desktop
      justify-content flex-end
      gap 20px

  &__prime-logo
    svg
      margin-right 0

  &__info-rotator
    --home-info-bar-item-height: 30px;
    display block
    min-width 320px
    height var(--home-info-bar-item-height)
    overflow hidden

  &__info-track
    display block
    margin 0
    padding 0
    list-style none
    width 100%

  &__info-item
    position relative
    width 100%
    min-height 30px
    display flex
    align-items center
    justify-content center
    padding 0 12px
    overflow hidden

  &__info-content
    position relative
    z-index 1
    display inline-flex
    align-items center
    justify-content center
    align-self stretch
    min-height 100%
    padding 0 18px
    overflow hidden

  &__info-headline
    position relative
    z-index 2
    display inline-flex
    align-items center
    justify-content center
    text-align center
    white-space nowrap
    font-size var(--fonte-11)
    line-height 1
    letter-spacing 0.06em
    font-weight var(--peso-fonte-extrabold)
    text-transform uppercase
    color #fff
    will-change transform
    transform translateZ(0) scale(1)
    animation topbar-info-copy-shift 1.8s cubic-bezier(0.37, 0, 0.22, 1) infinite alternate

  &__info-motion
    position absolute
    inset 0
    z-index 4
    pointer-events none
    overflow hidden

  &__truck-track
    position absolute
    left 0
    right 0
    top 50%
    height 14px
    overflow hidden
    transform translateY(-50%)
    -webkit-mask-image linear-gradient(90deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.78) 7%, #000 14%, #000 84%, rgba(0, 0, 0, 0.72) 92%, rgba(0, 0, 0, 0) 100%)
    mask-image linear-gradient(90deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.78) 7%, #000 14%, #000 84%, rgba(0, 0, 0, 0.72) 92%, rgba(0, 0, 0, 0) 100%)
    -webkit-mask-repeat no-repeat
    mask-repeat no-repeat

    &:before
      content ""
      position absolute
      left 8px
      right 8px
      top 50%
      height 1px
      background linear-gradient(90deg, rgba(212, 175, 55, 0), rgba(212, 175, 55, 0.32), rgba(212, 175, 55, 0))
      transform translateY(-50%)

  &__truck-carriage
    position absolute
    inset 0
    animation topbar-info-truck-run 4.8s linear infinite, topbar-info-truck-fade 4.8s linear infinite
    will-change transform

  &__truck
    position absolute
    left 0
    bottom 0
    font-size 15px
    line-height 1
    transform-origin 50% 100%
    filter drop-shadow(0 1px 2px rgba(0, 0, 0, 0.18))
    animation topbar-info-truck-bounce 4.8s ease-in-out infinite

@keyframes topbar-info-copy-shift
  0%
    color #FFFFFF
    transform translateZ(0) scale(1)
  55%
    color #FFE07A
    transform translateZ(0) scale(1.014)
  100%
    color #FFD54A
    transform translateZ(0) scale(1.026)

@keyframes topbar-info-truck-run
  0%
    transform translate3d(-100%, 0, 0)
  8%
    transform translate3d(-92%, 0, 0)
  13%
    transform translate3d(-98%, 0, 0)
  20%
    transform translate3d(-82%, 0, 0)
  34%
    transform translate3d(-46%, 0, 0)
  52%
    transform translate3d(2%, 0, 0)
  68%
    transform translate3d(42%, 0, 0)
  82%
    transform translate3d(74%, 0, 0)
  92%
    transform translate3d(90%, 0, 0)
  100%
    transform translate3d(100%, 0, 0)

@keyframes topbar-info-truck-fade
  0%
    opacity 0
  6%
    opacity .78
  12%
    opacity 1
  84%
    opacity 1
  90%
    opacity .88
  95%
    opacity .52
  98%
    opacity .22
  100%
    opacity 0

@keyframes topbar-info-truck-bounce
  0%
    transform translate3d(0, 0, 0) scaleX(-1) scale(.96)
  7%
    transform translate3d(0, -2px, 0) scaleX(-1) scale(1)
  13%
    transform translate3d(0, 0, 0) scaleX(-1) scale(.98)
  22%
    transform translate3d(0, -1px, 0) scaleX(-1) scale(1)
  52%
    transform translate3d(0, 0, 0) scaleX(-1) scale(1)
  82%
    transform translate3d(0, 0, 0) scaleX(-1) scale(.99)
  92%
    transform translate3d(0, 1px, 0) scaleX(-1) scale(.98)
  100%
    transform translate3d(0, 0, 0) scaleX(-1) scale(.97)

body.hotsite,
body.category
  .topbar__center:not(.topbar__center--info)
    @media desktop
      display none !important

  .topbar__center--info
    @media desktop
      display flex !important
