.seo-wrap
  position relative
  margin 0
  padding 0

  .seo__button
    position absolute
    z-index 3
    top 19px
    right 8px
    left auto
    display inline-flex !important
    align-items center
    justify-content center
    padding 6px 12px 6px 14px
    border 1px solid $buy-btn
    border-radius 999px
    background rgba(223, 245, 231, 0.99)
    color $buy-btn
    font-size $fonte-12
    font-weight $peso-fonte-medium
    cursor pointer
    gap 6px
    transition $transition
    white-space nowrap
    line-height 1.25
    min-height 34px
    min-width 158px
    box-sizing border-box

    &:hover
      background $buy-btn
      color #fff

    svg
      width 12px
      height 12px
      flex-shrink 0

    @media mobile
      top 19px
      right 8px
      padding 6px 11px 6px 13px
      gap 5px
      min-height 32px
      min-width 140px

      svg
        width 11px
        height 11px

  .seo__button-label--fechado
    display none

  &.expand
    .seo__button-label--aberto
      display none
    .seo__button-label--fechado
      display inline
    .seo__button svg
      transform rotate(180deg)

.seo
  position relative
  box-sizing border-box
  margin-bottom 20px
  padding 12px 16px 40px
  border 1px solid #D5D5D5
  border-radius 24px
  font-family: var(--font-brand);

  &:empty
    display none

  @media mobile
    margin-bottom 16px
    padding 10px 12px 36px

  &__body
    display block
    min-height 0

    &>*
      display none

    &>h1
      display block
      margin 0 0 6px 0
      padding-right 0
      font-weight $peso-fonte-bold
      font-size 18px

      @media mobile
        margin-bottom 4px
        font-size $fonte-16

    &>h1+*
      display -webkit-box !important
      overflow hidden
      -webkit-line-clamp 2
      -webkit-box-orient vertical

    &>h2
      margin-bottom 0
      font-weight $peso-fonte-bold
      font-size $fonte-16

    &>p
      margin-bottom 8px
      font-size $fonte-12

      + h2, + h3, + h4, + h5
        margin-top 12px

    &>img
      display block
      max-width 100%
      height auto
      margin-bottom 16px

  &.expand .seo__body
    max-height unquote("min(60vh, 480px)")
    overflow-x hidden
    overflow-y auto
    -webkit-overflow-scrolling touch

    &>*
      display block

  &.expand
    > *
      display block

    .seo__button
      font-size 0
      gap 6px

      @media mobile
        gap 4px

      &:before
        content "Ver menos"
        font-size $fonte-14
        font-weight $peso-fonte-medium

        @media mobile
          font-size $fonte-12

      svg
        transform rotate(180deg)

  > h2
    display none
    margin 0 0 8px 0
    font-weight $peso-fonte-bold
    font-size $fonte-16

  &.expand > h2
    display block

  > h1
    display block
    margin-bottom 12px
    font-weight $peso-fonte-bold
    font-size $fonte-20

    @media mobile
      margin-bottom 8px
      font-size $fonte-16

    + *
      display -webkit-box !important
      overflow hidden
      -webkit-line-clamp 2
      -webkit-box-orient vertical

  > p
    margin-bottom 8px
    font-size $fonte-12

    + h2, + h3, + h4, + h5
      margin-top 12px

  > *
    display none

  > img
    display block
    margin-bottom 16px

  &__button
    position absolute
    left 16px
    bottom 12px
    display flex !important
    align-items center
    padding 6px 12px
    border 1px solid $buy-btn
    border-radius 999px
    background #0fa8481a
    color $buy-btn
    font-size $fonte-12
    font-weight $peso-fonte-medium
    cursor pointer
    gap 6px
    transition $transition

    &:hover
      background $buy-btn
      color #fff

    svg
      width 12px
      height 12px
      flex-shrink 0

    @media mobile
      left 12px
      bottom 10px
      padding 5px 10px
      font-size $fonte-11
      gap 4px

      svg
        width 11px
        height 11px
