.stamps
  position: absolute;
  top: 10px;
  left: 10px;
  z-index: 9;
  display: flex;
  flex-direction: column;
  flex-wrap: nowrap;
  align-items: flex-start;
  max-height: 112px;
  pointer-events: none;
  gap: 4px;

  .stamp-image
    display: block;
    max-width: 100%;
    height: auto;
    flex-shrink: 0;

    @media mobile
      max-width: 80%;

  &-vr
    position: absolute;
    top: 50px;
    right: 10px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: flex-end;
    gap: 4px;

    .stamp-image
      display: block;
      max-width: 100%;
      height: auto;
      flex-shrink: 0;

      @media mobile
        max-width: 80%;

    &--no_discount
      top: 10px;