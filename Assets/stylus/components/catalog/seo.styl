.seo
  position relative
  margin-bottom 20px
  padding 12px 16px 40px
  border 1px solid #D5D5D5
  border-radius 24px
  font-family: var(--font-brand);

  &:empty
    display none

  @media mobile
    margin-bottom 16px
    padding 10px 12px 36px

  &.expand
    > *
      display block

    .seo__button
      font-size 0
      gap 6px

      @media mobile
        gap 4px

      &:before
        content "Ver menos"
        font-size $fonte-14
        font-weight $peso-fonte-medium

        @media mobile
          font-size $fonte-12

      svg
        transform rotate(180deg)

  > h1
    display block
    margin-bottom 12px
    font-weight $peso-fonte-bold
    font-size $fonte-20

    @media mobile
      margin-bottom 8px
      font-size $fonte-16

    + *
      display -webkit-box !important
      overflow hidden
      -webkit-line-clamp 2
      -webkit-box-orient vertical

  > h2
    margin-bottom 0
    font-weight $peso-fonte-bold
    font-size $fonte-16

  > p
    margin-bottom 8px
    font-size $fonte-12

    + h2, + h3, + h4, + h5
      margin-top 12px

  > *
    display none

  > img
    display block
    margin-bottom 16px

  &__button
    position absolute
    left 16px
    bottom 12px
    display flex !important
    align-items center
    padding 6px 12px
    border 1px solid $buy-btn
    border-radius 999px
    background #0fa8481a
    color $buy-btn
    font-size $fonte-12
    font-weight $peso-fonte-medium
    cursor pointer
    gap 6px
    transition $transition

    &:hover
      background $buy-btn
      color #fff

    svg
      width 12px
      height 12px
      flex-shrink 0

    @media mobile
      left 12px
      bottom 10px
      padding 5px 10px
      font-size $fonte-11
      gap 4px

      svg
        width 11px
        height 11px
