.topbar
  background #0D3547
  color #fff
  font-size var(--fonte-11)
  font-family var(--font-brand)

  &__container
    @extends $container
    @media mobile
      padding 0
    ul
      @media desktop
        display flex
        justify-content space-between
        align-items center

    li
      height: 30px;
      display: flex;
      align-items: center;
      @media mobile
        justify-content center
      @media desktop
        width auto
    
      a
        display flex
        align-items center
        color #fff
        transition $transition
        &:hover
          color #D4AF37
        svg
          margin-right 5px
        &:not(.topbar__prime-logo)
          svg
            path
              fill currentColor
      
      strong
        font-weight var(--peso-fonte-semibold)
        color inherit

  &__left
  &__right
    @media desktop
      flex 1
  &__center
    @media desktop
      justify-content center
  &__right
    gap 10px
    @media desktop
      justify-content flex-end
      gap 20px

  &__prime-logo
    svg
      margin-right 0
